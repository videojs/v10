---

import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'time'>, 'datetime'> {
  date: Date;
}

const { date, ...rest } = Astro.props;
---

<time {...rest} datetime={date.toISOString()}>
  {
    date.toLocaleDateString("en-us", {
      year: "numeric",
      month: "short",
      day: "numeric",
      // Content dates are date-only values parsed as UTC midnight; formatting in a local zone west of UTC would
      // show the previous day.
      timeZone: "UTC",
    })
  }
</time>
