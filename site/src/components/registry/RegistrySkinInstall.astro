---
/** The registry item and install location for a skin reference page. */
import DocsLink from '@/components/docs/DocsLink.astro';
import P from '@/components/typography/P.astro';
import { REGISTRY_NAMESPACE, REGISTRY_SKINS } from '@/utils/installation/shadcn';

interface Props {
  /** Registry item name, such as `video` or `video-minimal`. */
  item: string;
}

const { item } = Astro.props;
const skin = REGISTRY_SKINS.find((candidate) => candidate.item === item);
if (!skin) throw new Error(`Unknown registry skin: ${item}.`);
---

<P>
  The registry item <code>{REGISTRY_NAMESPACE}/{skin.item}</code> installs this ejected skin under{' '}
  <code>{skin.directory}</code>. The player and media remain package imports. Follow{' '}
  <DocsLink slug="how-to/customize-skins" anchor="eject-a-skin">Customize skins</DocsLink> to connect
  the Video.js registry, install the item, and use the files in your project.
</P>
