---
/** The catalog name and install location for a skin reference page. */
import DocsLink from '@/components/docs/DocsLink.astro';
import P from '@/components/typography/P.astro';
import { REGISTRY_NAMESPACE, REGISTRY_SKINS } from '@/utils/installation/shadcn';

interface Props {
  /** Registry item name, such as `video` or `live-audio`. */
  item: string;
  /** Registry theme selected by this reference page. */
  theme?: 'default' | 'minimal';
}

const { item, theme = 'default' } = Astro.props;
const skin = REGISTRY_SKINS.find((candidate) => candidate.item === item && candidate.theme === theme);
if (!skin) throw new Error(`Unknown registry skin: ${theme}/${item}.`);
---

<P>
  Select the <strong>{theme === 'minimal' ? 'Minimal' : 'Default'} theme</strong> catalog, then add <code
    >{REGISTRY_NAMESPACE}/{skin.item}</code
  >. The skin installs under <code>{skin.directory}</code>. The player and media remain package imports. Follow{' '}
  <DocsLink slug="guides/customize-skins" anchor="set-up-the-shadcn-cli">Customize skins</DocsLink> to set up
  the CLI, install the skin, and use the copied files.
</P>
