---
import type { RegistryFramework } from '@videojs/installation';

interface Props {
  framework: RegistryFramework;
  /** Match the React/HTML source catalog by default, or one exact app framework. */
  match?: 'project' | 'source';
  /** Label this branch with its framework in generated Markdown. */
  llmsHeading?: boolean;
}

const { framework, match = 'source', llmsHeading = true } = Astro.props;
const label = framework === 'react' ? 'React' : 'HTML';
---

<div
  class="contents"
  data-shadcn-framework={match === 'source' ? framework : undefined}
  data-shadcn-project-framework={match === 'project' ? framework : undefined}
>
  {
    llmsHeading && (
      <div hidden data-llms-only>
        <h3>{label}</h3>
      </div>
    )
  }
  <slot />
</div>
