---
import type { InstallationFramework } from '@videojs/installation';

interface Props {
  framework: InstallationFramework;
  /** Match the React/HTML source catalog by default, or one exact app framework. */
  match?: 'project' | 'source';
  /** Label this branch with its framework in generated Markdown. */
  llmsHeading?: boolean;
}

const { framework, match = 'source', llmsHeading = true } = Astro.props;

if (match === 'source' && framework !== 'react' && framework !== 'html') {
  throw new Error(`A Shadcn source branch must use React or HTML, received ${framework}.`);
}

const label = { react: 'React', html: 'HTML', vue: 'Vue', svelte: 'Svelte' }[framework];
---

<div
  class="contents"
  data-shadcn-framework={match === 'source' ? framework : undefined}
  data-shadcn-project-framework={match === 'project' ? framework : undefined}
>
  {
    llmsHeading && (
      <div hidden data-llms-only>
        <h3>{label}</h3>
      </div>
    )
  }
  <slot />
</div>
