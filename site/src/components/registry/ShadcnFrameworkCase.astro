---
import type { RegistryFramework } from '@/utils/installation/shadcn';

interface Props {
  framework: RegistryFramework;
  /** Label this branch with a React or HTML heading in generated Markdown. */
  llmsHeading?: boolean;
}

const { framework, llmsHeading = true } = Astro.props;
---

<div
  class="contents"
  data-shadcn-framework={framework}
>
  {
    llmsHeading && (
      <div hidden data-llms-only>
        <h3>{framework === 'react' ? 'React' : 'HTML'}</h3>
      </div>
    )
  }
  <slot />
</div>
