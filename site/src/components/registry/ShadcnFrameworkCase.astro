---
import type { RegistryFramework } from '@/utils/installation/shadcn';

interface Props {
  framework: RegistryFramework;
  /** Heading level used to label this branch in generated Markdown. */
  llmsHeadingLevel?: 2 | 3;
}

const { framework, llmsHeadingLevel = 3 } = Astro.props;
const LLMHeading = llmsHeadingLevel === 2 ? 'h2' : 'h3';
---

<div
  class="contents"
  data-cli-framework={framework}
  data-shadcn-framework={framework}
>
  <div hidden data-llms-only>
    <LLMHeading>{framework === 'react' ? 'React' : 'HTML'}</LLMHeading>
  </div>
  <slot />
</div>
