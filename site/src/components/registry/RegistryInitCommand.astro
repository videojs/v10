---
/** The Shadcn init command for the selected project template. */
import { isValidFramework } from '@/types/docs';
import {
  defaultInstallationTemplate,
  INSTALLATION_TEMPLATE_LABELS,
  installationTemplatesForMethod,
  type RegistryFramework,
} from '@videojs/installation';

import RegistryInitCommandClient from './RegistryInitCommandClient';

interface Props {
  /** Follow the installation page's package-manager choice instead of showing tabs. */
  installation?: boolean;
  framework?: RegistryFramework;
}

const { installation = false, framework: frameworkProp } = Astro.props;
const routeFramework = Astro.params.framework;
const framework = frameworkProp ?? (isValidFramework(routeFramework) ? routeFramework : null);
if (!framework) throw new Error(`RegistryInitCommand needs a framework route, received ${routeFramework}.`);

// The template select is hidden from Markdown readers, so name the other values the server-rendered command can take.
const defaultTemplate = defaultInstallationTemplate(framework);
const otherTemplates = installationTemplatesForMethod(framework, 'shadcn').filter(
  (template) => template !== defaultTemplate
);
const otherTemplateDescription = otherTemplates
  .map((template) => `${template} (${INSTALLATION_TEMPLATE_LABELS[template]})`)
  .join(', ');
---

<RegistryInitCommandClient client:load framework={framework} installation={installation} />

<div hidden data-llms-only>
  {
    framework === 'react' && (
      <p>
        For a new React and Tailwind app, the rendered command creates a {INSTALLATION_TEMPLATE_LABELS[defaultTemplate]} app. To use another project
        template, pass <code>--template</code> with one of {otherTemplateDescription}, and replace the <code>--name</code> value with the intended app directory. For an existing compatible app without <code>components.json</code>, run Shadcn init without the template and name flags after satisfying its Tailwind and import-alias checks.
      </p>
    )
  }
  <p>
    When using Vanilla CSS, HTML, Vue, or Svelte, create the rendered standard <code>components.json</code> instead of
    running a React-oriented Shadcn initializer. Preserve existing aliases when that file already exists.
  </p>
</div>
