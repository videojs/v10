---
/** A project-template or registry source choice placed beside the command it controls. */
import ContentWidth from '@/components/frames/ContentWidth.astro';
import {
  isInstallationFramework,
  type InstallationFramework,
  type InstallationMethod,
  type RegistryPreset,
  type RegistryTheme,
} from '@videojs/installation';

import RegistryOptionsClient from './RegistryOptionsClient';

interface Props {
  /** Skin selected before the page's skin selector changes it. */
  defaultSkin?: RegistryPreset;
  /** Theme selected before the page's theme selector changes it. */
  defaultTheme?: RegistryTheme;
  kind: 'template' | 'catalog' | 'styling';
  method?: InstallationMethod;
  /** Start the skin and theme selectors from the choices made earlier on the installation page. */
  installation?: boolean;
  /** Explicit source framework for routes that are not nested under a docs framework. */
  framework?: InstallationFramework;
  /** Keep one prerendered app-card group tied to its framework. */
  fixedFramework?: boolean;
}

const {
  defaultSkin,
  defaultTheme,
  fixedFramework = false,
  installation = false,
  kind,
  method,
  framework: frameworkProp,
} = Astro.props;
const routeFramework = Astro.params.framework;
const framework = frameworkProp ?? (isInstallationFramework(routeFramework) ? routeFramework : null);
if (!framework) throw new Error(`RegistryOptions needs a framework route, received ${routeFramework}.`);
---

<ContentWidth>
  <div data-installation-query-state={kind === 'template' ? undefined : ''} data-llms-ignore>
    <RegistryOptionsClient
      client:load
      defaultSkin={defaultSkin}
      defaultTheme={defaultTheme}
      fixedFramework={fixedFramework}
      framework={framework}
      installation={installation}
      kind={kind}
      method={method}
    />
  </div>
</ContentWidth>
