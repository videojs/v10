---
/**
 * The `registry add` and `add` commands for registry items, following the page's styling select box. Without items it
 * only registers the `@videojs` namespace.
 */
import { isValidFramework } from '@/types/docs';
import type { ShadcnRunner } from '@/utils/installation/shadcn';

import RegistryCommandClient from './RegistryCommandClient';

interface Props {
  /** Registry item names, without the `@videojs/` namespace. */
  items?: string[];
  /** Show one package manager instead of tabs. */
  runner?: ShadcnRunner;
}

const { items = [], runner } = Astro.props;
const { framework } = Astro.params;
if (!isValidFramework(framework)) throw new Error(`RegistryCommand needs a framework route, received ${framework}.`);
---

<RegistryCommandClient client:idle framework={framework} items={items} runner={runner} />
