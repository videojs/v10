---
import { ACCENT_KEY, THEME_COLORS, THEME_KEY, TONE_KEY } from '@/consts';
---

{/* Dark mode initialization script - runs before paint to prevent FOUC */}
{
  /* ts(2570) on localStorageKey is expected — astro check can't see define:vars injections (withastro/language-tools#711) */
}
<script is:inline define:vars={{ localStorageKey: THEME_KEY, accentKey: ACCENT_KEY, toneKey: TONE_KEY, themeColors: THEME_COLORS }}>
  function applyStoredAppearance(root, ownerDocument) {
    if (!root || typeof localStorage === "undefined") return;

    let localStorageValue = localStorage[localStorageKey];
    const isValidKey =
      localStorageValue === "light" ||
      localStorageValue === "dark" ||
      localStorageValue === "system";

    if (!localStorageValue || !isValidKey) {
      localStorage[localStorageKey] = "system";
      localStorageValue = "system";
    }

    let isDark = false;

    if (localStorageValue === "dark") {
      isDark = true;
    } else if (localStorageValue === "system") {
      if (
        typeof window.matchMedia !== "undefined" &&
        window.matchMedia("(prefers-color-scheme: dark)").matches
      ) {
        isDark = true;
      }
    }

    root.classList.toggle("dark", isDark);

    // Accent and dark tone ride the same pre-paint path; see stores/appearance.ts for the values.
    const accents = ["orange", "gold", "magenta", "red"];
    const tones = ["soft", "deep"];
    const accent = accents.includes(localStorage[accentKey]) ? localStorage[accentKey] : "orange";
    const tone = tones.includes(localStorage[toneKey]) ? localStorage[toneKey] : "soft";

    root.dataset.accent = accent;
    root.dataset.tone = tone;

    const themeColorMeta = ownerDocument.querySelector('meta[name="theme-color"]');

    if (themeColorMeta) {
      themeColorMeta.setAttribute("content", isDark ? themeColors[tone] : themeColors.light);
    }
  }

  applyStoredAppearance(document.documentElement, document);

  // Follow the OS while the stored preference is "system". This lives here, not in the appearance store, so it runs on
  // every page whether or not the appearance controls ever mount.
  window.matchMedia?.("(prefers-color-scheme: dark)").addEventListener("change", function () {
    applyStoredAppearance(document.documentElement, document);
  });

  document.addEventListener("astro:before-swap", function (event) {
    applyStoredAppearance(event.newDocument.documentElement, event.newDocument);
  });
</script>
