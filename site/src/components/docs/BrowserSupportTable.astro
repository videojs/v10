---
/**
 * Build-time browser support data for the Browser support guide. Versions and usage come from the root browserslist
 * query and `caniuse-lite`, so the page moves with dependency updates instead of hand edits.
 */
import A from '@/components/typography/A.astro';
import MarkdownCode from '@/components/typography/MarkdownCode.astro';
import P from '@/components/typography/P.astro';
import Table from '@/components/typography/Table.astro';
import Tbody from '@/components/typography/Tbody.astro';
import Td from '@/components/typography/Td.astro';
import Th from '@/components/typography/Th.astro';
import Thead from '@/components/typography/Thead.astro';
import Tr from '@/components/typography/Tr.astro';
import {
  caniuseVersion,
  cssRequirementSupport,
  resolveSupportedBrowsers,
  SUPPORT_GROUPS,
  type SupportBrowserId,
  supportedCoverage,
} from '@/utils/browser-support';

interface Props {
  kind: 'browsers' | 'coverage' | 'requirements';
}

const { kind } = Astro.props;

const browsers = resolveSupportedBrowsers();
const support = cssRequirementSupport();
const coverage = supportedCoverage();

const percent = (value: number) => `${value.toFixed(1)}%`;

const UNSUPPORTED = 'Not supported';

function groupCell(values: Record<SupportBrowserId, string | null>, ids: readonly SupportBrowserId[]): string {
  const shown = ids.map((id) => values[id] ?? UNSUPPORTED);

  return new Set(shown).size === 1 ? shown[0]! : shown.join(' / ');
}

---

{
  kind === 'browsers' && (
    <Table>
      <caption class="sr-only">Supported browsers and the versions of each that Video.js supports</caption>
      <Thead>
        <Tr>
          <Th scope="col">Browser</Th>
          <Th scope="col">Versions</Th>
        </Tr>
      </Thead>
      <Tbody>
        {browsers.map((browser) => (
          <Tr>
            <Td as="th" scope="row" class="text-left font-medium">
              {browser.name}
            </Td>
            <Td class="tabular-nums">{browser.minimum ? `${browser.minimum} and later` : UNSUPPORTED}</Td>
          </Tr>
        ))}
      </Tbody>
    </Table>
  )
}

{
  kind === 'coverage' && (
    <P>
      These versions account for {percent(coverage)} of global web usage according to{' '}
      <A href="https://github.com/browserslist/caniuse-lite">caniuse-lite</A> {caniuseVersion()}, and this figure updates
      when we update that data.
    </P>
  )
}

{
  kind === 'requirements' && (
    <Table>
      <caption class="sr-only">
        First browser version that fully supports each CSS feature the skins need, and what breaks without it. Feature
        names link to their support data on caniuse.com or MDN. Paired browsers share a column and show two values only when they
        differ.
      </caption>
      <Thead>
        <Tr>
          <Th scope="col">Feature</Th>
          {SUPPORT_GROUPS.map((group) => <Th scope="col">{group.label}</Th>)}
          <Th scope="col">Without it</Th>
        </Tr>
      </Thead>
      <Tbody>
        {support.map(({ requirement, firstVersion, url }) => (
          <Tr>
            <Td as="th" scope="row" class="text-left font-medium">
              <A href={url}>
                {requirement.code ? <MarkdownCode>{requirement.label}</MarkdownCode> : requirement.label}
              </A>
            </Td>
            {SUPPORT_GROUPS.map((group) => <Td class="tabular-nums">{groupCell(firstVersion, group.ids)}</Td>)}
            <Td>{requirement.effect}</Td>
          </Tr>
        ))}
      </Tbody>
    </Table>
  )
}
