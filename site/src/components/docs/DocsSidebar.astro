---
import clsx from 'clsx';

import BookIcon from '@/assets/icons/book.svg?react';
import CodeIcon from '@/assets/icons/code.svg?react';
import PuzzleIcon from '@/assets/icons/puzzle.svg?react';
import PenIcon from '@/assets/icons/pen.svg?react';
import { PreferenceUpdater } from '@/components/docs/PreferenceUpdater';
import DocsSidebarTab from '@/components/docs/DocsSidebarTab.astro';
import SidebarItem from '@/components/docs/SidebarItem.astro';
import type { DocStability, SidebarItem as SidebarItemType, SupportedFramework } from '@/types/docs';
import { isLink, isSection } from '@/types/docs';
import { filterSidebar, findFirstGuide } from '@/utils/docs/sidebar';

type Props = {
  framework: SupportedFramework;
  docTitles: Map<string, string>;
  docStabilities: Map<string, DocStability | undefined>;
  class?: string;
  /**
   * Give the active link's indicator a view-transition name so it slides between pages of the same section. Only one
   * rendered sidebar per page may opt in; duplicate names would cancel the transition.
   */
  animateIndicator?: boolean;
};

const { framework, docTitles, docStabilities, class: className, animateIndicator = false } = Astro.props;
const filteredSidebar = filterSidebar(framework);
const currentPath = Astro.url.pathname;

function containsActivePath(item: SidebarItemType): boolean {
  if (isSection(item)) return item.contents.some(containsActivePath);

  if (isLink(item)) return false;

  return `/docs/framework/${framework}/${item.slug}` === currentPath;
}

// Top-level sections are the sidebar's switcher. Each entry links to its first guide; the entry that contains the
// current page is open. Fall back to the first entry so index-style pages still show a navigation tree.
const tabs = filteredSidebar.filter(isSection);
const looseItems = filteredSidebar.filter((item) => !isSection(item));
const activeTab = tabs.find(containsActivePath) ?? tabs[0];

// Scoped to the section so switching sections fades instead of sliding the indicator across unrelated lists.
const indicatorTransitionName =
  animateIndicator && activeTab
    ? `sidebar-indicator-${activeTab.sidebarLabel.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`
    : undefined;

// Server-rendered clip for the highlight overlay: each tab is 9 spacing units tall inside 1 unit of padding and gap,
// so the band for the active tab can be expressed without measuring. The client refines it once layout is known.
const activeIndex = activeTab ? tabs.indexOf(activeTab) : 0;
const initialClip = `inset(calc(var(--spacing) * ${1 + activeIndex * 10}) var(--spacing) calc(var(--spacing) * ${1 + (tabs.length - 1 - activeIndex) * 10}) var(--spacing) round 6px)`;

const TAB_ICONS = {
  Guides: BookIcon,
  Components: PuzzleIcon,
  API: CodeIcon,
  'Writing Style': PenIcon,
} satisfies Record<string, typeof BookIcon>;
---

<div class={clsx("bg-manila-light dark:bg-faded-black", className)}>
  <slot />
  <PreferenceUpdater client:idle currentFramework={framework} />
  {
    tabs.length > 1 && (
      <nav aria-label="Docs sections" class="px-6 pt-5">
        <div
          class="relative mx-auto w-full max-w-3xl rounded-lg corner-squircle border border-line bg-surface p-1"
          data-sidebar-tabs
          data-active-index={activeIndex}
        >
          <div class="grid gap-1">
            {tabs.map((tab) => (
              <DocsSidebarTab
                href={`/docs/framework/${framework}/${findFirstGuide(framework, tab.contents)}`}
                label={tab.sidebarLabel}
                icon={TAB_ICONS[tab.sidebarLabel as keyof typeof TAB_ICONS]}
                devOnly={tab.devOnly}
                current={tab === activeTab}
              />
            ))}
          </div>
          {/* Selected-state copy of the tabs, clipped to the active one so the highlight and label colours slide together. */}
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 grid gap-1 p-1"
            data-sidebar-tabs-highlight
            style={`clip-path: ${initialClip}`}
          >
            {tabs.map((tab) => (
              <DocsSidebarTab
                href=""
                label={tab.sidebarLabel}
                icon={TAB_ICONS[tab.sidebarLabel as keyof typeof TAB_ICONS]}
                devOnly={tab.devOnly}
                highlight
              />
            ))}
          </div>
        </div>
      </nav>
    )
  }
  <nav aria-label="Docs sidebar" class="px-6 pt-8 pb-6">
    {
      activeTab?.contents.map((item) => (
        <SidebarItem
          item={item}
          framework={framework}
          docTitles={docTitles}
          docStabilities={docStabilities}
          indicatorTransitionName={indicatorTransitionName}
        />
      ))
    }
    {
      looseItems.map((item) => (
        <SidebarItem item={item} framework={framework} docTitles={docTitles} docStabilities={docStabilities} />
      ))
    }
  </nav>
</div>

<style>
  /* Without clip-path the overlay would highlight every tab; hide it and let the real link carry the selected state. */
  @supports not (clip-path: inset(0 round 6px)) {
    [data-sidebar-tabs-highlight] {
      display: none;
    }
  }
</style>

<script is:inline>
  // Slide the section highlight to the chosen tab before following its link, so the next page arrives with the
  // highlight already in place and the page's own cross-document transition has nothing to fade.
  (() => {
    const roots = document.querySelectorAll("[data-sidebar-tabs]:not([data-tabs-ready])");
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const root of roots) {
      root.setAttribute("data-tabs-ready", "");

      const overlay = root.querySelector("[data-sidebar-tabs-highlight]");
      const links = Array.from(root.querySelectorAll(":scope > div:first-child > a"));
      const active = Number(root.getAttribute("data-active-index"));
      if (!overlay || !links[active]) continue;

      const bandFor = (index) => {
        const box = root.getBoundingClientRect();
        const tab = links[index].getBoundingClientRect();

        return `inset(${tab.top - box.top}px ${box.right - tab.right}px ${box.bottom - tab.bottom}px ${tab.left - box.left}px round 6px)`;
      };

      overlay.style.clipPath = bandFor(active);

      links.forEach((link, index) => {
        link.addEventListener("click", (event) => {
          // Leave modified clicks, same-tab re-clicks, and reduced-motion users on the browser's default path.
          if (index === active || reduceMotion) return;

          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          event.preventDefault();

          const slide = overlay.animate([{ clipPath: bandFor(active) }, { clipPath: bandFor(index) }], {
            duration: 260,
            easing: "cubic-bezier(0.2, 0.8, 0.2, 1)",
            fill: "forwards",
          });

          slide.finished.then(() => window.location.assign(link.href), () => window.location.assign(link.href));
        });
      });
    }
  })();
</script>
