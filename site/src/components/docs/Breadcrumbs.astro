---
import ChevronRight from '@/assets/icons/chevron-right.svg?react';

/**
 * Breadcrumb trail for a docs page: the sidebar sections that contain it, then the page itself. The first crumb is
 * the sidebar tab ("Guide", "Components"), which links to that tab's first page so it behaves like the tab does.
 */
type Props = {
  crumbs: Array<{ label: string; href?: string }>;
  class?: string;
};

const { crumbs, class: className } = Astro.props;
---

<nav aria-label="Breadcrumb" class:list={["min-w-0", className]}>
  <ol class="flex flex-wrap items-center gap-1.5 text-p3">
    {
      crumbs.map((crumb, index) => {
        const isLast = index === crumbs.length - 1;

        return (
          <li class="flex min-w-0 items-center gap-1.5">
            {crumb.href && !isLast ? (
              <a
                href={crumb.href}
                class="truncate text-muted intent:text-faded-black dark:intent:text-manila-light"
              >
                {crumb.label}
              </a>
            ) : (
              <span
                class:list={["truncate", isLast ? "font-semibold" : "text-muted"]}
                aria-current={isLast ? "page" : undefined}
              >
                {crumb.label}
              </span>
            )}
            {!isLast && <ChevronRight className="size-3.5 shrink-0 text-muted" aria-hidden="true" />}
          </li>
        );
      })
    }
  </ol>
</nav>
