---
import type { DocStability } from '@/types/docs';

type Props = {
  stability: DocStability;
};

const { stability } = Astro.props;
const labels = {
  experimental: 'Unstable',
} satisfies Record<DocStability, string>;

const label = labels[stability];
---

<span
  class="inline-flex h-4.5 shrink-0 items-center rounded-md corner-squircle bg-orange/12 px-1.5 text-p4 leading-none font-medium text-orange select-none dark:bg-orange/15"
>
  {label}
</span>
