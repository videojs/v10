---
import type { HTMLAttributes } from 'astro/types';
import ChevronRight from '@/assets/icons/chevron-right.svg?react';
import { resolveDocsFramework } from '@/types/docs';
import { resolveDocsHref } from '@/utils/docs/routing';
import { findGuideBySlug } from '@/utils/docs/sidebar';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  slug: string;
  /** Heading ID within the target guide. */
  anchor?: string;
  description?: string;
}
const { slug, anchor, description } = Astro.props;

const routeFramework = Astro.params.framework;
const paramFramework = resolveDocsFramework(routeFramework);
if (routeFramework && !paramFramework) throw new Error(`Invalid framework param "${routeFramework}".`);

if (!findGuideBySlug(slug)) {
  throw new Error(`No guide found with slug "${slug}"`);
}

// Outside the docs there is no framework in context, so the href is the agnostic
// /docs/<slug> form. `data-docs-slug` lets ResolveDocsLinks upgrade it on the client.
const contextFramework = paramFramework;
const url = resolveDocsHref({ slug, framework: contextFramework });
const href = anchor ? `${url}#${anchor}` : url;
const docsSlug = contextFramework ? undefined : slug;
---

<div
  class="docs-link-card mx-auto my-8 grid w-full max-w-3xl grid-cols-1 gap-4 has-[+_.docs-link-card]:mb-4 md:grid-cols-2 [&+.docs-link-card]:mt-4"
>
  <a
    href={href}
    data-docs-slug={docsSlug}
    class="flex h-full items-center justify-between gap-4 rounded-lg corner-squircle border border-manila-dark p-4 no-underline md:pl-6 dark:border-line intent:bg-manila-75 dark:intent:bg-warm-gray"
  >
    {
      description ? (
        <div>
          <div class="font-semibold">
            <slot />
          </div>
          <div class="mt-2 text-p3 dark:text-muted">{description}</div>
        </div>
      ) : (
        <span>
          <slot />
        </span>
      )
    }
    <ChevronRight className="size-4 shrink-0 text-muted" aria-hidden="true" />
  </a>
</div>
