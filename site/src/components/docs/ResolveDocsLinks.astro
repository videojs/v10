---
/**
 * Upgrades framework-agnostic docs links in place. Anchors rendered outside the
 * docs carry `data-docs-slug` and an `/docs/<slug>` href that the server can
 * redirect; once the reader's framework is known on the client, the same
 * resolver rewrites them to the concrete URL so the click skips the redirect.
 */
---

<script>
  import { initializeDocsLinks } from '@/utils/docs/links';

  initializeDocsLinks();
</script>
