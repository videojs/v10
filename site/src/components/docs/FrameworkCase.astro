---
/**
 * Renders its content only for the frameworks listed in `frameworks`, or for every framework when the prop is
 * omitted.
 *
 * NOTE: this is the naive conditional-slot version, kept on this branch only to demonstrate the Astro hydration
 * bug described in videojs/v10#1224. It breaks hydration on HTML pages. Do not merge.
 */
import { isValidFramework, type SupportedFramework } from '@/types/docs';

interface Props {
  frameworks?: SupportedFramework[];
}

const { frameworks } = Astro.props;
const { framework } = Astro.params;

const shouldRender = !frameworks || (isValidFramework(framework) && frameworks.includes(framework));
---

{shouldRender && <slot />}
