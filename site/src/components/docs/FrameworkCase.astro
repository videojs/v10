---
/**
 * Renders its content only for the frameworks listed in `frameworks`, or for every framework when the prop is
 * omitted. Content for other frameworks is left out of the HTML entirely.
 *
 * Astro evaluates slots eagerly when it creates a component instance, before this frontmatter runs, and it
 * deduplicates page-level assets while doing so: the `<astro-island>` definition and its `<style>`, each `client:*`
 * directive script, and hoisted component `<script>` tags are emitted into whichever slot output renders them first
 * and never again. Silently dropping a non-matching slot would drop the only copy of those assets and leave every
 * island on the page unhydrated, so the non-matching branch keeps the assets and drops only the markup.
 *
 * @example
 * <FrameworkCase frameworks={['react']}>React-only content</FrameworkCase>
 * <FrameworkCase>Content for every framework</FrameworkCase>
 */
import { isValidFramework, type SupportedFramework } from '@/types/docs';
import { extractScriptsAndStyles } from '@/utils/extractScriptsAndStyles';

interface Props {
  frameworks?: SupportedFramework[];
}

const { frameworks } = Astro.props;
const { framework } = Astro.params;

const shouldRender = !frameworks || (isValidFramework(framework) && frameworks.includes(framework));
const preservedAssets = shouldRender ? '' : extractScriptsAndStyles((await Astro.slots.render('default')) ?? '');
---

{
  shouldRender ? (
    <div class="contents">
      <slot />
    </div>
  ) : (
    <Fragment set:html={preservedAssets} />
  )
}
