---
/**
 * Conditionally shows content based on the reader's selected framework.
 *
 * `frameworks` is an exact list: omit it to show the content everywhere, otherwise name every framework that should see
 * it. Content documenting the `@videojs/html` custom-element API lists all three of its readers, because Vue and Svelte
 * consume that API too.
 *
 * @example
 * <!-- Shared html-API content, then the Vue-specific variant that replaces it -->
 * <FrameworkCase frameworks={["html", "vue", "svelte"]}>Custom-element content</FrameworkCase>
 * <FrameworkCase frameworks={["html"]}>HTML-only content Vue and Svelte should not see</FrameworkCase>
 * <FrameworkCase frameworks={["vue"]}>Vue-specific content</FrameworkCase>
 */
import type { SupportedFramework } from '@/types/docs';
import { frameworkMatches } from '@/types/docs';

interface Props {
  frameworks?: SupportedFramework[];
}

const { frameworks } = Astro.props;
const { framework } = Astro.params;

// Only render if the current framework is listed, or if no frameworks specified (all frameworks)
const shouldRender = frameworkMatches(framework as SupportedFramework, frameworks);
---

{
  /*
    What I WANT to do is
    ```
    {shouldRender && <slot />}
    ```

    But I'm running into some crazy problems with hydration.
    Putting client:* in one of these conditionals causes Astro to just give up hydrating the whole app for some reason.
    TODO: fix this

    So, while I debug those... let's do this
  */
}
<div
  class="contents"
  hidden={!shouldRender}
  data-search-ignore={shouldRender ? undefined : "all"}
  data-llms-ignore={shouldRender ? undefined : "all"}
>
  <slot />
</div>
