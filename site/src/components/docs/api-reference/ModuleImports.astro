---
import type { BundledLanguage } from 'shiki';

import ServerCode from '@/components/Code/ServerCode.astro';
import CodeFrame from '@/components/typography/CodeFrame.astro';
import P from '@/components/typography/P.astro';
import { VJS10_HTML_CDN_BASE } from '@/consts';
import DocsLink from '../DocsLink.astro';
import FrameworkCase from '../FrameworkCase.astro';

interface Props {
  /** Module name: the suffix shared by the React, HTML, and CDN subpaths. */
  name: string;
  /** Named export from the React module. */
  react: string;
  /** Public module family shared by the React, HTML, and CDN imports. */
  subpath: 'extensions' | 'media';
}

const { name, react, subpath } = Astro.props;

const cdnCode = `<script type="module" src="${VJS10_HTML_CDN_BASE}/${subpath}/${name}.js"></script>`;

const imports: Array<{ code: string; framework: 'react' | 'html'; lang: BundledLanguage }> = [
  {
    code: `import { ${react} } from '@videojs/react/${subpath}/${name}';`,
    framework: 'react',
    lang: 'tsx',
  },
  {
    code: `import '@videojs/html/${subpath}/${name}';`,
    framework: 'html',
    lang: 'ts',
  },
];
---

{
  imports.map(({ code, framework, lang }) => (
    <FrameworkCase frameworks={[framework]}>
      <CodeFrame lang={lang}>
        <ServerCode code={code} lang={lang} />
      </CodeFrame>
    </FrameworkCase>
  ))
}

<FrameworkCase frameworks={['html']}>
  <P>Or load it from the <DocsLink slug="concepts/cdn">CDN</DocsLink>:</P>
  <CodeFrame lang="html">
    <ServerCode code={cdnCode} lang="html" />
  </CodeFrame>
</FrameworkCase>
