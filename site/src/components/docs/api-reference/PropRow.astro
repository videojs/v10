---
import MarkdownCode from '@/components/typography/MarkdownCode.astro';
import AnchorLink from './AnchorLink.astro';
import DetailRow from './DetailRow.astro';
import InlineCode from './InlineCode.astro';
import { getPropReferenceNames } from './prop-reference-names';

interface Props {
  name: string;
  type: string;
  detailedType?: string;
  description?: string;
  defaultValue?: string;
  required?: boolean;
  showAttributeName?: boolean;
  /** Overrides the name derived from the prop, for a feature that declares one. */
  attribute?: string;
  componentName: string;
  toggleColumn?: boolean;
}

const {
  name,
  type,
  detailedType,
  description,
  defaultValue,
  required,
  showAttributeName,
  attribute,
  componentName,
  toggleColumn,
} = Astro.props;

const id = `${componentName}-${name}`;
const { propertyName, attributeName } = getPropReferenceNames(name, attribute, showAttributeName);

// A same-named attribute adds nothing under the property name.
const showAttribute = Boolean(attributeName && attributeName !== propertyName);
---

<DetailRow
  id={id}
  name={propertyName}
  detailedType={detailedType}
  description={description}
  colspan={3}
  toggleColumn={toggleColumn}
>
  <td>
    <span class="inline-flex items-center whitespace-nowrap">
      <MarkdownCode>
        {propertyName}
        {required && <span class="text-orange">*</span>}
      </MarkdownCode>
      <AnchorLink id={id} name={propertyName} />
    </span>
    {
      showAttribute && (
        <div class="mt-1.5 text-p4 text-muted">
          attribute <MarkdownCode class="text-p4">{attributeName}</MarkdownCode>
        </div>
      )
    }
  </td>
  <td class="w-full">
    <InlineCode code={type} />
  </td>
  <td>
    {defaultValue ? <InlineCode code={defaultValue} /> : <span class="text-muted">—</span>}
  </td>
</DetailRow>
