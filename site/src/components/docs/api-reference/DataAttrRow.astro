---
import MarkdownCode from '@/components/typography/MarkdownCode.astro';
import DetailRow from './DetailRow.astro';
import InlineCode from './InlineCode.astro';

interface Props {
  name: string;
  type?: string;
  detailedType?: string;
  description?: string;
  componentName: string;
  toggleColumn?: boolean;
}

const { name, type, detailedType, description, componentName, toggleColumn } = Astro.props;

const id = `${componentName}-attr-${name}`;
---

<DetailRow
  id={id}
  name={name}
  detailedType={detailedType}
  description={description}
  colspan={2}
  toggleColumn={toggleColumn}
>
  <td>
    <MarkdownCode>{name}</MarkdownCode>
  </td>
  <td class="w-full">
    {type ? <InlineCode code={type} /> : <span class="text-muted">—</span>}
  </td>
</DetailRow>
