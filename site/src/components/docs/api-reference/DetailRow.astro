---
/**
 * One entry of an API reference table: a compact summary row and an optional expandable panel holding its description
 * and full type.
 *
 * Renders a `<tbody>` so the summary and detail rows share one top border and one hover state. The default slot provides
 * the summary cells; padding is applied to them here so row components stay bare `<td>`s. When `toggleColumn` is set
 * the table reserves a trailing column, and the disclosure button renders there for entries that have detail.
 */
import ChevronRight from '@/assets/icons/chevron-right.svg?react';
import ServerCode from '@/components/Code/ServerCode.astro';
import InlineMarkdown from './InlineMarkdown.astro';

interface Props {
  id: string;
  name: string;
  detailedType?: string;
  description?: string;
  colspan: number;
  toggleColumn?: boolean;
}

const { id, name, detailedType, description, colspan, toggleColumn = false } = Astro.props;

const hasDetail = Boolean(description || detailedType);
const cells = colspan + (toggleColumn ? 1 : 0);
---

<tbody
  id={id}
  data-apiref-row
  class:list={[
    "group border-t border-line target:bg-accent/8",
    hasDetail && "cursor-pointer intent:bg-surface/60 dark:intent:bg-surface",
  ]}
>
  <tr class="*:px-3 *:py-3 *:align-top sm:*:px-4">
    <slot />
    {
      toggleColumn && (
        <td class="w-0 pr-1.5 pl-0!" data-llms-ignore>
          {hasDetail && (
            <button
              type="button"
              aria-expanded="false"
              aria-controls={`${id}-detail`}
              aria-label={`Details for ${name}`}
              data-apiref-toggle
              class="-my-0.5 flex size-6 items-center justify-center rounded-md text-muted corner-squircle intent:bg-hover intent:text-current"
            >
              <ChevronRight className="size-4 transition-transform group-data-expanded:rotate-90" />
            </button>
          )}
        </td>
      )
    }
  </tr>
  {
    hasDetail && (
      <tr id={`${id}-detail`} aria-hidden="true" inert data-apiref-detail-row>
        <td colspan={cells} class="px-3 py-0 sm:px-4">
          {/* Rows cannot animate height, so the panel collapses through a 0fr → 1fr grid track instead of `hidden`. */}
          <div data-apiref-detail>
            <div class="min-h-0 overflow-hidden">
              <div class="mb-4 grid gap-4 rounded-md border border-line bg-surface-raised p-4 corner-squircle">
                {
                  description && (
                    <div data-apiref-description>
                      <div class="mb-1 text-p4 font-bold uppercase tracking-wide text-muted" data-llms-ignore>
                        Description
                      </div>
                      <div class="text-p3">
                        <InlineMarkdown content={description} />
                      </div>
                    </div>
                  )
                }
                {
                  detailedType && (
                    <div data-apiref-type>
                      <div class="mb-1.5 text-p4 font-bold uppercase tracking-wide text-muted" data-llms-ignore>
                        Type
                      </div>
                      <div class="overflow-x-auto rounded-md bg-faded-black px-4 py-3 scrollbar-thin corner-squircle dark:bg-soot">
                        <ServerCode code={detailedType} lang="ts" />
                      </div>
                    </div>
                  )
                }
              </div>
            </div>
          </div>
        </td>
      </tr>
    )
  }
</tbody>

<style>
  [data-apiref-detail] {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 280ms var(--ease-soft),
      opacity 200ms ease;
  }

  [data-expanded] [data-apiref-detail] {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-apiref-detail] {
      transition: none;
    }
  }
</style>

<script>
  import { initializeTableDisclosures } from './disclosures';

  initializeTableDisclosures();
</script>
