---
/**
 * One entry of an API reference table: a summary row, its description beneath, and an optional expandable panel
 * holding the full type.
 *
 * Renders a `<tbody>` so the three rows share one top border and one hover state. The default slot provides the
 * summary cells; padding is applied to them here so row components stay bare `<td>`s. When `toggleColumn` is set the
 * table reserved a trailing column, and the disclosure button renders there for entries that have a full type.
 */
import ChevronRight from '@/assets/icons/chevron-right.svg?react';
import ServerCode from '@/components/Code/ServerCode.astro';
import InlineMarkdown from './InlineMarkdown.astro';

interface Props {
  id: string;
  name: string;
  detailedType?: string;
  description?: string;
  colspan: number;
  toggleColumn?: boolean;
}

const { id, name, detailedType, description, colspan, toggleColumn = false } = Astro.props;

const hasDetail = Boolean(detailedType);
const cells = colspan + (toggleColumn ? 1 : 0);
---

<tbody
  id={id}
  data-apiref-row
  class:list={[
    "group border-t border-line",
    hasDetail && "cursor-pointer intent:bg-surface/60 dark:intent:bg-surface",
  ]}
>
  <tr
    class:list={[
      "*:px-3 *:pt-3 *:align-top sm:*:px-4",
      description ? "*:pb-1" : "*:pb-3",
    ]}
  >
    <slot />
    {
      toggleColumn && (
        <td class="w-0 pr-1.5 pl-0!">
          {hasDetail && (
            <button
              type="button"
              aria-expanded="false"
              aria-controls={`${id}-detail`}
              aria-label={`Full type for ${name}`}
              data-apiref-toggle
              class="-my-0.5 flex size-6 items-center justify-center rounded-md text-muted corner-squircle intent:bg-hover intent:text-current"
            >
              <ChevronRight className="size-4 transition-transform group-data-expanded:rotate-90" />
            </button>
          )}
        </td>
      )
    }
  </tr>
  {
    description && (
      <tr>
        <td colspan={cells} class="px-3 pt-0 pb-3 text-muted sm:px-4">
          <InlineMarkdown content={description} />
        </td>
      </tr>
    )
  }
  {
    hasDetail && (
      <tr id={`${id}-detail`} hidden>
        <td colspan={cells} class="px-3 pt-0 pb-4 sm:px-4">
          <div class="overflow-x-auto rounded-md bg-faded-black px-4 py-3 scrollbar-thin corner-squircle dark:bg-soot">
            <ServerCode code={detailedType!} lang="ts" />
          </div>
        </td>
      </tr>
    )
  }
</tbody>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-apiref-toggle]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const expanded = button.getAttribute("aria-expanded") === "true";

        button.setAttribute("aria-expanded", String(!expanded));

        const group = button.closest<HTMLElement>("[data-apiref-row]");

        if (group) group.toggleAttribute("data-expanded", !expanded);

        const detail = document.getElementById(
          button.getAttribute("aria-controls")!,
        );

        if (detail) detail.hidden = expanded;
      });
    });

  document
    .querySelectorAll<HTMLElement>("[data-apiref-row]")
    .forEach((group) => {
      group.addEventListener("click", (e) => {
        // SAFETY: click targets inside a table are always elements.
        if ((e.target as Element).closest("a, button")) return;

        group.querySelector<HTMLButtonElement>("[data-apiref-toggle]")?.click();
      });
    });
</script>
