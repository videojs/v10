---
import { highlightInline } from '@/components/Code/inlineHighlighter';
import { renderInlineMarkdown, setInlineCodeHighlighter } from '@/utils/docs/renderInlineMarkdown';

interface Props {
  content?: string;
  fallback?: string;
}

const { content, fallback = '-' } = Astro.props;

setInlineCodeHighlighter((code) => highlightInline(code));

const html = content ? renderInlineMarkdown(content, { highlight: true }) : fallback;
---

<Fragment set:html={html} />
