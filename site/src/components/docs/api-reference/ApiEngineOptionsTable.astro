---
import type { EngineOptionDef } from '@/types/media-reference';
import ApiTable from './ApiTable.astro';
import StateRow from './StateRow.astro';

/**
 * Renders one engine's options table for API reference.
 *
 * Shares StateRow with the props and state tables, so long types sit in the expandable detail row rather than
 * widening the table. An option with no JSDoc still gets a row: it exists in the API surface, so a reader setting it
 * should be able to find it.
 */
interface Props {
  options: EngineOptionDef[];
  componentName: string;
  engine: string;
}

const { options, componentName, engine } = Astro.props;

const toggleColumn = options.some((option) => Boolean(option.detailedType));
---

<ApiTable columns={["Option", "Type"]} toggle={toggleColumn}>
  {
    options.map((option) => (
      <StateRow
        name={option.name}
        type={option.type}
        detailedType={option.detailedType}
        description={option.description}
        componentName={componentName}
        kind={`engine-${engine}`}
        toggleColumn={toggleColumn}
      />
    ))
  }
</ApiTable>
