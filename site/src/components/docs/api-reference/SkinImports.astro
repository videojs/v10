---
import type { BundledLanguage } from 'shiki';

import ServerCode from '@/components/Code/ServerCode.astro';
import CodeFrame from '@/components/typography/CodeFrame.astro';
import P from '@/components/typography/P.astro';
import { VJS10_HTML_CDN_BASE } from '@/consts';
import DocsLink from '../DocsLink.astro';
import FrameworkCase from '../FrameworkCase.astro';

interface Props {
  /** Preset subpath the skin ships from: `video`, `audio`, `live-video`, `live-audio`, or `background`. */
  preset: string;
  /** Named export from `@videojs/react/<preset>`. */
  react: string;
  /** Whether this is the preset's minimal variant, shipped as `minimal-skin`. */
  minimal?: boolean;
}

const { preset, react, minimal = false } = Astro.props;
const module = minimal ? 'minimal-skin' : 'skin';
const bundle = preset === 'background' ? 'background' : `${preset}${minimal ? '-minimal' : ''}`;

// The background preset names its elements after its `<background-video>` media element.
const elementPrefix = preset === 'background' ? 'background-video' : preset;
const playerTag = `${elementPrefix}-player`;
const skinTag = `${elementPrefix}-${minimal ? 'minimal-' : ''}skin`;
const mediaTag = preset === 'background' ? 'background-video' : preset.endsWith('audio') ? 'audio' : 'video';
const mediaSrc = preset.startsWith('live-') ? 'live.m3u8' : mediaTag === 'audio' ? 'audio.mp3' : 'video.mp4';
const cdnCode = [
  `<script type="module" src="${VJS10_HTML_CDN_BASE}/${bundle}.js"></script>`,
  '',
  `<${playerTag}>`,
  `  <${skinTag}>`,
  `    <${mediaTag} src="${mediaSrc}"></${mediaTag}>`,
  `  </${skinTag}>`,
  `</${playerTag}>`,
].join('\n');

const imports: Array<{ code: string; framework: 'react' | 'html'; lang: BundledLanguage }> = [
  {
    code: `import { ${react} } from '@videojs/react/${preset}';\nimport '@videojs/react/${preset}/${module}.css';`,
    framework: 'react',
    lang: 'tsx',
  },
  {
    code: `import '@videojs/html/${preset}/${module}';`,
    framework: 'html',
    lang: 'ts',
  },
];
---

{
  imports.map(({ code, framework, lang }) => (
    <FrameworkCase frameworks={[framework]}>
      <CodeFrame lang={lang}>
        <ServerCode code={code} lang={lang} />
      </CodeFrame>
    </FrameworkCase>
  ))
}

<FrameworkCase frameworks={['html']}>
  <P>
    The import registers the skin and every UI element it composes. The <DocsLink slug="concepts/cdn">CDN</DocsLink>{' '}
    player bundle registers this skin together with its player, so one script tag serves the whole markup:
  </P>
  <CodeFrame lang="html">
    <ServerCode code={cdnCode} lang="html" />
  </CodeFrame>
</FrameworkCase>
