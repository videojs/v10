---
import type { ComponentEventDef } from '@/types/component-reference';
import ApiTable from './ApiTable.astro';
import SimpleRow from './SimpleRow.astro';

interface Props {
  events: ComponentEventDef[];
}

const { events } = Astro.props;
---

<ApiTable columns={["Event", "Description"]}>
  {events.map((event) => <SimpleRow name={event.name} description={event.description} />)}
</ApiTable>
