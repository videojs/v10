---
import SimpleRow from './SimpleRow.astro';

interface Props {
  name: string;
  description?: string;
  componentName: string;
}

const { name, description, componentName } = Astro.props;

const id = `${componentName}-css-var-${name.replace(/^--/, '')}`;
---

<SimpleRow id={id} name={name} description={description} />
