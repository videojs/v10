---
import MarkdownCode from '@/components/typography/MarkdownCode.astro';
import AnchorLink from './AnchorLink.astro';
import DetailRow from './DetailRow.astro';
import InlineCode from './InlineCode.astro';

interface Props {
  name: string;
  type: string;
  detailedType?: string;
  description?: string;
  componentName: string;
  kind?: string;
  toggleColumn?: boolean;
}

const { name, type, detailedType, description, componentName, kind = 'state', toggleColumn } = Astro.props;

const id = `${componentName}-${kind}-${name}`;
---

<DetailRow
  id={id}
  name={name}
  detailedType={detailedType}
  description={description}
  colspan={2}
  toggleColumn={toggleColumn}
>
  <td>
    <span class="inline-flex items-center whitespace-nowrap">
      <MarkdownCode>{name}</MarkdownCode>
      <AnchorLink id={id} name={name} />
    </span>
  </td>
  <td class="w-full">
    <InlineCode code={type} />
  </td>
</DetailRow>
