---
import ModuleImports from './ModuleImports.astro';

interface Props {
  /** Extension name: the suffix of the `extensions/` subpath on both platforms and of the CDN bundle. */
  extension: string;
  /** Named export from `@videojs/react/extensions/<extension>`. */
  react: string;
}

const { extension, react } = Astro.props;
---

<ModuleImports name={extension} react={react} subpath="extensions" />
