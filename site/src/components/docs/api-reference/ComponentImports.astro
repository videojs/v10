---
import type { BundledLanguage } from 'shiki';

import ServerCode from '@/components/Code/ServerCode.astro';
import CodeFrame from '@/components/typography/CodeFrame.astro';
import type { SupportedFramework } from '@/types/docs';
import { HTML_API_FRAMEWORKS } from '@/types/docs';
import FrameworkCase from '../FrameworkCase.astro';

interface Props {
  component: string;
  html: string;
}

const { component, html } = Astro.props;

// Vue and Svelte read the custom-element API, so they get the `@videojs/html` import too.
const imports: Array<{ code: string; frameworks: SupportedFramework[]; lang: BundledLanguage }> = [
  {
    code: `import { ${component} } from '@videojs/react';`,
    frameworks: ['react'],
    lang: 'tsx',
  },
  {
    code: `import '@videojs/html/ui/${html}';`,
    frameworks: HTML_API_FRAMEWORKS,
    lang: 'ts',
  },
];
---

{
  imports.map(({ code, frameworks, lang }) => (
    <FrameworkCase frameworks={frameworks}>
      <CodeFrame lang={lang}>
        <ServerCode code={code} lang={lang} />
      </CodeFrame>
    </FrameworkCase>
  ))
}
