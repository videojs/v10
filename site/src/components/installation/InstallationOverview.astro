---
import Aside from '@/components/Aside.astro';
import DocsLink from '@/components/docs/DocsLink.astro';
import P from '@/components/typography/P.astro';
import { isInstallationRouteSegment } from '@/utils/installation/routes';
import ReleaseCandidateNotice from './ReleaseCandidateNotice.astro';

const route = Astro.params.framework;
if (!isInstallationRouteSegment(route)) throw new Error(`Unsupported installation route: ${route}`);
---

<P class="min-h-42 @sm:min-h-34 @lg:min-h-26 @2xl:min-h-20">
  {
    route === 'react' && (
      <>
        Video.js is a <strong class="font-semibold">React video player component library</strong>: composable
        primitives, hooks, and TypeScript types for building accessible, customizable players with minimal bundle sizes,
        advanced features, and consistency across browsers.
      </>
    )
  }
  {
    route === 'html' && (
      <>
        Video.js is an <strong class="font-semibold">HTML video player built on custom elements</strong>: lightweight,
        framework-free components for building accessible, customizable players with minimal bundle sizes, advanced
        features, and consistency across browsers.
      </>
    )
  }
  {
    route === 'vue' && (
      <>
        Vue and Nuxt apps use Video.js HTML custom elements directly in their templates. These lightweight,
        framework-free components build accessible, customizable players with small bundles, advanced features, and
        consistent behavior across browsers.
      </>
    )
  }
  {
    route === 'svelte' && (
      <>
        Svelte and SvelteKit apps use Video.js HTML custom elements directly in their markup. These lightweight,
        framework-free components build accessible, customizable players with small bundles, advanced features, and
        consistent behavior across browsers.
      </>
    )
  }
  {
    route === 'shadcn' && (
      <>
        Use Shadcn to add a Video.js skin's components, layout, styles, and interactions to your React or HTML project.
        The CLI copies the files into your app so you can review and change them like any other source code.
      </>
    )
  }
  {
    route === 'cdn' && (
      <>
        Video.js can run directly from browser-ready files on jsDelivr. This HTML-only path needs no package manager or
        build step: choose a player, load its scripts, and add the generated custom-element markup to your page.
      </>
    )
  }
</P>

<ReleaseCandidateNotice />

<Aside type="tip" title="Coming from another player?">
  Follow the migration guide for <DocsLink slug="guides/migrate-from-video-js-8">Video.js 8</DocsLink>, <DocsLink
    slug="guides/migrate-from-mux-player">Mux Player</DocsLink
  >, <DocsLink slug="guides/migrate-from-plyr">Plyr</DocsLink>, or <DocsLink
    slug="guides/migrate-from-media-chrome">Media Chrome</DocsLink
  >. Each maps your existing setup onto Video.js v10 instead of starting from scratch.
</Aside>
