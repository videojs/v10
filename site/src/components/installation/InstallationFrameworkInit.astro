---
import {
  defaultRegistryStyling,
  INSTALLATION_FRAMEWORKS,
  INSTALLATION_PRESETS,
  INSTALLATION_PROJECTS,
  INSTALLATION_QUERY_PARAMETERS,
  INSTALLATION_TEMPLATES,
  installationProjectFiles,
  REGISTRY_STYLINGS,
  shadcnProjectConfiguration,
  shadcnProjectConfigurationPlacement,
  sourceFrameworkFor,
  type InstallationTemplate,
} from '@videojs/installation';
import { FRAMEWORK_COOKIE } from '@/utils/docs/preferences';
import {
  INSTALLATION_ROUTE_PREFIX,
  INSTALLATION_ROUTE_SEGMENTS,
  INSTALLATION_ROUTES,
  type InstallationRouteSegment,
} from '@/utils/installation/routes';
import { parseInstallationSearchForRoute } from '@/utils/installation/url-state';

/**
 * Match prerendered installation branches to the URL before the React islands hydrate. Every table below comes from
 * probing the site's URL parser, which applies the rules from `@videojs/installation`, so this script and the islands
 * agree on which picks a query keeps.
 */

const REGISTRY_FRAMEWORKS = [...new Set(INSTALLATION_FRAMEWORKS.map(sourceFrameworkFor))];

function parse(route: InstallationRouteSegment, query: Record<string, string>) {
  return parseInstallationSearchForRoute(route, `?${new URLSearchParams(query)}`);
}

function routeRules(route: InstallationRouteSegment, query: Record<string, string> = {}) {
  const templates = INSTALLATION_TEMPLATES.filter(
    (template) => parse(route, { ...query, template }).template === template
  );

  return {
    presets: Object.values(INSTALLATION_PRESETS)
      .map(({ flag }) => flag)
      .filter((preset) => INSTALLATION_PRESETS[parse(route, { ...query, preset }).useCase].flag === preset),
    projects: INSTALLATION_PROJECTS.filter((project) => parse(route, { ...query, project }).project === project),
    templates,
    defaultTemplate: parse(route, query).template,
    // App setups that can start a new project instead of joining an existing one.
    newProjectTemplates: templates.filter(
      (template) => parse(route, { ...query, template, project: 'new' }).project === 'new'
    ),
  };
}

const routes = Object.fromEntries(
  INSTALLATION_ROUTE_SEGMENTS.filter((route) => route !== 'shadcn').map((route) => [route, routeRules(route)])
);
const shadcnFrameworks = Object.fromEntries(
  REGISTRY_FRAMEWORKS.map((framework) => [
    framework,
    {
      ...routeRules('shadcn', { framework }),
      stylings: REGISTRY_STYLINGS.filter((styling) => parse('shadcn', { framework, styling }).styling === styling),
      defaultStyling: defaultRegistryStyling(framework),
    },
  ])
);
const shadcn = {
  serverFramework: sourceFrameworkFor(INSTALLATION_ROUTES.shadcn.pickerFramework),
  sourceFrameworks: Object.fromEntries(
    INSTALLATION_FRAMEWORKS.map((framework) => [framework, sourceFrameworkFor(framework)])
  ),
  frameworks: shadcnFrameworks,
};
const defaultPreset = INSTALLATION_PRESETS[parse('react', {}).useCase].flag;
// `method` only names the guide, which the path already decides, so it does not change what the page shows.
const selectionQueries = INSTALLATION_QUERY_PARAMETERS.filter((query) => query !== 'method');

// Presets whose skin query changes nothing, so the skin section has nothing to offer.
const presetsWithoutSkinChoice = routes.react!.presets.filter(
  (preset) => parse('react', { preset, skin: 'minimal' }).skin === parse('react', { preset }).skin
);

// Combinations whose Shadcn configuration happens during app creation or the registry step instead of its own section.
const configurationOutsideSection = REGISTRY_FRAMEWORKS.flatMap((framework) => {
  const rules = shadcnFrameworks[framework]!;

  return rules.stylings.flatMap((styling) =>
    INSTALLATION_PROJECTS.flatMap((project) =>
      rules.templates.flatMap((template: InstallationTemplate) => {
        const configuration = shadcnProjectConfiguration(
          framework,
          template,
          styling,
          installationProjectFiles(framework, template).componentsAlias
        );

        return shadcnProjectConfigurationPlacement(configuration, project) === 'section'
          ? []
          : [
              `html[data-registry-framework="${framework}"][data-registry-styling="${styling}"][data-installation-project="${project}"][data-installation-template="${template}"]`,
            ];
      })
    )
  );
});

function rule(selectors: readonly string[], declarations: string): string {
  return selectors.length > 0 ? `${selectors.join(',\n')} { ${declarations} }` : '';
}

const generatedCss = [
  rule(
    presetsWithoutSkinChoice.map((preset) => `html[data-installation-preset="${preset}"] [data-installation-skin-section]`),
    'display: none;'
  ),
  rule(
    configurationOutsideSection.map((selector) => `${selector} [data-shadcn-configuration-section]`),
    'display: none !important;'
  ),
].join('\n');
---

<style is:global>
  html [data-shadcn-framework="html"] {
    display: none;
  }

  html[data-registry-framework="html"] [data-shadcn-framework="react"] {
    display: none;
  }

  html[data-registry-framework="html"] [data-shadcn-framework="html"] {
    display: contents;
  }

  html[data-installation-project] [data-installation-project-content] {
    display: none !important;
  }

  html[data-installation-project="new"] [data-installation-project-content="new"],
  html[data-installation-project="existing"] [data-installation-project-content="existing"] {
    display: block !important;
  }

  /* An existing site without an app setup has nothing to create or run. */
  html[data-installation-template="none"]
    :is([data-installation-starting-point-section], [data-installation-named-app]) {
    display: none !important;
  }
</style>

<style is:inline set:html={generatedCss} />

<script
  is:inline
  define:vars={{
    defaultPreset,
    frameworkCookie: FRAMEWORK_COOKIE,
    routePrefix: `${INSTALLATION_ROUTE_PREFIX}/`,
    routes,
    selectionQueries,
    shadcn,
  }}
>
  function pick(values, value, fallback) {
    return values.includes(value) ? value : fallback;
  }

  function savedFramework() {
    return document.cookie
      .split(";")
      .map((cookie) => cookie.trim().split("="))
      .find(([key]) => key === frameworkCookie)?.[1];
  }

  function applyInstallationState(url, root) {
    if (!root) return;

    const path = url.pathname.replace(/\/$/, "");
    const route = path.startsWith(routePrefix) ? path.slice(routePrefix.length) : "";
    const isShadcn = route === "shadcn";
    const params = new URLSearchParams(url.search);
    const framework = isShadcn
      ? (shadcn.sourceFrameworks[params.get("framework")] ??
        shadcn.sourceFrameworks[savedFramework()] ??
        shadcn.serverFramework)
      : null;
    const rules = isShadcn ? shadcn.frameworks[framework] : routes[route];

    if (!rules) {
      for (const key of [
        "installationPreset",
        "installationProject",
        "installationTemplate",
        "registryFramework",
        "registryStyling",
      ]) {
        delete root.dataset[key];
      }

      root.removeAttribute("data-installation-pending");

      return;
    }

    const template = pick(rules.templates, params.get("template"), rules.defaultTemplate);
    const project = pick(rules.projects, params.get("project"), "existing");

    root.dataset.installationPreset = pick(rules.presets, params.get("preset"), defaultPreset);
    root.dataset.installationProject = rules.newProjectTemplates.includes(template) ? project : "existing";
    root.dataset.installationTemplate = template;

    if (isShadcn) {
      root.dataset.registryFramework = framework;
      root.dataset.registryStyling = pick(rules.stylings, params.get("styling"), rules.defaultStyling);
    } else {
      delete root.dataset.registryFramework;
      delete root.dataset.registryStyling;
    }

    // Any pick in the query, or a Shadcn framework other than the prerendered one, may leave the prerendered picks
    // out of date. The installation store settles this once it loads.
    root.toggleAttribute(
      "data-installation-pending",
      selectionQueries.some((query) => query !== "framework" && params.has(query)) ||
        (isShadcn && framework !== shadcn.serverFramework)
    );
  }

  applyInstallationState(window.location, document.documentElement);

  document.addEventListener("astro:before-swap", function (event) {
    applyInstallationState(event.to, event.newDocument.documentElement);
  });
</script>
