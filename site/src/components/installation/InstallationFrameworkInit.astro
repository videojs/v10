---
import { FRAMEWORK_COOKIE } from '@/utils/docs/preferences';
import { SHADCN_INSTALLATION_PATH } from '@/utils/installation/framework-navigation';

/** Match Shadcn's prerendered framework content to its query before the React islands hydrate. */
---

<style is:global>
  html [data-shadcn-framework="html"] {
    display: none;
  }

  html[data-registry-framework="html"] [data-shadcn-framework="react"] {
    display: none;
  }

  html[data-registry-framework="html"] [data-shadcn-framework="html"] {
    display: contents;
  }

  html [data-shadcn-project-framework] {
    display: none;
  }

  html[data-registry-project-framework="react"] [data-shadcn-project-framework="react"],
  html[data-registry-project-framework="html"] [data-shadcn-project-framework="html"],
  html[data-registry-project-framework="vue"] [data-shadcn-project-framework="vue"],
  html[data-registry-project-framework="svelte"] [data-shadcn-project-framework="svelte"] {
    display: contents;
  }

  html:not([data-registry-project-framework="html"])
    [data-shadcn-installation-method-nav]
    [data-installation-method="cdn"] {
    display: none;
  }

  html[data-installation-preset="background-video"] [data-installation-skin-section] {
    display: none;
  }

  html[data-installation-project] [data-installation-project-content] {
    display: none !important;
  }

  html[data-installation-project="new"] [data-installation-project-content="new"],
  html[data-installation-project="existing"] [data-installation-project-content="existing"] {
    display: block !important;
  }

  html[data-registry-framework="react"][data-registry-styling="tailwind"][data-installation-project="new"]
    [data-shadcn-configuration-section],
  html[data-registry-framework="react"][data-registry-styling="tailwind"][data-installation-project="existing"]:is(
      [data-installation-template="app"],
      [data-installation-template="next"],
      [data-installation-template="start"],
      [data-installation-template="react-router"]
    )
    [data-shadcn-configuration-section] {
    display: none !important;
  }

  html[data-installation-template="none"]
    :is([data-installation-starting-point-section], [data-installation-named-app]) {
    display: none !important;
  }

  html[data-installation-preset] [aria-label="Select media source type"] [data-card-value] {
    display: none;
  }

  html[data-installation-preset="video"]
    [aria-label="Select media source type"]
    :is(
      [data-card-value="html5-video"],
      [data-card-value="hls"],
      [data-card-value="dash"],
      [data-card-value="mux-video"],
      [data-card-value="vimeo"],
      [data-card-value="youtube"],
      [data-card-value="cloudflare"],
      [data-card-value="tiktok"],
      [data-card-value="twitch"]
    ),
  html[data-installation-preset="audio"]
    [aria-label="Select media source type"]
    :is([data-card-value="html5-audio"], [data-card-value="mux-audio"], [data-card-value="spotify"]),
  html[data-installation-preset="live-video"]
    [aria-label="Select media source type"]
    :is([data-card-value="hls"], [data-card-value="mux-video"]),
  html[data-installation-preset="live-audio"]
    [aria-label="Select media source type"]
    [data-card-value="mux-audio"],
  html[data-installation-preset="background-video"]
    [aria-label="Select media source type"]
    :is(
      [data-card-value="background-video"],
      [data-card-value="hls-background-video"],
      [data-card-value="mux-background-video"]
    ) {
    display: flex;
  }

  html[data-installation-preset] [aria-label="Select extensions"] [data-card-value] {
    display: none;
  }

  html:is([data-installation-preset="video"], [data-installation-preset="live-video"]):not(
      [data-installation-skin="none"]
    ):is(
      [data-installation-media="hls"],
      [data-installation-media="dash"],
      [data-installation-media="mux-video"]
    )
    [aria-label="Select extensions"]
    [data-card-value="google-cast"],
  html:is([data-installation-media="mux-video"], [data-installation-media="mux-audio"])
    [aria-label="Select extensions"]
    [data-card-value="mux-data"] {
    display: flex;
  }

  html:is([data-installation-preset="video"], [data-installation-preset="live-video"]):not(
      [data-installation-skin="none"]
    ):is(
      [data-installation-media="hls"],
      [data-installation-media="dash"],
      [data-installation-media="mux-video"]
    )
    [data-extension-empty],
  html:is([data-installation-media="mux-video"], [data-installation-media="mux-audio"])
    [data-extension-empty] {
    display: none;
  }
</style>

<script
  is:inline
  define:vars={{
    frameworkCookie: FRAMEWORK_COOKIE,
    shadcnPath: SHADCN_INSTALLATION_PATH,
  }}
>
  function applyInstallationPreset(url, root) {
    if (!root) return;

    const path = url.pathname.replace(/\/$/, "");
    const isInstallation = path.startsWith("/docs/guides/installation/");

    if (!isInstallation) {
      delete root.dataset.installationPreset;
      delete root.dataset.installationMedia;
      delete root.dataset.installationSkin;
      return;
    }

    const params = new URLSearchParams(url.search);
    const requested = params.get("preset");
    const preset = ["video", "audio", "live-video", "live-audio", "background-video"].includes(requested ?? "")
      ? requested
      : "video";
    const normalizedPreset = path === shadcnPath && preset === "background-video" ? "video" : preset;
    const mediaByPreset = {
      video: ["html5-video", "hls", "dash", "mux-video", "vimeo", "youtube", "cloudflare", "tiktok", "twitch"],
      audio: ["html5-audio", "mux-audio", "spotify"],
      "live-video": ["hls", "mux-video"],
      "live-audio": ["mux-audio"],
      "background-video": ["background-video", "hls-background-video", "mux-background-video"],
    };
    const media = mediaByPreset[normalizedPreset];
    const requestedMedia = params.get("media");
    const requestedSkin = params.get("skin");

    root.dataset.installationPreset = normalizedPreset;
    root.dataset.installationMedia = media.includes(requestedMedia) ? requestedMedia : media[0];
    root.dataset.installationSkin =
      path === shadcnPath && requestedSkin === "none"
        ? "default"
        : ["default", "minimal", "none"].includes(requestedSkin ?? "")
          ? requestedSkin
          : "default";
  }

  function applyInstallationProject(url, root) {
    if (!root) return;

    const path = url.pathname.replace(/\/$/, "");
    const isInstallation = path.startsWith("/docs/guides/installation/");

    if (!isInstallation) {
      delete root.dataset.installationProject;
      delete root.dataset.installationTemplate;
      return;
    }

    const params = new URLSearchParams(url.search);
    const requested = params.get("project");
    const template = params.get("template");
    const existingOnly = path.endsWith("/cdn") || template === "none";

    root.dataset.installationProject = !existingOnly && requested === "new" ? "new" : "existing";
    root.dataset.installationTemplate = template ?? "app";
  }

  function applyInstallationFramework(url, root) {
    if (!root) return;

    const isShadcn = url.pathname.replace(/\/$/, "") === shadcnPath;

    if (!isShadcn) {
      delete root.dataset.registryFramework;
      delete root.dataset.registryProjectFramework;
      delete root.dataset.registryStyling;
      return;
    }

    const params = new URLSearchParams(url.search);
    const requested = params.get("framework");
    const saved = document.cookie
      .split(";")
      .map((cookie) => cookie.trim().split("="))
      .find(([key]) => key === frameworkCookie)?.[1];

    const projectFramework = requested === "react"
      ? "react"
      : requested === "html" || requested === "vue" || requested === "svelte"
        ? requested
      : saved === "html" || saved === "react"
        ? saved
        : "react";

    root.dataset.registryProjectFramework = projectFramework;
    root.dataset.registryFramework = projectFramework === "react" ? "react" : "html";
    root.dataset.registryStyling = projectFramework === "react" && params.get("styling") !== "css" ? "tailwind" : "css";
  }

  applyInstallationFramework(window.location, document.documentElement);
  applyInstallationPreset(window.location, document.documentElement);
  applyInstallationProject(window.location, document.documentElement);

  document.addEventListener("astro:before-swap", function (event) {
    applyInstallationFramework(event.to, event.newDocument.documentElement);
    applyInstallationPreset(event.to, event.newDocument.documentElement);
    applyInstallationProject(event.to, event.newDocument.documentElement);
  });
</script>
