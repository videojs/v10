---
import { FRAMEWORK_COOKIE } from '@/utils/docs/preferences';
import { SHADCN_INSTALLATION_PATH } from '@/utils/installation/framework-navigation';
import { INSTALLATION_QUERY_PARAMETERS } from '@videojs/installation';

/** Match Shadcn's prerendered framework content to its query before the React islands hydrate. */
---

<style is:global>
  html[data-installation-query-pending] [data-installation-query-state],
  html[data-installation-query-pending] [data-installation-plan] {
    visibility: hidden;
  }

  html [data-shadcn-framework="html"] {
    display: none;
  }

  html[data-registry-framework="html"] [data-shadcn-framework="react"] {
    display: none;
  }

  html[data-registry-framework="html"] [data-shadcn-framework="html"] {
    display: contents;
  }

  html [data-shadcn-project-framework] {
    display: none;
  }

  html[data-registry-project-framework="react"] [data-shadcn-project-framework="react"],
  html[data-registry-project-framework="html"] [data-shadcn-project-framework="html"],
  html[data-registry-project-framework="vue"] [data-shadcn-project-framework="vue"],
  html[data-registry-project-framework="svelte"] [data-shadcn-project-framework="svelte"] {
    display: contents;
  }

</style>

<script
  is:inline
  define:vars={{
    frameworkCookie: FRAMEWORK_COOKIE,
    installationParams: INSTALLATION_QUERY_PARAMETERS,
    shadcnPath: SHADCN_INSTALLATION_PATH,
  }}
>
  function applyInstallationQueryState(url, root) {
    if (!root) return;

    const isInstallation = url.pathname.replace(/\/$/, "").startsWith("/docs/guides/installation/");
    const isShadcn = url.pathname.replace(/\/$/, "") === shadcnPath;
    const params = new URLSearchParams(url.search);
    const requestedFramework = params.get("framework");
    const needsSavedHtmlFramework = isShadcn
      && !["react", "html", "vue", "svelte"].includes(requestedFramework ?? "")
      && root.dataset.registryFramework === "html";
    const hasSelection = isInstallation
      && (installationParams.some((parameter) => params.has(parameter)) || needsSavedHtmlFramework);

    if (hasSelection) {
      root.dataset.installationQueryPending = "";
    } else {
      delete root.dataset.installationQueryPending;
    }
  }

  function applyInstallationFramework(url, root) {
    if (!root) return;

    const isShadcn = url.pathname.replace(/\/$/, "") === shadcnPath;

    if (!isShadcn) {
      delete root.dataset.registryFramework;
      delete root.dataset.registryProjectFramework;
      return;
    }

    const requested = new URLSearchParams(url.search).get("framework");
    const saved = document.cookie
      .split(";")
      .map((cookie) => cookie.trim().split("="))
      .find(([key]) => key === frameworkCookie)?.[1];

    const projectFramework = requested === "react"
      ? "react"
      : requested === "html" || requested === "vue" || requested === "svelte"
        ? requested
      : saved === "html" || saved === "react"
        ? saved
        : "react";

    root.dataset.registryProjectFramework = projectFramework;
    root.dataset.registryFramework = projectFramework === "react" ? "react" : "html";
  }

  applyInstallationFramework(window.location, document.documentElement);
  applyInstallationQueryState(window.location, document.documentElement);

  document.addEventListener("astro:before-swap", function (event) {
    applyInstallationFramework(event.to, event.newDocument.documentElement);
    applyInstallationQueryState(event.to, event.newDocument.documentElement);
  });
</script>
