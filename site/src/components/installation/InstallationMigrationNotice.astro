---
import Aside from '@/components/Aside.astro';
import DocsLink from '@/components/docs/DocsLink.astro';
import type { SupportedFramework } from '@/types/docs';

interface Props {
  framework?: SupportedFramework;
}

const { framework } = Astro.props;
---

<Aside type="tip" title="Coming from another player?">
  Follow the migration guide for <DocsLink slug="guides/migrate-from-video-js-8" framework={framework}
    >Video.js 8</DocsLink
  >, <DocsLink slug="guides/migrate-from-mux-player" framework={framework}>Mux Player</DocsLink>, <DocsLink
    slug="guides/migrate-from-plyr"
    framework={framework}>Plyr</DocsLink
  >, or <DocsLink slug="guides/migrate-from-media-chrome" framework={framework}>Media Chrome</DocsLink>. Each maps your
  existing setup onto Video.js v10 instead of starting from scratch.
</Aside>
