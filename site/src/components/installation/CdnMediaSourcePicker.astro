---
import MediaSourcePicker from '@/components/installation/MediaSourcePicker';
import { CDN_MEDIA_SUBPATHS, rendererSupportsCdn, RENDERERS } from '@videojs/installation';

const supportedRenderers = RENDERERS.filter((renderer) => rendererSupportsCdn(renderer, CDN_MEDIA_SUBPATHS));
---

<MediaSourcePicker client:load supportedRenderers={supportedRenderers} />
