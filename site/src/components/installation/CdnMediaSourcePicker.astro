---
import { getCollection } from 'astro:content';

import MediaSourcePicker from '@/components/installation/MediaSourcePicker';
import { rendererSupportsCdn } from '@videojs/installation';
import { RENDERERS } from '@videojs/installation';

const cdnMedia = (await getCollection('cdnMedia')).map((entry) => entry.id);
const supportedRenderers = RENDERERS.filter((renderer) => rendererSupportsCdn(renderer, cdnMedia));
---

<MediaSourcePicker client:idle supportedRenderers={supportedRenderers} />
