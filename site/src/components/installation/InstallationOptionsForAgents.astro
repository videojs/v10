---
import {
  installationCommand,
  installationCompatibility,
  installationDecisionOrderFor,
  installationOptionDefinitionsFor,
  installationTemplatesForMethod,
  type InstallationFramework,
  type InstallationMethod,
} from '@videojs/installation';

import { isInstallationRouteSegment } from '@/utils/installation/routes';

const route = Astro.params.framework;
if (!isInstallationRouteSegment(route)) throw new Error(`Unsupported installation route: ${route}`);

const command = installationCommand(undefined, null);
const fixedMethod: InstallationMethod = route === 'shadcn' ? 'shadcn' : route === 'cdn' ? 'cdn' : 'packaged';
const fixedFramework: InstallationFramework | null = route === 'shadcn' ? null : route === 'cdn' ? 'html' : route;
const frameworks: readonly InstallationFramework[] = fixedFramework ? [fixedFramework] : ['react', 'html'];
const definitions = installationOptionDefinitionsFor({ methods: [fixedMethod], frameworks });
const decisionOrder = installationDecisionOrderFor({ methods: [fixedMethod], frameworks });
const queryOptions = definitions
  .filter((option) => {
    if (['--json', '--method'].includes(option.flag)) return false;

    if (option.flag === '--framework') return route === 'shadcn';

    return true;
  })
  .map((option) => option.flag === '--package-manager' ? { ...option, default: 'pnpm' } : option);
const availablePresets = queryOptions.find(({ flag }) => flag === '--preset')?.values ?? [];
const mediaByPreset = Object.entries(installationCompatibility.mediaByPreset).filter(([preset]) =>
  availablePresets.includes(preset)
);
// Package text marks code with backticks; render those spans as code so they do not print as literal backticks.
const codeSpans = (text: string) => text.split('`').map((part, index) => ({ part, code: index % 2 === 1 }));
const routeExamples = [
  ['/docs/guides/installation/react.md', 'React with packaged modules'],
  ['/docs/guides/installation/html.md', 'HTML with packaged modules'],
  ['/docs/guides/installation/vue.md', 'Vue with packaged HTML custom elements'],
  ['/docs/guides/installation/svelte.md', 'Svelte with packaged HTML custom elements'],
  ['/docs/guides/installation/shadcn.md?framework=react', 'Shadcn with React source'],
  ['/docs/guides/installation/shadcn.md?framework=html', 'Shadcn with plain HTML source'],
  ['/docs/guides/installation/cdn.md', 'HTML from the CDN'],
] as const;
---

<div hidden data-llms-only>
  <h2>Installation options for coding agents</h2>

  <p>
    The web Markdown page contains the default installation. Add the query parameters below to its <code>.md</code> URL
    for a complete, validated variation. From a project or an offline docs bundle, run the CLI command below instead.
    Both paths use the same installation renderer and only return instructions; they do not modify a project.
  </p>

  <p>
    This page fixes the installation method to <code>{fixedMethod}</code>{fixedFramework
      ? <> and the framework to <code>{fixedFramework}</code></>
      : <>. The <code>framework</code> query parameter selects React or HTML</>}.
  </p>

  <pre><code class="language-sh">{command}</code></pre>

  <h3>Query parameters</h3>

  <ul>
    {queryOptions.map((option) => (
      <li>
        <code>{option.query}</code>: {codeSpans(option.description).map(({ part, code }) => (code ? <code>{part}</code> : part))}{' '}
        {option.values && (
          <>
            Values: {option.values.map((value, index) => <>{index > 0 && ', '}<code>{value}</code></>)}.{' '}
          </>
        )}
        Default: {codeSpans(option.default).map(({ part, code }) => (code ? <code>{part}</code> : part))}.{option.appliesWhen && <> Applies when {option.appliesWhen.replaceAll('--', '')}.</>}
      </li>
    ))}
  </ul>

  <p>
    Run the command above without flags to see the corresponding CLI flags for every framework.
  </p>

  <h3>Decide in this order</h3>

  <ol>
    {decisionOrder.map(({ title, guidance }) => (
      <li><strong>{title}.</strong> {codeSpans(guidance).map(({ part, code }) => (code ? <code>{part}</code> : part))}</li>
    ))}
  </ol>

  <h3>Compatible media sources by preset</h3>

  <ul>
    {mediaByPreset.map(([preset, media]) => (
      <li><code>{preset}</code>: {media.map((value, index) => <>{index > 0 && ', '}<code>{value}</code></>)}</li>
    ))}
  </ul>

  <h3>{route === 'shadcn' ? 'App setup and Shadcn styling by framework' : 'App setup by framework'}</h3>

  <ul>
    {frameworks.map((framework) => {
      const templates = installationTemplatesForMethod(framework, fixedMethod);

      return (
        <li>
          <code>{framework}</code>: templates{' '}
          {templates.map((value, index) => <>{index > 0 && ', '}<code>{value}</code></>)}
          {route === 'shadcn' && (
            <>; styling{' '}
            {(installationCompatibility.shadcn.stylingsByFramework[framework] ?? []).map((value, index) => (
              <>{index > 0 && ', '}<code>{value}</code></>
            ))}</>
          )}
        </li>
      );
    })}
  </ul>

  <h3>Installation pages</h3>

  <ul>
    {routeExamples.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
  </ul>
</div>
