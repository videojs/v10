---
import { getCollection } from 'astro:content';

import { rendererSupportsCdn } from '@/utils/installation/cdn-code';
import { isInstallationRouteSegment } from '@/utils/installation/routes';
import {
  REGISTRY_STYLINGS,
  REGISTRY_TEMPLATES,
  REGISTRY_THEMES,
  SHADCN_RUNNER_NAMES,
} from '@/utils/installation/shadcn';
import { getInstallationPreset, INSTALLATION_SKIN_FLAGS, USE_CASES } from '@/utils/installation/types';

const route = Astro.params.framework;
if (!isInstallationRouteSegment(route)) throw new Error(`Unsupported installation route: ${route}`);

const isShadcn = route === 'shadcn';
const isCdn = route === 'cdn';
const useCases = USE_CASES.filter((useCase) => !isShadcn || useCase !== 'background-video');
const presets = useCases.map((useCase) => getInstallationPreset(useCase).flag).join('|');
const skins = INSTALLATION_SKIN_FLAGS.join('|');
const cdnMediaSubpaths = isCdn ? (await getCollection('cdnMedia')).map((entry) => entry.id) : [];
const media = [
  ...new Set(
    useCases
      .flatMap((useCase) => getInstallationPreset(useCase).renderers)
      .filter((renderer) => !isCdn || rendererSupportsCdn(renderer, cdnMediaSubpaths)),
  ),
].join('|');
const command = [
  `npx @videojs/cli docs guides/installation/${route} \\`,
  ...(isShadcn ? ['  --framework <react|html> \\'] : []),
  `  --preset <${presets}> \\`,
  ...(isShadcn ? [`  --theme <${REGISTRY_THEMES.join('|')}> \\`] : [`  --skin <${skins}> \\`]),
  `  --media <${media}> \\`,
  ...(isCdn ? ['  --source-url <url>'] : ['  --source-url <url> \\']),
  ...(isShadcn
    ? [
        `  --template <${REGISTRY_TEMPLATES.join('|')}> \\`,
        `  --styling <${REGISTRY_STYLINGS.join('|')}> \\`,
      ]
    : []),
  ...(!isCdn ? [`  --package-manager <${SHADCN_RUNNER_NAMES.join('|')}>`] : []),
].join('\n');
---

<div hidden data-llms-only>
  <div data-cli-omit="installation">
    <h2>Generate tailored instructions</h2>

    <p>
      The examples below use the default choices. To receive installation commands, imports, and player code for an
      exact combination, run:
    </p>

    <pre data-language="bash"><code>{command}</code></pre>

    <p>
      In an interactive terminal, omitted choices are prompted. Agents, automation, and CI receive a list of missing
      flags instead of a prompt. Pass an empty <code>--source-url ''</code> to use demo media.
    </p>

    {
      isShadcn && (
        <p>
          React supports every listed template and <code>tailwind</code> or <code>css</code> styling. HTML supports{' '}
          <code>vite</code>, <code>astro</code>, or <code>laravel</code> with <code>css</code> styling. Vue and Svelte
          projects use the HTML source with <code>--framework html</code>.
        </p>
      )
    }

    {
      isCdn ? (
        <p>CDN installation is HTML-only and does not use a package manager.</p>
      ) : (
        <p>
          The older <code>--install-method &lt;cdn|npm|pnpm|yarn|bun&gt;</code> flag remains compatible. On a canonical route,
          it cannot change the route's installation method; package-manager values still select its package manager.
        </p>
      )
    }

    <p>
      The generic <code>guides/installation</code> slug also accepts <code>--method packaged</code>,{' '}
      <code>--method shadcn</code>, or <code>--method cdn</code>. Prefer the canonical route above when the method and
      framework are already known.
    </p>
  </div>
</div>
