---
const routes = ['react', 'html', 'vue', 'svelte', 'shadcn', 'cdn'] as const;

type InstallationRoute = (typeof routes)[number];

const route = Astro.params.framework;

function isInstallationRoute(value: string | undefined): value is InstallationRoute {
  return routes.some((candidate) => candidate === value);
}

if (!isInstallationRoute(route)) throw new Error(`Unsupported installation route: ${route}`);

const isShadcn = route === 'shadcn';
const isCdn = route === 'cdn';
const presets = isShadcn
  ? 'video|audio|live-video|live-audio'
  : 'video|audio|live-video|live-audio|background-video';
const skins = 'default|minimal|none';
const media = `html5-video|html5-audio|hls|dash|mux-video|mux-audio|vimeo|youtube|cloudflare|tiktok|twitch|spotify${isShadcn ? '' : '|background-video'}`;
const command = [
  `npx @videojs/cli docs guides/installation/${route} \\`,
  ...(isShadcn ? ['  --framework <react|html> \\'] : []),
  `  --preset <${presets}> \\`,
  ...(isShadcn ? ['  --theme <default|minimal> \\'] : [`  --skin <${skins}> \\`]),
  `  --media <${media}> \\`,
  ...(isCdn ? ['  --source-url <url>'] : ['  --source-url <url> \\']),
  ...(isShadcn
    ? ['  --template <next|vite|start|laravel|react-router|astro> \\', '  --styling <tailwind|css> \\']
    : []),
  ...(!isCdn ? ['  --package-manager <npm|pnpm|yarn|bun>'] : []),
].join('\n');
---

<div hidden data-llms-only>
  <div data-cli-omit="installation">
    <h2>Generate tailored instructions</h2>

    <p>
      The examples below use the default choices. To receive installation commands, imports, and player code for an
      exact combination, run:
    </p>

    <pre data-language="bash"><code>{command}</code></pre>

    <p>
      In an interactive terminal, omitted choices are prompted. Agents, automation, and CI receive a list of missing
      flags instead of a prompt. Pass an empty <code>--source-url ''</code> to use demo media.
    </p>

    {
      isShadcn && (
        <p>
          React supports every listed template and <code>tailwind</code> or <code>css</code> styling. HTML supports{' '}
          <code>vite</code>, <code>astro</code>, or <code>laravel</code> with <code>css</code> styling.
        </p>
      )
    }

    {
      isCdn ? (
        <p>CDN installation is HTML-only and does not use a package manager.</p>
      ) : (
        <p>
          The older <code>--install-method &lt;cdn|npm|pnpm|yarn|bun&gt;</code> flag remains compatible. New commands keep
          the installation method and package manager as separate decisions.
        </p>
      )
    }

    <p>
      The generic <code>guides/installation</code> slug also accepts <code>--method packaged</code>,{' '}
      <code>--method shadcn</code>, or <code>--method cdn</code>. Prefer the canonical route above when the method and
      framework are already known.
    </p>
  </div>
</div>
