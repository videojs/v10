---
import { getCollection } from 'astro:content';

import { rendererSupportsCdn } from '@/utils/installation/cdn-code';
import {
  getInstallationMethodsForFramework,
  INSTALLATION_METHOD_OPTIONS,
  type InstallationMethod,
} from '@/utils/installation/method-options';
import { RENDERER_LABELS } from '@/utils/installation/renderer-options';
import { INSTALLATION_ROUTES, isInstallationRouteSegment } from '@/utils/installation/routes';
import {
  REGISTRY_STYLING_LABELS,
  REGISTRY_TEMPLATE_LABELS,
  registryStylings,
  registryTemplates,
} from '@/utils/installation/shadcn';
import { getInstallationPreset, USE_CASES } from '@/utils/installation/types';

const route = Astro.params.framework;
if (!isInstallationRouteSegment(route)) throw new Error(`Unsupported installation route: ${route}`);

const isShadcn = route === 'shadcn';
const isCdn = route === 'cdn';
const routeConfig = INSTALLATION_ROUTES[route];
const packagedHref = isCdn ? '/docs/guides/installation/html' : isShadcn ? '/docs/guides/installation/react' : `/docs/guides/installation/${route}`;
const useCases = USE_CASES.filter((useCase) => !isShadcn || useCase !== 'background-video');
const cdnMediaSubpaths = isCdn ? (await getCollection('cdnMedia')).map((entry) => entry.id) : [];
const mediaChoices = useCases.map((useCase) => {
  const preset = getInstallationPreset(useCase);
  const renderers = preset.renderers.filter(
    (renderer) => !isCdn || rendererSupportsCdn(renderer, cdnMediaSubpaths),
  );

  return { label: preset.label, renderers };
});

const methodHrefs = {
  packaged: packagedHref,
  shadcn:
    route === 'vue' || route === 'svelte'
      ? '/docs/guides/installation/shadcn?framework=html'
      : '/docs/guides/installation/shadcn',
  cdn: '/docs/guides/installation/cdn',
} satisfies Record<InstallationMethod, string>;
const methodLinks = INSTALLATION_METHOD_OPTIONS.map((option) => ({
  ...option,
  href: methodHrefs[option.id],
  details:
    option.id === 'shadcn' && (route === 'vue' || route === 'svelte')
      ? 'Add editable HTML custom-element skin source to your project.'
      : option.details,
}));

const frameworks = [
  ['react', 'React', 'Components and hooks for React 19.', '/docs/guides/installation/react'],
  ['html', 'HTML', 'Custom elements for any stack.', '/docs/guides/installation/html'],
  ['vue', 'Vue', 'Vue 3 and Nuxt using the HTML custom elements.', '/docs/guides/installation/vue'],
  ['svelte', 'Svelte', 'Svelte 5 and SvelteKit using the HTML custom elements.', '/docs/guides/installation/svelte'],
] as const;

const getMethodLabel = (method: InstallationMethod) =>
  INSTALLATION_METHOD_OPTIONS.find(({ id }) => id === method)?.label ?? method;
const selectedFrameworks = isShadcn ? routeConfig.frameworks : [routeConfig.pickerFramework];
const availableMethods = new Set(selectedFrameworks.flatMap(getInstallationMethodsForFramework));
const availableMethodLinks = methodLinks.filter(({ id }) => availableMethods.has(id));
---

<div hidden data-llms-only>
  <div data-cli-omit="installation">
    <h2>Choose your JS framework</h2>

    <p>Your framework filters the installation methods shown next.</p>

    <ul>
      {
        frameworks.map(([id, label, description, href]) => (
          <li>
            <a href={href}>{label}</a>: {description} Available methods:{' '}
            {getInstallationMethodsForFramework(id).map(getMethodLabel).join(', ')}.
          </li>
        ))
      }
    </ul>

    {
      isShadcn && (
        <>
          <p>
            The Shadcn registry generates React or HTML source. Vue and Svelte can use the HTML custom-element source;
            select <code>--framework html</code> in the docs CLI.
          </p>
          <ul>
            {(['react', 'html'] as const).map((framework) => (
              <li>
                <strong>{framework === 'react' ? 'React' : 'HTML'}</strong>
                <ul>
                  <li>
                    Project templates:{' '}
                    {registryTemplates(framework)
                      .map((template) => REGISTRY_TEMPLATE_LABELS[template])
                      .join(', ')}
                  </li>
                  <li>
                    Styling:{' '}
                    {registryStylings(framework)
                      .map((styling) => REGISTRY_STYLING_LABELS[styling])
                      .join(', ')}
                  </li>
                </ul>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <h2>Choose your use case</h2>

    <ul>
      {
        useCases.map((useCase) => {
          const preset = getInstallationPreset(useCase);

          return (
            <li>
              <strong>{preset.label}</strong> (<code>{preset.flag}</code>)
            </li>
          );
        })
      }
    </ul>

    <h2>Choose your skin</h2>

    <ul>
      <li><strong>Default</strong>: the complete control set with a modern, frosted look.</li>
      <li><strong>Minimal</strong>: the same control set with clean, solid surfaces.</li>
      {!isShadcn && <li><strong>No skin</strong>: player and media behavior without a packaged UI.</li>}
    </ul>

    {
      isShadcn && (
        <>
          <p>
            Shadcn copies either the Default or Minimal skin source into the project. It does not currently provide the
            background video skin or a no-skin option.
          </p>
          <p>Commit your work first so you can review every file the CLI adds or replaces.</p>
        </>
      )
    }

    <h2>Choose your media source</h2>

    <p>Available media sources depend on the use case:</p>

    <ul>
      {
        mediaChoices.map(({ label, renderers }) => (
          <li>
            <strong>{label}</strong>:{' '}
            {renderers.map((renderer) => `${RENDERER_LABELS[renderer]} (${renderer})`).join(', ')}
          </li>
        ))
      }
    </ul>

    <p>
      A source URL is optional. An empty value uses working demo media. The generated installation includes a playback
      adapter when the selected media source needs one; native HTML5 media and background video need no separate
      adapter.
    </p>

    <h2>Choose how to install</h2>

    <p>
      Pick one starting path. These are alternatives, not steps to run in sequence. Shadcn does not provide source for
      background video or a no-skin player. CDN availability also depends on the selected media source.
    </p>

    <ul>
      {
        availableMethodLinks.map(({ label, href, details }) => (
          <li>
            <a href={href}>{label}</a>: {details}
          </li>
        ))
      }
    </ul>

    <p>
      The code below is a complete example for the default Video, Default skin, and HTML5 Video choices. Generate
      tailored instructions when you need another combination.
    </p>
  </div>
</div>
