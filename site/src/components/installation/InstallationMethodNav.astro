---
import InstallationMethodNavClient from './InstallationMethodNavClient';
import { INSTALLATION_ROUTES, isInstallationRouteSegment } from '@/utils/installation/routes';

const { framework } = Astro.params;
if (!isInstallationRouteSegment(framework)) throw new Error(`Unsupported installation route: ${framework}`);

const routeFramework = INSTALLATION_ROUTES[framework].pickerFramework;
---

<InstallationMethodNavClient client:idle currentFramework={routeFramework} route={framework} />

<script>
  import { initializeInstallationMethodNavigation } from '@/utils/installation/method-navigation';

  initializeInstallationMethodNavigation();
</script>
