---
import JSPickerClient from './JSPickerClient';

const { framework, slug } = Astro.params;
const routeFramework = framework === 'react' || framework === 'html' || framework === 'vue' || framework === 'svelte'
  ? framework
  : null;
const currentFramework = slug === 'guides/installation-vue'
  ? 'vue'
  : slug === 'guides/installation-svelte'
    ? 'svelte'
    : routeFramework ?? (framework === 'html' ? 'html' : 'react');
---

<JSPickerClient client:idle currentFramework={currentFramework} />
