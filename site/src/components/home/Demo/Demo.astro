---
import ServerCode from '@/components/Code/ServerCode.astro';
import { Tab, TabsList, TabsPanel, TabsRoot } from '@/components/Tabs.tsx';
import { registryComponentsJson, shadcnAddCommand } from '@/utils/installation/shadcn';
import { generateHTMLCode, generateReactCode } from './baseCode';

const frameworks = [
  {
    value: 'react',
    label: 'React',
    usage: { code: generateReactCode('default'), lang: 'tsx' },
    registry: registryComponentsJson('react', 'tailwind'),
  },
  {
    value: 'html',
    label: 'HTML',
    usage: { code: generateHTMLCode('default'), lang: 'html' },
    registry: registryComponentsJson('html', 'css'),
  },
] as const;
const install = shadcnAddCommand('npm', ['video']);
---

<section
  class="mx-auto mb-10 grid w-full max-w-305 gap-x-5 gap-y-20 px-5 lg:mb-0 lg:grid-cols-2 lg:gap-y-0"
>
  <section
    class="row-span-4 grid border-faded-black lg:grid-rows-subgrid lg:border-t lg:py-10 dark:border-manila-light"
  >
    <h2
      class="mb-2.5 text-center font-display text-h2 text-faded-black uppercase lg:mb-1.25 dark:text-manila-light"
    >
      Assemble your player
    </h2>
    <p
      class="font-instrument-sans mb-8 text-center text-p2 font-light text-warm-gray md:mb-10 dark:text-manila-dark"
    >
      Feel at home with your framework, skin, and media source
    </p>

    <TabsRoot client:idle variant="expanded" maxWidth={false} className="m-0 lg:h-100">
      <TabsList client:idle variant="expanded" label="Player implementation">
        {
          frameworks.map((framework, index) => (
            <Tab client:idle variant="expanded" value={framework.value} initial={index === 0}>
              {framework.label}
            </Tab>
          ))
        }
      </TabsList>
      {
        frameworks.map((framework, index) => (
          <TabsPanel
            client:idle
            variant="expanded"
            value={framework.value}
            initial={index === 0}
            className="bg-faded-black dark:bg-soot m-2.5 mt-0"
          >
            <ServerCode code={framework.usage.code} lang={framework.usage.lang} />
          </TabsPanel>
        ))
      }
    </TabsRoot>
  </section>
  <section
    class="row-span-4 grid border-faded-black lg:grid-rows-subgrid lg:border-t lg:py-10 dark:border-manila-light"
  >
    <h2
      class="mb-2.5 text-center font-display text-h2 text-faded-black uppercase lg:mb-1.25 dark:text-manila-light"
    >
      Take full control
    </h2>
    <p
      class="font-instrument-sans mb-8 text-center text-p2 font-light text-warm-gray md:mb-10 dark:text-manila-dark"
    >
      Install any skin's source with the Shadcn CLI and make it your own
    </p>

    <TabsRoot client:idle variant="expanded" maxWidth={false} className="m-0 lg:h-100">
      <TabsList client:idle variant="expanded" label="Registry install">
        {
          frameworks.map((framework, index) => (
            <Tab client:idle variant="expanded" value={framework.value} initial={index === 0}>
              {framework.label}
            </Tab>
          ))
        }
      </TabsList>
      {
        frameworks.map((framework, index) => (
          <TabsPanel
            client:idle
            variant="expanded"
            value={framework.value}
            initial={index === 0}
            className="bg-faded-black dark:bg-soot m-2.5 mt-0"
          >
            <div class="flex flex-col gap-2.5 p-2.5">
              <p class="font-display text-p3 text-manila-dark uppercase">components.json</p>
              <ServerCode code={framework.registry} lang="json" />
              <p class="font-display text-p3 text-manila-dark uppercase">Terminal</p>
              <ServerCode code={install} lang="bash" />
            </div>
          </TabsPanel>
        ))
      }
    </TabsRoot>
  </section>
</section>
