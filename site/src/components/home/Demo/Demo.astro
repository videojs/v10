---
import ServerCode from '@/components/Code/ServerCode.astro';
import { loadRegistryInstallation } from '@/utils/installation/shadcn-registry';
import FrameworkControl from '../FrameworkControl';
import BaseDemo from './Base';
import { generateHTMLCode, generateReactCode } from './baseCode';
import SourceDemo from './Source';

const [defaultHtml, defaultReact, minimalHtml, minimalReact] = await Promise.all([
  loadRegistryInstallation('html', 'css', 'video'),
  loadRegistryInstallation('react', 'css', 'video'),
  loadRegistryInstallation('html', 'css', 'video-minimal'),
  loadRegistryInstallation('react', 'css', 'video-minimal'),
]);

function source(model: Awaited<ReturnType<typeof loadRegistryInstallation>>, suffix: string): string {
  const file = model.files.find((candidate) => candidate.path.endsWith(suffix));
  if (!file) throw new Error(`Registry item ${model.item.name} does not include ${suffix}.`);

  return file.code;
}
---

<section
  class="mx-auto mb-10 grid w-full max-w-305 gap-x-5 gap-y-20 px-5 lg:mb-0 lg:grid-cols-2 lg:gap-y-0"
>
  <section
    class="row-span-4 grid border-faded-black lg:grid-rows-subgrid lg:border-t lg:py-10 dark:border-manila-light"
  >
    <h2
      class="mb-2.5 text-center font-display text-h2 text-faded-black uppercase lg:mb-1.25 dark:text-manila-light"
    >
      Assemble your player
    </h2>
    <p
      class="font-instrument-sans mb-8 text-center text-p2 font-light text-warm-gray md:mb-10 dark:text-manila-dark"
    >
      Feel at home with your framework, skin, and media source
    </p>

    <FrameworkControl client:idle className="mb-5 md:hidden" />
    {/* @ts-expect-error — astro#9451 */}
    <BaseDemo client:idle className="m-0 lg:h-100">
      <ServerCode
        slot="baseDefaultHtml"
        code={generateHTMLCode("default")}
        lang="html"
      />
      <ServerCode
        slot="baseMinimalHtml"
        code={generateHTMLCode("minimal")}
        lang="html"
      />
      <ServerCode
        slot="baseDefaultReact"
        code={generateReactCode("default")}
        lang="tsx"
      />
      <ServerCode
        slot="baseMinimalReact"
        code={generateReactCode("minimal")}
        lang="tsx"
      />
    </BaseDemo>
  </section>
  <section
    class="row-span-4 grid border-faded-black lg:grid-rows-subgrid lg:border-t lg:py-10 dark:border-manila-light"
  >
    <h2
      class="mb-2.5 text-center font-display text-h2 text-faded-black uppercase lg:mb-1.25 dark:text-manila-light"
    >
      Take full control
    </h2>
    <p
      class="font-instrument-sans mb-8 text-center text-p2 font-light text-warm-gray md:mb-10 dark:text-manila-dark"
    >
      Make your player truly your own with fully-editable components
    </p>
    <FrameworkControl client:idle className="mb-5 md:hidden" />
    {/* @ts-expect-error — astro#9451 */}
    <SourceDemo client:idle className="m-0 lg:h-100">
      <ServerCode
        slot="defaultHtmlCode"
        code={source(defaultHtml, '/skins/video/skin.html')}
        lang="html"
      />
      <ServerCode slot="defaultHtmlCss" code={source(defaultHtml, '/skins/video/skin.css')} lang="css" />
      <ServerCode
        slot="defaultReactCode"
        code={source(defaultReact, '/skins/video/skin.tsx')}
        lang="tsx"
      />
      <ServerCode
        slot="defaultReactCss"
        code={source(defaultReact, '/skins/video/skin.css')}
        lang="css"
      />
      <ServerCode
        slot="minimalHtmlCode"
        code={source(minimalHtml, '/skins/video/minimal/skin.html')}
        lang="html"
      />
      <ServerCode slot="minimalHtmlCss" code={source(minimalHtml, '/skins/video/minimal/skin.css')} lang="css" />
      <ServerCode
        slot="minimalReactCode"
        code={source(minimalReact, '/skins/video/minimal/skin.tsx')}
        lang="tsx"
      />
      <ServerCode
        slot="minimalReactCss"
        code={source(minimalReact, '/skins/video/minimal/skin.css')}
        lang="css"
      />
    </SourceDemo>
  </section>
</section>
