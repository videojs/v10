---
import clsx from 'clsx';
import sizes from '@/data/bundle-sizes.json';
import { AnimatedBars } from '../AnimatedBars';

/**
 * Bundle sizes, measured with the repository's bundle-size script and snapshotted in `src/data/bundle-sizes.json`.
 * Bars are proportional to the Video.js 8 reference so the reduction reads at a glance.
 */
const kb = (bytes: number) => `${Math.round(bytes / 1024)} kB`;
const max = sizes.baseline.initial;
const rows = [
  { label: `Video.js ${sizes.baseline.version}`, size: sizes.baseline.initial, accent: false },
  ...sizes.presets.map((preset) => ({ label: preset.label, size: preset.initial, accent: true })),
];
const hlsExtra = kb(sizes.presets[0].total - sizes.presets[0].initial);
---

<AnimatedBars
  className="rounded-lg corner-squircle border border-manila-dark bg-faded-black p-5 md:p-10 lg:p-15"
  client:idle
>
  <header class="text-p2">
    <h3 class="font-semibold text-manila-light">Bundle size</h3>
    <span class="text-manila-dark">Brotli-compressed JavaScript for a complete player</span>
  </header>
  <dl class="mt-6 flex flex-col gap-4">
    {
      rows.map((row, index) => (
        <div class="flex flex-col gap-1.5">
          <div class="flex items-baseline justify-between gap-4 text-p3">
            <dt class={clsx("font-semibold", row.accent ? "text-orange" : "text-manila-light")}>{row.label}</dt>
            <dd class={clsx("font-mono", row.accent ? "text-orange" : "text-manila-light")}>{kb(row.size)}</dd>
          </div>
          <div
            class={clsx("data-bar", row.accent && "data-bar-orange")}
            style={`height: calc(var(--spacing) * 2.5); --data-bar-width: ${(row.size / max) * 100}%; --data-bar-duration: ${0.6 + index * 0.15}s;`}
          />
        </div>
      ))
    }
  </dl>
  <p class="mt-6 text-p4 text-manila-dark">
    {
      `Initial JavaScript per preset, before any streaming engine. hls.js loads on demand and adds about ${hlsExtra}. Measured ${sizes.measuredAt} with the repository's bundle-size script.`
    }
  </p>
</AnimatedBars>
