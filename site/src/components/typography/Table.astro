---
/**
 * Framed table shared by Markdown tables, API reference tables, and hand-written tables in Astro components.
 *
 * The frame clips a horizontally scrolling table; `Thead`, `Tr`, `Th`, and `Td` carry the matching header, divider,
 * and cell styles so every table on the site reads the same way.
 */
import type { HTMLTag, Polymorphic } from 'astro/types';
import { clsx } from 'clsx';
import { twMerge } from '@/utils/twMerge';

type Props<Tag extends HTMLTag = 'table'> = Polymorphic<{ as: Tag }> & {
  maxWidth?: boolean;
  outerClass?: string;
  class?: string;
};

const { as: Tag = 'table', maxWidth = true, outerClass, class: className, ...props } = Astro.props;
---

<div
  class={twMerge(
    clsx(
      "my-8 overflow-hidden rounded-xs border border-line",
      maxWidth && "mx-auto max-w-3xl",
    ),
    outerClass,
  )}
>
  <div class="overflow-x-auto scrollbar-thin">
    <Tag class={twMerge("w-full border-collapse text-left text-p3", className)} {...props}>
      <slot />
    </Tag>
  </div>
</div>
