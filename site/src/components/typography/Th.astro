---
import type { HTMLTag, Polymorphic } from 'astro/types';
import { twMerge } from '@/utils/twMerge';

type Props<Tag extends HTMLTag = 'th'> = Polymorphic<{ as: Tag }> & {
  class?: string;
};

const { as: Tag = 'th', class: className, ...props } = Astro.props;
---

<Tag
  class={twMerge(
    "px-3 py-2.5 text-left font-display-compact text-p4 font-semibold text-muted uppercase sm:px-4 sm:font-display",
    className,
  )}
  {...props}
>
  <slot />
</Tag>
