---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  variant?: 'extra-short' | 'short' | 'normal';
  /** Pin to the bottom of the viewport so the blocks only appear when the page overscrolls. */
  fixed?: boolean;
  class?: string;
}
const { variant = 'normal', fixed = false, class: className, ...rest } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={[
    "grid",
    fixed ? "fixed inset-x-0 bottom-0" : "relative",
    variant === "extra-short" ? "h-20" : variant === "short" ? "h-25" : "h-52",
    className,
  ]}
  style="grid-template-rows: 80fr 60fr 45fr 20fr 10fr"
  {...rest}
>
  <div class="bg-bright-yellow dark:bg-gold"></div>
  <div class="bg-gold dark:bg-orange"></div>
  <div class="bg-orange dark:bg-red"></div>
  <div class="bg-red dark:bg-magenta"></div>
  <div class="bg-magenta dark:bg-magenta-dark"></div>
</div>
