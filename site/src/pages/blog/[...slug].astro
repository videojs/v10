---

import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntries, render } from 'astro:content';
import ChevronLeftSquare from '@/assets/icons/chevron-left-square.svg?react';
import FormattedDate from '@/components/FormattedDate.astro';
import JsonLd from '@/components/JsonLd.astro';
import defaultMarkdownComponents from '@/components/typography/defaultMarkdownComponents';
import { FIRST_V10_BLOG_MONTH, PRODUCTION_URL } from '@/consts';
import Blog from '@/layouts/Blog.astro';
import MarkdownAlternate from '@/components/MarkdownAlternate.astro';
import { createBlogPostingSchema } from '@/utils/jsonLd/schemas';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts
    .filter((post) => !post.data.devOnly || import.meta.env.DEV)
    .map((post) => ({
      params: { slug: post.id },
      props: post,
    }));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const authors = await getEntries(post.data.authors);
const publishedDate = post.data.pubDate.toISOString().slice(0, 10);
// Posts are read one at a time by agents, so a pre-v10 post says so itself rather than relying on the blog index.
const isLegacyPost = publishedDate < FIRST_V10_BLOG_MONTH;

// Resolve OG image URL for JSON-LD
const ogImageUrl = post.data.ogImage
  ? typeof post.data.ogImage === 'string'
    ? post.data.ogImage
    : new URL(post.data.ogImage.src, Astro.url).toString()
  : undefined;

// Build JSON-LD schema for BlogPosting
const pageUrl = new URL(Astro.url.pathname, PRODUCTION_URL).toString();
const jsonLdSchema = createBlogPostingSchema({
  title: post.data.title,
  description: post.data.description,
  url: pageUrl,
  pubDate: post.data.pubDate,
  updatedDate: post.data.updatedDate,
  readingTime: remarkPluginFrontmatter.readingTimeMinutes,
  authors,
  siteUrl: PRODUCTION_URL.toString(),
  image: ogImageUrl,
});
---

<Blog
  title={[post.data.title, "Blog"]}
  description={post.data.description}
  canonical={post.data.canonical}
  image={post.data.ogImage}
  twitterImage={post.data.twitterImage}
>
  <MarkdownAlternate slot="head" />
  <JsonLd slot="head" schema={jsonLdSchema} />
  <article
    class="@container text-p2 sm:text-p15"
    data-search-content
    data-llms-content
    data-llms-description={post.data.description}
    data-llms-sort={post.data.pubDate.toISOString()}
    data-site="blog"
  >
    <header
      class="relative mx-auto mb-10 max-w-3xl border-y border-faded-black py-10 dark:border-manila-light"
    >
      <div
        class="mb-2 flex flex-col items-start gap-1 font-display text-h4 font-bold text-accent uppercase sm:flex-row sm:items-baseline sm:gap-0"
        data-llms-ignore
      >
        <a href="/blog" class="group relative inline-block whitespace-nowrap pr-5 intent:underline sm:pr-0 sm:pl-5">
          <ChevronLeftSquare className="absolute top-1/2 right-0 size-3.5 -translate-y-1/2 rotate-180 sm:right-auto sm:left-0 sm:rotate-0" aria-hidden="true" />
          Blog
        </a>
        <span class="flex items-baseline">
          <span class="whitespace-nowrap">
            <span class="mx-3 hidden sm:inline" aria-hidden="true">&bull;</span>
            <FormattedDate date={post.data.pubDate} />
          </span>
          <span class="whitespace-nowrap" data-search-ignore data-llms-ignore>
            <span class="mx-1.5 max-[340px]:mx-1 sm:mx-3" aria-hidden="true">&bull;</span>
            {remarkPluginFrontmatter.minutesRead}
          </span>
        </span>
      </div>
      <h1
        class="mb-3 font-display text-h2 leading-tight uppercase text-balance sm:text-h15"
      >
        {post.data.title}
      </h1>
      <div hidden data-llms-only>
        <p>
          Published {publishedDate}.{isLegacyPost &&
            " This post describes an earlier Video.js version (1 through 8); its APIs do not apply to Video.js 10."}
        </p>
      </div>
      <div class="">
        By {
          new Intl.ListFormat("en", { style: "long", type: "conjunction" })
            .formatToParts(authors.map((author) => author.data.name))
            .map((part) =>
              part.type === "element" ? (
                // inline-block removes the whitespace that the Astro formatter adds around the text
                <a
                  href={`/blog/authors/${authors.find((a) => a.data.name === part.value)?.id}`}
                  class="inline-block intent:underline"
                >
                  {part.value}
                </a>
              ) : (
                <span>{part.value}</span>
              ),
            )
        }
      </div>
    </header>
    <Content components={{ ...defaultMarkdownComponents }} />
  </article>
</Blog>
