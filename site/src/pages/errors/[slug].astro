---
import { LEGACY_V8_DOCS_URL, LEGACY_V8_INSTALL } from 'video.js/errors';

import ServerCode from '@/components/Code/ServerCode.astro';
import A from '@/components/typography/A.astro';
import CodeFrame from '@/components/typography/CodeFrame.astro';
import H2 from '@/components/typography/H2.astro';
import H3 from '@/components/typography/H3.astro';
import P from '@/components/typography/P.astro';
import { PRODUCTION_URL } from '@/consts';
import Blog from '@/layouts/Blog.astro';
import { renderInlineMarkdown } from '@/utils/docs/renderInlineMarkdown';
import { buildDocsUrl } from '@/utils/docs/routing';
import { ERRORS_BASE_PATH, getLegacyErrorPages, type LegacyErrorPage } from '@/utils/errors/legacy-errors';

export function getStaticPaths() {
  return getLegacyErrorPages().map((page) => ({
    params: { slug: page.slug },
    props: page,
  }));
}

type Props = LegacyErrorPage;

const page = Astro.props;

const MIGRATION_GUIDE_SLUG = 'how-to/migrate-from-video-js-8';
const description = `${page.code}: ${page.summary.replaceAll('`', '')}`;
const v8DocsHost = new URL(LEGACY_V8_DOCS_URL).host;
---

<Blog
  title={[page.code, 'Error codes']}
  description={description}
  canonical={new URL(page.path, PRODUCTION_URL).href}
>
  <article
    class="@container text-p2 sm:text-p15"
    data-search-content
    data-llms-content
    data-llms-description={description}
    data-site="errors"
  >
    <header
      class="relative mx-auto mb-10 max-w-3xl border-y border-faded-black py-10 dark:border-manila-light"
    >
      <div
        class="mb-3 flex flex-col gap-2 font-display text-h4 font-bold text-orange uppercase sm:flex-row sm:gap-4"
      >
        <a href={ERRORS_BASE_PATH} class="underline intent:decoration-gold">Error codes</a>
        <span class="hidden sm:inline">&bull;</span>
        <span>Video.js 8 pattern</span>
      </div>
      <h1 class="mb-2 font-display text-h2 leading-tight break-words uppercase sm:text-h15">
        {page.code}
      </h1>
      <p set:html={renderInlineMarkdown(page.summary)} />
    </header>

    <H2>What triggers it</H2>
    <div class="mx-auto max-w-3xl">
      <CodeFrame lang="js">
        <ServerCode code={page.legacy} lang="javascript" />
      </CodeFrame>
    </div>

    <H2>What to do instead</H2>
    <H3>HTML</H3>
    <P set:html={renderInlineMarkdown(page.html)} />
    <P>
      The <A href={buildDocsUrl('html', MIGRATION_GUIDE_SLUG)}>Migrate from Video.js 8</A> guide covers the rest of the HTML setup.
    </P>
    <H3>React</H3>
    <P set:html={renderInlineMarkdown(page.react)} />
    <P>
      The <A href={buildDocsUrl('react', MIGRATION_GUIDE_SLUG)}>Migrate from Video.js 8</A> guide covers the rest of the React setup.
    </P>

    <H2>Or stay on Video.js 8</H2>
    <P>
      Staying on Video.js 8 is fine. It keeps receiving security patches, and its docs live at <A href={LEGACY_V8_DOCS_URL}>{v8DocsHost}</A>. Pin the major version to keep it:
    </P>
    <div class="mx-auto max-w-3xl">
      <CodeFrame lang="bash">
        <ServerCode code={LEGACY_V8_INSTALL} lang="bash" />
      </CodeFrame>
    </div>
  </article>
</Blog>
