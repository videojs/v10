---

import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import ArrowUpRight from '@/assets/icons/arrow-up-right.svg?react';
import ChevronLeftSquare from '@/assets/icons/chevron-left-square.svg?react';
import FormattedDate from '@/components/FormattedDate.astro';
import defaultMarkdownComponents from '@/components/typography/defaultMarkdownComponents';
import Blog from '@/layouts/Blog.astro';
import MarkdownAlternate from '@/components/MarkdownAlternate.astro';

export async function getStaticPaths() {
  const entries = await getCollection('changelog');

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: entry,
  }));
}
type Props = CollectionEntry<'changelog'>;

const entry = Astro.props;
const { Content } = await render(entry);

const title = `v${entry.data.version}`;
const description =
  entry.data.description || `What's new in Video.js ${title} — new features, bug fixes, and improvements.`;
---

<Blog title={[title, "Changelog"]} description={description}>
  <MarkdownAlternate slot="head" />
  <article
    class="@container text-p2 sm:text-p15"
    data-search-content
    data-llms-content
    data-llms-description={description}
    data-llms-sort={entry.data.date.toISOString()}
    data-site="changelog"
  >
    <header
      class="relative mx-auto mb-10 max-w-3xl border-y border-faded-black py-10 dark:border-manila-light"
    >
      <div
        class="mb-2 flex flex-col items-start gap-1 font-display text-h4 font-bold text-accent uppercase sm:flex-row sm:items-baseline sm:gap-0"
        data-llms-ignore
      >
        <a href="/changelog" class="group relative inline-block whitespace-nowrap pr-5 intent:underline sm:pr-0 sm:pl-5">
          <ChevronLeftSquare className="absolute top-1/2 right-0 size-3.5 -translate-y-1/2 rotate-180 sm:right-auto sm:left-0 sm:rotate-0" aria-hidden="true" />
          Changelog
        </a>
        <span class="flex items-baseline">
          <span class="whitespace-nowrap">
            <span class="mx-3 hidden sm:inline" aria-hidden="true">&bull;</span>
            <FormattedDate date={entry.data.date} />
          </span>
          {
            entry.data.breaking && (
              <span class="whitespace-nowrap">
                <span class="mx-1.5 max-[340px]:mx-1 sm:mx-3" aria-hidden="true">&bull;</span>
                Breaking
              </span>
            )
          }
        </span>
      </div>
      <h1 class="mb-2 font-display text-h2 leading-tight uppercase sm:text-h15">
        {title}
      </h1>
      <div hidden data-llms-only>
        <p>
          Released {entry.data.date.toISOString().slice(0, 10)}.{entry.data.breaking && " Contains breaking changes."}
        </p>
      </div>
      <a
        href={entry.data.compareUrl}
        class="inline-flex items-center gap-1 underline intent:decoration-gold"
        target="_blank"
        rel="noopener noreferrer"
      >
        Compare changes on GitHub <ArrowUpRight className="size-4" aria-hidden="true" />
      </a>
    </header>
    <Content components={{ ...defaultMarkdownComponents }} />
  </article>
</Blog>
