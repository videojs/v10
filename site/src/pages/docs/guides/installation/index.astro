---
export const prerender = false;

import { DEFAULT_FRAMEWORK } from '@/types/docs';
import { getPreferencesServer } from '@/utils/docs/preferences';
import { getInstallationRoutePath } from '@/utils/installation/routes';

const { framework } = getPreferencesServer(Astro.cookies);
const target = framework ?? DEFAULT_FRAMEWORK;

return Astro.redirect(getInstallationRoutePath(target), 307);
---
