---
import { getCollection } from 'astro:content';
import DocsPage from '@/components/docs/DocsPage.astro';
import type { SupportedFramework } from '@/types/docs';
import { SUPPORTED_FRAMEWORKS } from '@/types/docs';
import { CANONICAL_INSTALLATION_SLUGS } from '@/utils/docs/routing';
import { filterSidebar, getAllGuideSlugs } from '@/utils/docs/sidebar';

export async function getStaticPaths() {
  const docsCollection = await getCollection('docs');

  /**
   * Build a map of allowed slugs for each framework.
   * Only docs that appear in the filtered sidebar will be allowed to generate pages.
   */
  type AllowedSlugsMap = Map<SupportedFramework, Set<string>>;
  const allowedSlugsMap: AllowedSlugsMap = new Map();

  for (const framework of SUPPORTED_FRAMEWORKS) {
    const sidebarForFramework = filterSidebar(framework);
    const slugsForFramework = getAllGuideSlugs(sidebarForFramework);

    allowedSlugsMap.set(framework, new Set(slugsForFramework));
  }

  // Generate a path for each doc that's visible for each framework
  const staticPaths = SUPPORTED_FRAMEWORKS.flatMap((framework) => {
    const allowedSlugs = allowedSlugsMap.get(framework)!;

    // Filter docs to only those visible in this framework's sidebar
    return docsCollection
      .filter((doc) => allowedSlugs.has(doc.id) && !CANONICAL_INSTALLATION_SLUGS.has(doc.id))
      .map((doc) => ({
        params: {
          framework,
          slug: doc.id,
        },
        props: { doc },
      }));
  });

  return staticPaths;
}

const { framework, slug } = Astro.params;
const { doc } = Astro.props;
---

<DocsPage doc={doc} framework={framework as SupportedFramework} slug={slug} />
