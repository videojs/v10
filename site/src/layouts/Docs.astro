---

import { ClientRouter } from 'astro:transitions';
import { type CollectionEntry, getCollection } from 'astro:content';
import DocsSidebar from '@/components/docs/DocsSidebar.astro';
import DocsSidebarRestoration from '@/components/docs/DocsSidebarRestoration.astro';
import { Selectors } from '@/components/docs/Selectors';
import StyleInit from '@/components/docs/StyleInit.astro';
import Footer from '@/components/FooterDocs.astro';
import MarkdownAlternate from '@/components/MarkdownAlternate.astro';
import NavBarDocs from '@/components/NavBar/NavBarDocs.astro';
import { FRAMEWORK_LABELS, type SupportedFramework } from '@/types/docs';
import { getDocTitle } from '@/utils/docs/title';
import Base from './Base.astro';

type Props = {
  doc: CollectionEntry<'docs'>;
  framework: SupportedFramework;
  slug: string;
};

const { doc, framework, slug } = Astro.props;

// Fetch all docs to get their framework-specific titles
const allDocs = await getCollection('docs');
const docTitles = new Map(allDocs.map((d) => [d.id, getDocTitle(d, framework)]));
const docStabilities = new Map(allDocs.map((d) => [d.id, d.data.stability]));

const seoCategory = `${FRAMEWORK_LABELS[framework]} Video Player`;
const docsSidebarId = 'docs-sidebar';
---

<Base
  title={getDocTitle(doc, framework)}
  suffix={`Open Source ${FRAMEWORK_LABELS[framework]} Video Player`}
  description={`${doc.data.description} — Video.js ${seoCategory}.`}
  easterEgg="thin"
  easterEggClass="md:left-70 lg:left-75"
>
  <Fragment slot="priority-head">
    <StyleInit />
    <ClientRouter />
  </Fragment>
  <Fragment slot="head">
    <DocsSidebarRestoration />
    <MarkdownAlternate />
    <slot name="head" slot="head" />
  </Fragment>
  <NavBarDocs slot="sticky-header">
    <DocsSidebar
      slot="mobile-nav"
      framework={framework}
      docTitles={docTitles}
      docStabilities={docStabilities}
    >
      <Selectors client:idle currentFramework={framework} currentSlug={slug} />
    </DocsSidebar>
  </NavBarDocs>
  <div
    class:list={[
      "grid grid-cols-1",
      "md:grid-cols-(--md-grid-cols) lg:grid-cols-(--lg-grid-cols)",
      "[--nav-h:calc(var(--spacing)*13+1px)] sm:[--nav-h:calc(var(--spacing)*13.5+1px)]",
    ]}
    style={{
      "--md-grid-cols": `calc(var(--spacing) * 70) minmax(0,1fr)`,
      "--lg-grid-cols": `calc(var(--spacing) * 75) minmax(0,1fr)`,
      "min-height": "calc(100cqh - var(--nav-h))",
    }}
  >
    <aside
      id={docsSidebarId}
      class="scrollbar-thin sticky z-10 hidden flex-col overflow-y-scroll border-line md:flex md:border-r"
      style="top: var(--nav-h); max-height: calc(100cqh - var(--nav-h));"
    >
      <DocsSidebar
        framework={framework}
        docTitles={docTitles}
        docStabilities={docStabilities}
        class="flex-1"
        animateIndicator
      >
        <Selectors
          client:idle
          currentFramework={framework}
          currentSlug={slug}
        />
      </DocsSidebar>
    </aside>
    <div>
      <div class="flex flex-col" style="min-height:calc(100cqh - var(--nav-h));">
        <slot />
      </div>
      <Footer class="mt-auto" />
    </div>
  </div>
</Base>
