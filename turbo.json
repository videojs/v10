{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "concurrency": "20",
  "globalEnv": ["BRANCH", "CONTEXT", "DEPLOY_PRIME_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^build:cdn", "generate"],
      "outputs": ["dist/**", "types/**", "*.tsbuildinfo", ".netlify/**"]
    },
    "build:cdn": {
      "dependsOn": ["build"],
      "outputs": ["cdn/**"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true,
      "interactive": false
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "generate": {
      "outputs": ["src/core/ui/schema.generated.ts", "vjsc/*.generated.ts"]
    },
    "lint": {
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
