{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "allowImportingTsExtensions": true,
    "isolatedDeclarations": false,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["shared/**/*.ts", "suites/**/*.ts", "suites/**/*.tsx", "scripts/**/*.ts"],
  "exclude": [
    "suites/registry/.generated/**",
    "suites/registry/overlays/**",
    "suites/player/app/src/_generated/**",
    "suites/player/app/src/pages/**",
    "**/node_modules/**"
  ]
}
