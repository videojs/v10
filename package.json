{
  "name": "video.js",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "description": "Video.js 10 Monorepo",
  "author": "Video.js Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/v10.git"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.9.3"
  },
  "scripts": {
    "prepare": "vp config --no-agent",
    "postinstall": "node build/scripts/link-aliases.mjs",
    "build:packages": "vp run --filter='./packages/*' --filter='!@videojs/cli' build",
    "build:cli": "vp run --filter='@videojs/cli...' build",
    "build:sandbox": "vp run --filter='@videojs/sandbox...' build",
    "build:cdn": "vp run @videojs/html#build:cdn",
    "build:site": "vp run site#build",
    "build": "vp run -r build",
    "clean": "vp run -r --no-cache clean",
    "commitlint": "commitlint --config ./commitlint.config.js --edit",
    "dev:site": "vp run site#dev",
    "dev": "vp run -r --parallel --no-cache dev",
    "dev:packages": "vp run --filter='./packages/*' --parallel --no-cache dev",
    "dev:sandbox": "vp run --filter='@videojs/sandbox^...' build && vp run --no-cache @videojs/sandbox#dev",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "lint:fix:file": "vp check --fix --no-error-on-unmatched-pattern",
    "link:aliases": "node build/scripts/link-aliases.mjs",
    "size": "node .github/scripts/bundle-size.js | node .github/scripts/bundle-size-report.js",
    "test": "vp run --filter='./packages/*' --filter='!@videojs/cli' build && pnpm --recursive --filter='./packages/*' --filter='!@videojs/cli' test",
    "test:cli": "vp run @videojs/cli#test",
    "test:e2e": "pnpm --dir apps/e2e test:all",
    "test:e2e:vite": "pnpm --dir apps/e2e test:vite",
    "test:e2e:sandbox": "pnpm --dir apps/e2e test:sandbox",
    "test:e2e:update": "pnpm --dir apps/e2e test:update",
    "test:e2e:install": "pnpm --dir apps/e2e run install:browsers && pnpm --dir apps/e2e run install:deps",
    "test:size": "node --test .github/scripts/tests/*.test.js",
    "format": "vp fmt --write",
    "format:astro": "vp fmt 'site/src/**/*.astro' --write",
    "generate:skins": "pnpm -F @videojs/skins generate:skins",
    "check:skins": "pnpm -F @videojs/skins check:skins",
    "typecheck": "tsgo --build",
    "changelog": "git-cliff --config cliff.toml --output CHANGELOG.md",
    "check:workspace": "node build/scripts/check-workspace.mjs"
  },
  "devDependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/format": "^20.0.0",
    "@types/node": "^22.18.6",
    "esbuild": "^0.28.1",
    "git-cliff": "^2.12.0",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.32.0",
    "magic-string": "^0.30.21",
    "react": "^18.3.1",
    "rimraf": "^6.1.3",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.1",
    "@typescript/native-preview": "beta",
    "vite-plus": "catalog:"
  }
}
