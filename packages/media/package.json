{
  "name": "@videojs/media",
  "version": "10.0.0-beta.32",
  "description": "Media contracts, hosts, and playback engines for Video.js",
  "keywords": [
    "media",
    "player",
    "streaming",
    "videojs"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/v10",
    "directory": "packages/media"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/default/index.js",
  "module": "dist/default/index.js",
  "types": "dist/dev/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/default/index.js"
    },
    "./dom": {
      "types": "./dist/dev/dom.d.ts",
      "development": "./dist/dev/dom.js",
      "default": "./dist/default/dom.js"
    },
    "./dom/dash": {
      "types": "./dist/dev/dom/dash/index.d.ts",
      "browser": {
        "development": "./dist/dev/dom/dash/index.js",
        "default": "./dist/default/dom/dash/index.js"
      },
      "default": "./dist/default/dom/dash/server.js"
    },
    "./dom/*": {
      "types": "./dist/dev/dom/*/index.d.ts",
      "development": "./dist/dev/dom/*/index.js",
      "default": "./dist/default/dom/*/index.js"
    },
    "./media-tracks": {
      "types": "./dist/dev/media-tracks.d.ts",
      "development": "./dist/dev/media-tracks.js",
      "default": "./dist/default/media-tracks.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:watch": "vp pack --watch ./src --no-clean",
    "dev": "pnpm run build:watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "clean": "rimraf --glob dist types '*.tsbuildinfo'"
  },
  "dependencies": {
    "@videojs/utils": "workspace:*",
    "@vimeo/player": "^2.30.3",
    "dashjs": "^5.2.0",
    "hls.js": "^1.6.7",
    "mux-embed": "^5.17.10",
    "shaka-player": "^5.2.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.40",
    "@types/chromecast-caf-sender": "^1.0.11",
    "jsdom": "^26.1.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
