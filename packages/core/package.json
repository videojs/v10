{
  "name": "@videojs/core",
  "type": "module",
  "version": "10.0.0-beta.31",
  "description": "Core components and utilities for Video.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/v10",
    "directory": "packages/core"
  },
  "keywords": [
    "core",
    "player",
    "videojs"
  ],
  "sideEffects": [
    "./dist/*/i18n.js",
    "**/i18n/registry.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/default/index.js"
    },
    "./dom": {
      "types": "./dist/dev/dom.d.ts",
      "development": "./dist/dev/dom.js",
      "default": "./dist/default/dom.js"
    },
    "./vjsc": {
      "types": "./dist/dev/vjsc.d.ts",
      "development": "./dist/dev/vjsc.js",
      "default": "./dist/default/vjsc.js"
    },
    "./i18n": {
      "types": "./dist/dev/i18n.d.ts",
      "development": "./dist/dev/i18n.js",
      "default": "./dist/default/i18n.js"
    },
    "./i18n/locales/*": {
      "types": "./dist/dev/i18n/locales/*.d.ts",
      "development": "./dist/dev/i18n/locales/*.js",
      "default": "./dist/default/i18n/locales/*.js"
    },
    "./i18n/text/*": {
      "types": "./dist/dev/i18n/text/*.d.ts",
      "development": "./dist/dev/i18n/text/*.js",
      "default": "./dist/default/i18n/text/*.js"
    }
  },
  "main": "dist/default/index.js",
  "module": "dist/default/index.js",
  "types": "dist/dev/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:schema": "vjsc generate",
    "check:schema": "vjsc generate --check",
    "generate:locales": "node --import tsx ./scripts/generate-i18n-locales.ts",
    "generate:i18n-types": "node --import tsx ./scripts/generate-i18n-types.ts",
    "prebuild": "pnpm run generate:locales && pnpm run generate:i18n-types && pnpm run generate:schema",
    "build": "tsdown",
    "build:watch": "tsdown --watch ./src --no-clean",
    "dev": "pnpm run build:watch",
    "test": "pnpm run check:schema && pnpm run test:types && vitest run",
    "test:types": "tsgo --project ./src/core/ui/tests/tsconfig.json",
    "test:watch": "vitest",
    "clean": "rimraf --glob dist types '*.tsbuildinfo'"
  },
  "dependencies": {
    "@videojs/media": "workspace:*",
    "@videojs/store": "workspace:*",
    "@videojs/utils": "workspace:*"
  },
  "devDependencies": {
    "vjsc": "workspace:*",
    "jsdom": "^26.1.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/dev/index.d.ts",
        "development": "./dist/dev/index.js",
        "default": "./dist/default/index.js"
      },
      "./dom": {
        "types": "./dist/dev/dom.d.ts",
        "development": "./dist/dev/dom.js",
        "default": "./dist/default/dom.js"
      },
      "./i18n": {
        "types": "./dist/dev/i18n.d.ts",
        "development": "./dist/dev/i18n.js",
        "default": "./dist/default/i18n.js"
      },
      "./i18n/locales/*": {
        "types": "./dist/dev/i18n/locales/*.d.ts",
        "development": "./dist/dev/i18n/locales/*.js",
        "default": "./dist/default/i18n/locales/*.js"
      },
      "./i18n/text/*": {
        "types": "./dist/dev/i18n/text/*.d.ts",
        "development": "./dist/dev/i18n/text/*.js",
        "default": "./dist/default/i18n/text/*.js"
      }
    }
  }
}
