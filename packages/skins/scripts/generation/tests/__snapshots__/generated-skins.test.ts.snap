import { Hotkey as HotkeyPrimitive } from '@videojs/react';

export interface VideoHotkeysProps {
  disabled?: boolean | undefined;
}

export function VideoHotkeys({ disabled = false }: VideoHotkeysProps = {}) {
  return (
    <>
      <HotkeyPrimitive disabled={disabled} keys="Space" action="togglePaused" />
      <HotkeyPrimitive disabled={disabled} keys="k" action="togglePaused" />
      <HotkeyPrimitive disabled={disabled} keys="m" action="toggleMuted" />
      <HotkeyPrimitive disabled={disabled} keys="f" action="toggleFullscreen" />
      <HotkeyPrimitive disabled={disabled} keys="c" action="toggleSubtitles" />
      <HotkeyPrimitive disabled={disabled} keys="i" action="togglePictureInPicture" />
      <HotkeyPrimitive disabled={disabled} keys="ArrowRight" action="seekStep" value={5} />
      <HotkeyPrimitive disabled={disabled} keys="ArrowLeft" action="seekStep" value={-5} />
      <HotkeyPrimitive disabled={disabled} keys="l" action="seekStep" value={10} />
      <HotkeyPrimitive disabled={disabled} keys="j" action="seekStep" value={-10} />
      <HotkeyPrimitive disabled={disabled} keys="ArrowUp" action="volumeStep" value={0.05} />
      <HotkeyPrimitive disabled={disabled} keys="ArrowDown" action="volumeStep" value={-0.05} />
      <HotkeyPrimitive disabled={disabled} keys="0-9" action="seekToPercent" />
      <HotkeyPrimitive disabled={disabled} keys="Home" action="seekToPercent" value={0} />
      <HotkeyPrimitive disabled={disabled} keys="End" action="seekToPercent" value={100} />
      <HotkeyPrimitive disabled={disabled} keys=">" action="speedUp" />
      <HotkeyPrimitive disabled={disabled} keys="<" action="speedDown" />
    </>
  );
}

===== packages/skins/canonical/registry/default/components/video-settings-menu/audio-track-menu.tsx =====
import { audioText } from '@videojs/core/i18n/text/menu';
import { AudioTrackRadioGroup } from './radio-group';
import { RadioItem } from './radio-item';
import { Submenu, type SubmenuProps } from './submenu';
import { cn } from '@/components/videojs/utils';
import { useAudioTrackOptions, Text } from '@videojs/react';
import { SpeechIcon } from '@videojs/react/icons';

export interface AudioTrackMenuProps extends Omit<SubmenuProps, 'children' | 'icon' | 'label' | 'selectedLabel'> {}

export function AudioTrackMenu(props: AudioTrackMenuProps = {}) {
  const audioTrack = useAudioTrackOptions();
  const available = audioTrack?.state.availability === 'available';
  return (
    available && (
      <Submenu
        icon={
          <SpeechIcon
            className={cn(
              'size-media-icon shrink-0 opacity-70 group-hover/menu-item:opacity-100',
              'drop-shadow-[0_1px_0_rgb(0_0_0/0.15)]',
            )}
          />
        }
        label={<Text token={audioText.key}>{audioText.text}</Text>}
        selectedLabel={
          <span className="max-w-24 overflow-hidden text-ellipsis whitespace-nowrap" data-part="hint">
            {audioTrack?.selectedLabel}
          </span>
        }
        {...props}
      >
        <AudioTrackRadioGroup
          renderItem={(props, item) => (
            <RadioItem {...props}>
              <span>{item.label}</span>
            </RadioItem>
          )}
        />
      </Submenu>
    )
  );
}

