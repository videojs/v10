            'aria-disabled:cursor-not-allowed aria-disabled:opacity-50',
            'size-9',
            resolveClassName(className, state),
          )
        }
        seconds={seconds}
        {...props}
      >
        <SeekIcon
          className={cn(
            'size-media-icon',
            'drop-shadow-[0_1px_0_rgb(0_0_0/0.15)]',
            seconds < 0 ? '-scale-x-100' : undefined,
          )}
        />
        <span className="tabular-nums">{Math.abs(seconds)}</span>
      </SeekButtonPrimitive>
    </ButtonTooltip>
  );
}

