@layer videojs.components {
  @scope (.media-skin-video) {
    .media-back {
      margin-bottom: calc(var(--media-spacing) * 0.5);
      width: 100%;
    }

    .media-badge {
      border-radius: var(--media-control-radius);
      background-color: var(--media-accent-color, oklch(100% 0 0 / 0.1));
      padding-inline: calc(var(--media-spacing) * 1.5);
      font-size: 0.7em;
      font-weight: 600;
    }

    .media-chevron {
      width: calc(var(--media-spacing) * 3.5);
      height: calc(var(--media-spacing) * 3.5);
    }

    .media-chevron-flipped {
      rotate: 180deg;
    }

    .media-hint {
      min-width: calc(var(--media-spacing) * 0);
      align-items: center;
      gap: calc(var(--media-spacing) * 1);
      padding-left: calc(var(--media-spacing) * 2);
      opacity: 0.7;
      margin-left: auto;
      display: inline-flex;
    }

    .media-hint-label {
      max-width: calc(var(--media-spacing) * 24);
      text-overflow: ellipsis;
      white-space: nowrap;
      overflow: hidden;
    }

    .media-icon {
      width: var(--media-icon-size, calc(var(--media-spacing) * 4.5));
      height: var(--media-icon-size, calc(var(--media-spacing) * 4.5));
      opacity: 0.7;
      filter: drop-shadow(0 1px #00000026);
      flex-shrink: 0;
    }

    @media (hover: hover) {
      @scope (.media-menu-item) {
        &:hover .media-icon {
          opacity: 1;
        }
      }

      .media-menu-item:hover {
        background-color: var(--media-accent-color, oklch(100% 0 0 / 0.1));
        color: var(--media-accent-text-color, contrast-color(var(--media-accent-color, oklch(0% 0 0))));
      }
    }

    .media-indicator {
      margin-right: calc(var(--media-spacing) * -1);
      opacity: 0;
      flex-shrink: 0;
      margin-left: auto;
    }

    @scope (.media-menu-item) {
      &[aria-checked='true'] .media-indicator {
        opacity: 1;
      }
    }

    .media-item {
      color: inherit;
      font-variant-numeric: tabular-nums;
      justify-content: space-between;
    }

    .media-item[aria-disabled='true'] {
      pointer-events: none;
      cursor: not-allowed;
      opacity: 0.5;
    }

    .media-item[data-availability='unavailable'],
    .media-item[data-availability='unsupported'] {
      display: none;
    }

    .media-menu-group {
      gap: calc(var(--media-spacing) * 0.5);
      anchor-scope: --media-menu-item-highlight-anchor;
      flex-direction: column;
      display: flex;
      position: relative;
    }

    .media-menu-item {
      cursor: pointer;
      align-items: center;
      gap: calc(var(--media-spacing) * 1.5);
      border-radius: var(--media-surface-radius);
      padding-inline: calc(var(--media-spacing) * 2);
      padding-block: calc(var(--media-spacing) * 1.5);
      text-align: left;
      outline-offset: -2px;
      -webkit-user-select: none;
      user-select: none;
      outline: 2px solid #0000;
      transition-property: color, background-color;
      transition-duration: 0.1s;
      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      position: relative;
    }

    .media-menu-item:focus-visible {
      outline-offset: 2px;
      outline-color: currentColor;
    }

    .media-menu-item[data-highlighted] {
      background-color: var(--media-accent-color, oklch(100% 0 0 / 0.1));
      color: var(--media-accent-text-color, contrast-color(var(--media-accent-color, oklch(0% 0 0))));
    }

    @media (prefers-reduced-motion: reduce) {
