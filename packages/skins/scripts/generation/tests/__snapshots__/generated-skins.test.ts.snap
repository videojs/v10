import { Gesture as GesturePrimitive } from '@videojs/react';

export interface VideoGesturesProps {
  disabled?: boolean | undefined;
}

export function VideoGestures({ disabled = false }: VideoGesturesProps = {}) {
  return (
    <>
      <GesturePrimitive disabled={disabled} type="tap" action="togglePaused" pointer="mouse" region="center" />
      <GesturePrimitive disabled={disabled} type="tap" action="toggleControls" pointer="touch" />
      <GesturePrimitive disabled={disabled} type="doubletap" action="seekStep" value={-10} region="left" />
      <GesturePrimitive disabled={disabled} type="doubletap" action="toggleFullscreen" region="center" />
      <GesturePrimitive disabled={disabled} type="doubletap" action="seekStep" value={10} region="right" />
    </>
  );
}

