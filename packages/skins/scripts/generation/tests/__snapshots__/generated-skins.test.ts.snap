@layer videojs.components {
  @scope (.media-skin-video) {
    .media-error-dialog {
      z-index: 20;
      width: calc(100% - 1.5rem);
      max-width: calc(var(--media-spacing) * 72);
      gap: calc(var(--media-spacing) * 3);
      padding: calc(var(--media-spacing) * 3);
      color: #fff;
      backdrop-filter: blur(16px) saturate(150%);
      background-color: oklab(100% 0 5.96046e-8 / 0.1);
      border-radius: 1.75rem;
      outline-style: none;
      flex-direction: column;
      transition:
        opacity 0.35s cubic-bezier(0, 0, 0.2, 1) 0.1s,
        scale 0.35s cubic-bezier(0, 0, 0.2, 1) 0.1s,
        transform 0.35s cubic-bezier(0, 0, 0.2, 1) 0.1s;
      display: flex;
      position: absolute;
      top: 50%;
      left: 50%;
      translate: -50% -50%;
      box-shadow:
        0 0 #0000,
        0 0 #0000,
        0 0 #0000,
        0 0 0 1px oklab(0% none none / 0.1),
        0 1px 3px oklab(0% none none / 0.15),
        0 1px 2px -1px oklab(0% none none / 0.15);
