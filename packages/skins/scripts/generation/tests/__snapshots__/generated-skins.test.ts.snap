===== packages/react/src/__generated__/skins/minimal-video/styles/controls.css =====
@layer videojs.components {
  @scope (.media-skin-video-minimal) {
    .media-controls-end {
      flex: 1;
      justify-content: flex-end;
      align-items: center;
      gap: 1px;
      display: flex;
    }

    @container media-root (width >= 42rem) {
      .media-controls-end {
        flex: none;
      }

      .media-controls-root {
        inset-inline: calc(var(--media-spacing) * 2);
        bottom: calc(var(--media-spacing) * 2);
        --media-popover-side-offset: calc(var(--media-spacing) * 3);
        flex-wrap: nowrap;
      }

      .media-controls-start {
        flex: none;
      }

      .media-time-controls {
        min-width: calc(var(--media-spacing) * 0);
        flex: 1;
        order: 0;
        flex-basis: calc(var(--media-spacing) * 0);
        flex-direction: row;
        transition: mask-position 50ms ease-out;
        mask-position: 100% 0;
        mask-size: 200% 100%;
      }

      @scope (.media-controls-root) {
        &:has([data-volume-level][aria-expanded='true']) .media-time-controls {
          mask-image: linear-gradient(to right, #0000 10%, #000 25% 100%);
          mask-position: 0 0;
        }
      }

      .media-time-current,
      .media-time-separator {
        display: inline;
      }
    }

    .media-controls-remote {
      align-items: center;
      gap: 1px;
      display: none;
    }

    @container media-root (width >= 32rem) {
      .media-controls-remote {
        display: flex;
      }
    }

    .media-controls-root {
      inset-inline: calc(var(--media-spacing) * 1);
      bottom: calc(var(--media-spacing) * 1);
      z-index: 20;
      align-items: center;
      column-gap: calc(var(--media-spacing) * 2);
      padding: calc(var(--media-spacing) * 1);
      color: #fff;
      transition-property: filter, opacity, translate;
      transition-duration: calc(var(--media-controls-transition-duration) / 2);
      --media-popover-boundary-offset: calc(var(--media-spacing) * 1);
      --media-popover-side-offset: calc(var(--media-spacing) * 5);
      --media-tooltip-boundary-offset: var(--media-popover-boundary-offset);
      --media-tooltip-side-offset: var(--media-popover-side-offset);
      background-color: #0000;
      border-radius: 0.75rem;
      flex-wrap: wrap;
      transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
      display: flex;
      position: absolute;
    }

    .media-controls-root:not([data-visible]) {
      pointer-events: none;
      opacity: 0;
      transition-duration: var(--media-controls-transition-duration);
    }

    .media-controls-root:is(:where(.media-error-dialog)[data-open] ~ *) {
      display: none !important;
    }

    @media (prefers-reduced-motion: no-preference) {
      .media-controls-root:not([data-visible]) {
        translate: 0 100%;
      }
    }

    @media (prefers-contrast: more) {
      .media-controls-root {
        background-color: #000;
      }
    }

    @media (forced-colors: active) {
      .media-controls-root {
        background-color: canvas;
      }
    }

    @media (pointer: fine) {
      @media (prefers-reduced-motion: no-preference) {
        .media-controls-root:not([data-visible]) {
          filter: blur(8px);
        }
      }
    }

    @media (prefers-reduced-transparency: reduce) {
      .media-controls-root {
        background-color: #000;
      }
    }

    .media-controls-start {
      flex: 1;
      align-items: center;
      gap: 1px;
      display: flex;
    }

    .media-time-controls {
      align-items: center;
      gap: calc(var(--media-spacing) * 3);
      padding-inline: calc(var(--media-spacing) * 1.5);
      flex-direction: row-reverse;
      flex-basis: 100%;
      order: -9999;
      display: flex;
      container: media-time-controls / inline-size;
    }

    .media-time-current {
      cursor: pointer;
      font-variant-numeric: tabular-nums;
      outline-offset: -2px;
      border-radius: 0.25rem;
      outline: 2px solid #0000;
      display: none;
    }

    .media-time-current:focus-visible {
      outline-offset: 2px;
      outline-color: currentColor;
    }

    .media-time-duration {
      color: currentColor;
      font-variant-numeric: tabular-nums;
    }

    @supports (color: color-mix(in lab, red, red)) {
      .media-time-duration,
