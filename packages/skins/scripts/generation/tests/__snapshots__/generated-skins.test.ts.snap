    .media-overlay:is(:where(.media-buffering-indicator)[data-visible] ~ *) {
      opacity: 1;
      backdrop-filter: blur(4px);
      background-color: oklab(0% none none / 0.35);
    }

    .media-overlay:is(:where(.media-controls-root)[data-visible] ~ *) {
      opacity: 1;
    }
  }
