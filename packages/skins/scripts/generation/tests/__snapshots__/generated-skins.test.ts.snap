import { settingsText } from '@videojs/core/i18n/text/menu';
import { Text } from '@/i18n';
import { GearIcon } from '@/icons';
import { Menu as MenuPrimitive } from '@/ui/menu';
import { Tooltip as TooltipPrimitive } from '@/ui/tooltip';
import { cn, resolveClassName } from '@videojs/utils/style';
import { type ReactNode } from 'react';

export interface SettingsMenuProps extends MenuPrimitive.RootProps {
  children?: ReactNode;
  className?: MenuPrimitive.ContentProps['className'];
}

export function SettingsMenu({ children, className, ...props }: SettingsMenuProps) {
  return (
    <MenuPrimitive.Root side="top" align="center" {...props}>
      <TooltipPrimitive.Root side="top">
        <TooltipPrimitive.Trigger
          render={
            <MenuPrimitive.Trigger className="media-button media-settings-trigger">
              <GearIcon className="media-button-icon media-settings-icon" />
              <Text className="media-sr-only" token={settingsText.key}>
                {settingsText.text}
              </Text>
            </MenuPrimitive.Trigger>
          }
        />
        <TooltipPrimitive.Popup className="media-surface media-tooltip">
          <Text token={settingsText.key}>{settingsText.text}</Text>
        </TooltipPrimitive.Popup>
      </TooltipPrimitive.Root>
      <MenuPrimitive.Content
        className={(state) =>
          cn('media-surface', 'media-popover', 'media-settings', 'media-menu-group', resolveClassName(className, state))
        }
      >
        <MenuPrimitive.Group className="media-menu-group">{children}</MenuPrimitive.Group>
      </MenuPrimitive.Content>
    </MenuPrimitive.Root>
  );
}

===== packages/react/src/__generated__/skins/default-video/components/menus/submenu.tsx =====
import { MenuChevron } from './menu-chevron';
import { Menu as MenuPrimitive } from '@/ui/menu';
import { cn, resolveClassName } from '@videojs/utils/style';
import { type ReactNode } from 'react';

export interface SubmenuProps extends MenuPrimitive.RootProps {
  icon: ReactNode;
  label: ReactNode;
  selectedLabel: ReactNode;
  children?: ReactNode;
  className?: MenuPrimitive.ContentProps['className'];
}

export function Submenu({ children, icon, label, selectedLabel, className, ...props }: SubmenuProps) {
  return (
    <MenuPrimitive.Root {...props}>
      <MenuPrimitive.Trigger className="media-menu-item media-item">
        {icon}
        {label}
        <span className="media-hint">
          {selectedLabel}
          <MenuChevron />
        </span>
      </MenuPrimitive.Trigger>
      <MenuPrimitive.Content className={(state) => cn('media-submenu-panel', resolveClassName(className, state))}>
        <MenuPrimitive.Item className="media-menu-item media-back">
          <MenuChevron flipped />
          {label}
        </MenuPrimitive.Item>
        <MenuPrimitive.Separator className="media-separator" />
        {children}
      </MenuPrimitive.Content>
    </MenuPrimitive.Root>
  );
}

===== packages/react/src/__generated__/skins/default-video/components/menus/video-settings-menu.tsx =====
import { AudioTrackMenu } from './audio-track-menu';
import { CaptionsMenu } from './captions-menu';
import { PlaybackRateMenu } from './playback-rate-menu';
import { QualityMenu } from './quality-menu';
import { SettingsMenu, type SettingsMenuProps } from './settings-menu';
import { useQualityOptions } from '@/ui/quality/use-quality-options';
import { useAudioTrackOptions } from '@/ui/audio-track/use-audio-track-options';
import { usePlaybackRateOptions } from '@/ui/playback-rate/use-playback-rate-options';
import { useCaptionsOptions } from '@/ui/captions-radio-group/use-captions-options';

export interface VideoSettingsMenuProps extends Omit<SettingsMenuProps, 'children'> {}

export function VideoSettingsMenu(props: VideoSettingsMenuProps = {}) {
  const quality = useQualityOptions();
  const audioTrack = useAudioTrackOptions();
  const playbackRate = usePlaybackRateOptions();
  const captions = useCaptionsOptions();
  const hasSettings =
    quality?.state.availability === 'available' ||
    audioTrack?.state.availability === 'available' ||
    playbackRate?.state.availability === 'available' ||
    captions?.state.availability === 'available';
  return (
    hasSettings && (
      <SettingsMenu {...props}>
        <QualityMenu />
        <AudioTrackMenu />
        <PlaybackRateMenu />
        <CaptionsMenu />
      </SettingsMenu>
    )
  );
}

