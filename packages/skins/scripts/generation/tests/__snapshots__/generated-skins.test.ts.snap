@layer videojs.components {
  @scope (.media-skin-video-minimal) {
    .media-error-dialog {
      pointer-events: none;
      inset: calc(var(--media-spacing) * 0);
      z-index: 20;
      justify-content: center;
      align-items: center;
      gap: calc(var(--media-spacing) * 3);
      width: 100%;
      height: 100%;
      padding: calc(var(--media-spacing) * 4);
      color: #fff;
      outline-style: none;
      flex-direction: column;
      transition:
        opacity 0.15s cubic-bezier(0, 0, 0.2, 1) 0.1s,
        scale 0.15s cubic-bezier(0, 0, 0.2, 1) 0.1s,
        transform 0.15s cubic-bezier(0, 0, 0.2, 1) 0.1s;
      display: flex;
      position: absolute;
    }

    .media-error-dialog:not([data-open]) {
      display: none;
    }

    .media-error-dialog[data-ending-style] {
      opacity: 0;
      transition-delay: 0s;
      scale: 0.5;
    }

    .media-error-dialog[data-starting-style] {
      opacity: 0;
      scale: 0.5;
    }

    @media (prefers-reduced-motion: reduce) {
      .media-error-dialog {
        transition-duration: 50ms;
        transition-delay: 0s;
      }
    }

    .media-error-dialog > * {
      pointer-events: auto;
    }

    .media-error-dialog-close {
      height: calc(var(--media-spacing) * 9);
      width: 100%;
      max-width: calc(var(--media-spacing) * 64);
      background-color: var(--media-accent-color, oklch(100% 0 0));
      padding-inline: calc(var(--media-spacing) * 4);
      color: var(--media-accent-text-color, contrast-color(var(--media-accent-color, oklch(0% 0 0))));
      font-weight: 500;
    }

    .media-error-dialog-description {
      width: 100%;
      max-width: calc(var(--media-spacing) * 64);
      padding-bottom: calc(var(--media-spacing) * 1.5);
      overflow-wrap: anywhere;
      opacity: 0.7;
    }

    .media-error-dialog-title {
      width: 100%;
      max-width: calc(var(--media-spacing) * 64);
      padding-top: calc(var(--media-spacing) * 1.5);
      color: calc(var(--media-spacing) * 3.75);
      font-weight: 600;
      line-height: 1.25;
    }
  }
}

