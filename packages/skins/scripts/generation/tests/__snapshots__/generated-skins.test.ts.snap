===== packages/react/src/__generated__/skins/default-video/components/menus/audio-track-menu.tsx =====
import { audioText } from '@videojs/core/i18n/text/menu';
import { AudioTrackRadioGroup } from './radio-group';
import { RadioItem } from './radio-item';
import { Submenu, type SubmenuProps } from './submenu';
import { useAudioTrackOptions } from '@/ui/audio-track/use-audio-track-options';
import { Text } from '@/i18n';
import { SpeechIcon } from '@/icons';

export interface AudioTrackMenuProps extends Omit<SubmenuProps, 'children' | 'icon' | 'label' | 'selectedLabel'> {}

export function AudioTrackMenu(props: AudioTrackMenuProps = {}) {
  const audioTrack = useAudioTrackOptions();
  const available = audioTrack?.state.availability === 'available';
  return (
    available && (
      <Submenu
        icon={<SpeechIcon className="media-icon" />}
        label={<Text token={audioText.key}>{audioText.text}</Text>}
        selectedLabel={
          <span className="media-hint-label" data-part="hint">
            {audioTrack?.selectedLabel}
          </span>
        }
        {...props}
      >
        <AudioTrackRadioGroup
          renderItem={(props, item) => (
            <RadioItem {...props}>
              <span>{item.label}</span>
            </RadioItem>
          )}
        />
      </Submenu>
    )
  );
}

