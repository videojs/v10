        transition-duration: 50ms;
      }

      .media-settings {
        transition-duration: 0s, 0s, 0s, 0s, 0.25s, 0.25s;
      }

      .media-settings-icon {
        transition-duration: 0s;
      }
    }

    .media-radio-group {
      gap: calc(var(--media-spacing) * 0.5);
      anchor-scope: --media-menu-item-highlight-anchor;
      flex-direction: column;
      display: flex;
      position: relative;
    }

    .media-separator {
      margin-block: calc(var(--media-spacing) * 1);
      border-color: oklab(100% 0 5.96046e-8 / 0.1);
      border-bottom-style: solid;
      border-bottom-width: 1px;
    }

    @media (prefers-contrast: more) {
      .media-separator {
        border-color: oklab(100% 0 5.96046e-8 / 0.25);
      }
    }

    @media (forced-colors: active) {
      .media-separator {
        border-color: canvastext;
      }
    }

    @media (prefers-reduced-transparency: reduce) {
      .media-separator {
        border-color: oklab(100% 0 5.96046e-8 / 0.25);
      }
    }

    .media-settings {
      margin: calc(var(--media-spacing) * 0);
      height: var(--media-menu-height);
      max-height: min(var(--media-popover-available-height, 14rem), 14rem);
      width: var(--media-menu-width);
      max-width: var(--media-popover-available-width);
      min-width: calc(var(--media-spacing) * 48);
      overscroll-behavior: none;
      padding: calc(var(--media-spacing) * 1);
      border-style: solid;
      border-width: 0;
      border-radius: 0.75rem;
      transition-property: opacity, filter, transform, scale, width, height;
      transition-duration: 0.1s, 0.1s, 0.1s, 0.1s, 0.25s, 0.25s;
      transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
      overflow: hidden;
    }

    .media-settings[data-submenu-expanded='true'] > :not([data-submenu]) {
      filter: blur(8px);
      translate: -100%;
    }

    .media-settings-icon {
      transition-property: transform, translate, scale, rotate;
      transition-duration: 0.15s;
      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }

    @scope (.media-settings-trigger) {
      &[aria-expanded='true'] .media-settings-icon {
        rotate: 90deg;
      }
    }

    .media-sr-only {
      clip-path: inset(50%);
      white-space: nowrap;
      border-width: 0;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      position: absolute;
      overflow: hidden;
    }

    .media-submenu-panel {
      inset-inline: calc(var(--media-spacing) * 0);
      top: calc(var(--media-spacing) * 0);
      z-index: 10;
      max-height: inherit;
      overscroll-behavior: none;
      padding: calc(var(--media-spacing) * 1);
      outline-style: none;
      transition-property: translate, filter;
      transition-duration: 0.25s;
      transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
      position: absolute;
      overflow: auto;
    }

    .media-submenu-panel[data-ending-style],
    .media-submenu-panel[data-starting-style] {
      pointer-events: none;
      filter: blur(8px);
      translate: 100%;
    }

    .media-tier {
      padding-left: calc(var(--media-spacing) * 0.5);
      opacity: 0.7;
      font-size: 0.7em;
      font-weight: 600;
      line-height: 1;
    }
  }
}

