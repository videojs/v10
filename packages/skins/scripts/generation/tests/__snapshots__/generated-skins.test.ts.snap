===== packages/html/src/__generated__/skins/minimal-video/styles/base.css =====
@layer videojs.base {
  @scope (.media-skin) {
    :scope,
    *,
    ::before,
    ::after {
      box-sizing: border-box;
    }

    button {
      font: inherit;
      color: inherit;
      letter-spacing: inherit;
    }

    svg {
      display: block;
    }

    [hidden] {
