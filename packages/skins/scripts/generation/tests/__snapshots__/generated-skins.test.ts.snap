          <TimeSliderPrimitive.ChapterTitle className="media-chapter-title" />
          <TimeSliderPrimitive.Value className="media-slider-value" type="pointer" />
        </div>
      </TimeSliderPrimitive.Preview>
    </TimeSliderPrimitive.Root>
  );
}

