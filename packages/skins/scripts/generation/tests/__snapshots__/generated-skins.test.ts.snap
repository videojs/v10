===== packages/react/src/__generated__/skins/minimal-video/components/controls/volume-popover.tsx =====
import type { VolumeSliderProps as CoreVolumeSliderProps } from '@videojs/core';
import { MuteButton } from '../buttons/mute-button';
import { VolumeSlider } from '../sliders/volume-slider';
import { usePlayer } from '@/player/context';
import { Popover as PopoverPrimitive } from '@/ui/popover';
import { cn, resolveClassName } from '@videojs/utils/style';

export interface VolumePopoverProps extends Omit<PopoverPrimitive.RootProps, 'children'> {
  orientation?: CoreVolumeSliderProps['orientation'];
  className?: PopoverPrimitive.PopupProps['className'];
}

export function VolumePopover({
  className,
  side = 'top',
  orientation = 'vertical',
  ...props
}: VolumePopoverProps = {}) {
  const volumeAvailability = usePlayer((state) => state.volumeAvailability);
  return volumeAvailability === 'available' ? (
    <PopoverPrimitive.Root openOnHover delay={200} closeDelay={100} side={side} {...props}>
      <PopoverPrimitive.Trigger render={<MuteButton />} />
      <PopoverPrimitive.Popup
        className={(state) => cn('media-surface', 'media-volume-popover', resolveClassName(className, state))}
      >
        <VolumeSlider orientation={orientation} />
      </PopoverPrimitive.Popup>
    </PopoverPrimitive.Root>
  ) : (
    <MuteButton />
  );
}

