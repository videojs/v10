===== packages/html/src/__generated__/skins/default-video/styles/base.css =====
@layer videojs.base {
  @scope (.media-skin) {
    :scope,
    *,
    ::before,
    ::after {
      box-sizing: border-box;
    }

    button {
      font: inherit;
      color: inherit;
      letter-spacing: inherit;
    }

    svg {
      display: block;
    }

    [hidden] {
      /* Hidden must override component display styles. */
      display: none !important;
    }
  }
}

===== packages/html/src/__generated__/skins/default-video/styles/buttons.css =====
@layer videojs.components {
  @scope (.media-skin-video) {
    .media-airplay-button:not([data-airplay-state='connected']) {
      --media-icon-airplay-fill-animation: none;
      --media-icon-airplay-triangle-animation: none;
    }

    .media-airplay-enter-icon {
      opacity: 0;
      display: none;
    }

    @scope (.media-airplay-button) {
      &:not([data-airplay-state='connected']) .media-airplay-enter-icon {
        opacity: 1;
        display: block;
      }
    }

    .media-airplay-exit-icon {
      opacity: 0;
      display: none;
    }

    @scope (.media-airplay-button) {
      &[data-airplay-state='connected'] .media-airplay-exit-icon {
        opacity: 1;
        display: block;
      }
    }

    .media-button {
      width: calc(var(--media-spacing) * 9);
      height: calc(var(--media-spacing) * 9);
      min-height: calc(var(--media-spacing) * 0);
      cursor: pointer;
      touch-action: manipulation;
      border-radius: var(--media-control-radius);
      padding: calc(var(--media-spacing) * 0);
      text-align: center;
      color: inherit;
      outline-offset: -2px;
      -webkit-user-select: none;
      user-select: none;
      background-color: #0000;
      border-style: solid;
      border-width: 0;
      outline: 2px solid #0000;
      flex-shrink: 0;
      place-items: center;
      transition-property: background-color, color, outline-offset, scale;
      transition-duration: 0.15s;
      transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
      display: grid;
    }

    @media (hover: hover) {
      .media-button:hover {
        background-color: var(--media-accent-color, oklch(100% 0 0 / 0.1));
        color: var(--media-accent-text-color, contrast-color(var(--media-accent-color, oklch(0% 0 0))));
      }
    }

    .media-button:focus-visible {
      background-color: var(--media-accent-color, oklch(100% 0 0 / 0.1));
      color: var(--media-accent-text-color, contrast-color(var(--media-accent-color, oklch(0% 0 0))));
      outline-offset: 2px;
      outline-color: currentColor;
    }

    .media-button:not([aria-disabled='true']):active {
      scale: 0.9;
    }

    .media-button[aria-disabled='true'] {
      cursor: not-allowed;
      opacity: 0.5;
    }

    .media-button[aria-expanded='true'] {
      background-color: var(--media-accent-color, oklch(100% 0 0 / 0.1));
      color: var(--media-accent-text-color, contrast-color(var(--media-accent-color, oklch(0% 0 0))));
    }

    @media (prefers-reduced-motion: reduce) {
      .media-button {
        transition-duration: 50ms;
      }
    }

    .media-button-icon {
      width: var(--media-icon-size, calc(var(--media-spacing) * 4.5));
      height: var(--media-icon-size, calc(var(--media-spacing) * 4.5));
      filter: drop-shadow(0 1px #00000026);
    }

    .media-captions-off-icon {
      opacity: 0;
      display: none;
    }

    @scope (.media-captions-button) {
      &:not([data-active]) .media-captions-off-icon {
        opacity: 1;
        display: block;
      }
    }

    .media-captions-on-icon {
      opacity: 0;
      display: none;
    }

    @scope (.media-captions-button) {
