import { ButtonTooltip } from './button-tooltip';
import { AirPlayEnterIcon, AirPlayExitIcon } from '@/icons/minimal';
import { AirPlayButton as AirPlayButtonPrimitive } from '@/ui/airplay-button';
import { cn, resolveClassName } from '@videojs/utils/style';

export interface AirPlayButtonProps extends Omit<AirPlayButtonPrimitive.Props, 'children'> {}

export function AirPlayButton({ className, ...props }: AirPlayButtonProps = {}) {
  return (
    <ButtonTooltip side="top">
      <AirPlayButtonPrimitive
        className={(state) => cn('media-button', 'media-airplay-button', resolveClassName(className, state))}
        {...props}
      >
        <AirPlayEnterIcon className="media-button-icon media-airplay-enter-icon" />
        <AirPlayExitIcon className="media-button-icon media-airplay-exit-icon" />
      </AirPlayButtonPrimitive>
    </ButtonTooltip>
  );
}

