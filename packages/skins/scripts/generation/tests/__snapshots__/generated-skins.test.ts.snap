===== packages/skins/canonical/registry/default/components/video-settings-menu/quality-menu.tsx =====
import { qualityText } from '@videojs/core/i18n/text/menu';
import { QualityRadioGroup } from './radio-group';
import { RadioItem } from './radio-item';
import { Submenu, type SubmenuProps } from './submenu';
import { cn } from '@/components/videojs/utils';
import { useQualityOptions, Text } from '@videojs/react';
import { SwitchesIcon } from '@videojs/react/icons';

export interface QualityMenuProps extends Omit<SubmenuProps, 'children' | 'icon' | 'label' | 'selectedLabel'> {}

export function QualityMenu(props: QualityMenuProps = {}) {
  const quality = useQualityOptions();
  const available = quality?.state.availability === 'available';
  return (
    available && (
      <Submenu
        icon={
          <SwitchesIcon
            className={cn(
              'size-media-icon shrink-0 opacity-70 group-hover/menu-item:opacity-100',
              'drop-shadow-[0_1px_0_rgb(0_0_0/0.15)]',
            )}
          />
        }
        label={<Text token={qualityText.key}>{qualityText.text}</Text>}
        selectedLabel={
          <span className="max-w-24 overflow-hidden text-ellipsis whitespace-nowrap" data-part="hint">
            {quality?.selectedLabel}
          </span>
        }
        {...props}
      >
        <QualityRadioGroup
          renderItem={(props, item) => (
            <RadioItem {...props}>
              <span>
                <span>{item.label}</span>
                {item.tier ? (
                  <sup className="pl-0.5 text-[0.7em] font-semibold leading-none opacity-70">{item.tier}</sup>
                ) : null}
              </span>
              {item.badge ? (
                <span className="rounded-media-control bg-media-control-hover px-1.5 text-[0.7em] font-semibold">
                  {item.badge}
                </span>
              ) : null}
            </RadioItem>
          )}
        />
      </Submenu>
    )
  );
}

