      }
    }

    @scope (.media-volume-indicator) {
      &[data-level='high'] .media-volume-high-indicator-icon {
        display: block;
      }
    }

    .media-volume-indicator {
      pointer-events: none;
      padding-inline: 0.625rem;
      inset-inline: 0;
      background-image: linear-gradient(oklch(0% 0 0 / 0.35), oklch(0% 0 0 / 0.2) 3rem, #0000);
