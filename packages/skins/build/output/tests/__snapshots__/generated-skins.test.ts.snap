        opacity: 1;
        display: block;
      }
    }

    .media-play-icon {
      opacity: 0;
      display: none;
    }

    @scope (.media-play-button) {
      &:not([data-ended]):not([data-started]) .media-play-icon,
      &:not([data-ended])[data-paused] .media-play-icon {
        opacity: 1;
        display: block;
      }
    }

    .media-restart-icon {
      opacity: 0;
      display: none;
    }

