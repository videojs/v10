    @media (prefers-reduced-motion: reduce) {
      .media-playback-status-indicator {
        transition-duration: 50ms;
      }
    }

    .media-seek-indicator {
      text-align: center;
      grid-row-start: 1;
      grid-column-start: 2;
      place-content: center;
      gap: 0.25rem;
      padding: 1rem;
      display: grid;
