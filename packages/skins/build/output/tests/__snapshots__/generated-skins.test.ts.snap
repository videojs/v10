        checked={checked}
      >
        <CheckIcon className="size-media-icon shrink-0 opacity-70 drop-shadow-media-icon group-hover/menu-item:opacity-100" />
      </Menu.ItemIndicator>
    </Menu.RadioItem>
  );
}

