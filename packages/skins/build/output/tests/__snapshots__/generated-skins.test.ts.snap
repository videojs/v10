@layer videojs.components {
  @scope (.media-skin-video-minimal) {
    .media-chapter-title {
      max-width: var(--media-max-width);
      text-overflow: ellipsis;
      white-space: nowrap;
      min-width: 0;
      padding-inline: 0.75rem;
      overflow: hidden;
    }

    .media-chapter-title:empty {
      display: none;
    }

    .media-preview-value {
      max-width: var(--media-max-width);
      transform-origin: bottom;
      font-variant-numeric: tabular-nums;
      opacity: 0;
      filter: blur(16px);
      flex-direction: column;
      align-items: center;
      transition-property: filter, opacity, scale;
      transition-duration: 0.15s;
      transition-timing-function: ease-out;
      display: flex;
      position: absolute;
      bottom: calc(100% + 2.625rem);
      left: 50%;
      translate: -50% 0.5rem;
      scale: 0.8;
    }

    @scope (.media-slider-preview) {
      &[data-interactive]:not([data-pointing]):not([data-dragging]) .media-preview-value,
      &[data-pointing] .media-preview-value {
        opacity: 1;
        filter: none;
        scale: 1;
      }
    }

    .media-slider {
      cursor: pointer;
      border-radius: var(--media-radius-pill);
      outline-style: none;
      flex: 1;
      justify-content: center;
      align-items: center;
      display: flex;
      position: relative;
    }

    .media-slider[data-orientation='horizontal'] {
      min-width: 5rem;
      height: 2rem;
    }

    .media-slider[data-orientation='vertical'] {
      width: 2rem;
      min-width: 0;
      height: 5rem;
    }

    .media-slider-buffer {
      width: var(--media-slider-buffer);
      border-radius: inherit;
      background-color: var(--media-slider-buffer-background);
      inset-block: 0;
      position: absolute;
      left: 0;
    }

    .media-slider-buffer[data-orientation='vertical'] {
      height: var(--media-slider-buffer);
      inset-inline: 0;
      width: auto;
      top: auto;
      bottom: 0;
    }

    .media-slider-chapter {
      --media-chapter-gap: 0.25rem;
      --media-chapter-inset-end: 0.5;
      --media-chapter-inset-start: 0.5;
      justify-content: center;
      align-items: center;
      min-width: 0;
      min-height: 0;
      display: flex;
