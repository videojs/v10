      transition-duration: 0.2s;
      transition-timing-function: ease-out;
      position: absolute;
      top: 50%;
      left: 50%;
      translate: -50% -50%;
      scale: 0.5;
    }

    .media-slider-preview[data-pointing]:not([data-dragging]):before {
      content: '';
      opacity: 1;
      scale: 1;
    }

    .media-slider-thumb {
      top: 50%;
      left: var(--media-slider-fill);
      z-index: 10;
      border-radius: var(--media-radius-pill);
      outline-offset: -4px;
      background-color: currentColor;
      outline: 4px solid #0000;
      transition-property: opacity, height, width, outline-offset, left, top;
      transition-duration: 0.15s;
      transition-timing-function: ease-out;
      position: absolute;
      translate: -50% -50%;
    }

    @media (hover: hover) {
      .media-slider-thumb:hover {
        outline-offset: 0px;
        outline-color: currentColor;
      }

      @supports (color: color-mix(in lab, red, red)) {
        .media-slider-thumb:hover {
          outline-color: color-mix(in oklab, currentcolor 15%, transparent);
        }
      }
    }

    .media-slider-thumb:focus-visible {
      outline-offset: 0px;
      outline-color: currentColor;
    }

    @supports (color: color-mix(in lab, red, red)) {
      .media-slider-thumb:focus-visible {
        outline-color: color-mix(in oklab, currentcolor 15%, transparent);
      }
    }

    @scope (.media-slider) {
      &[data-dragging] .media-slider-thumb[data-orientation='horizontal'] {
        left: var(--media-slider-pointer);
      }
    }

    .media-slider-thumb[data-orientation='vertical'] {
      top: calc(100% - var(--media-slider-fill));
      left: 50%;
    }

    @scope (.media-slider) {
      &[data-dragging] .media-slider-thumb[data-orientation='vertical'] {
        top: calc(100% - var(--media-slider-pointer));
      }
    }

    .media-slider-thumb-interactive {
      opacity: 0;
      width: 0.625rem;
      height: 0.625rem;
    }

    @scope (.media-slider) {
      &:focus-within .media-slider-thumb-interactive {
        width: 0.75rem;
        height: 0.75rem;
      }
    }

    @media (hover: hover) {
      @scope (.media-slider) {
        &:hover .media-slider-thumb-interactive {
          opacity: 1;
        }
      }
    }

    @scope (.media-slider) {
      &:active .media-slider-thumb-interactive {
        width: 0.75rem;
        height: 0.75rem;
      }
    }

    .media-slider-thumb-interactive:focus-visible {
      opacity: 1;
    }

    .media-slider-thumb-persistent {
      width: 0.75rem;
      height: 0.75rem;
    }

    .media-slider-track {
      isolation: isolate;
      height: var(--media-slider-track-size);
      border-radius: var(--media-radius-pill);
      background-color: var(--media-slider-track-background);
      -webkit-user-select: none;
      user-select: none;
      width: 100%;
      position: relative;
      overflow: hidden;
    }

    .media-slider-track[data-orientation='vertical'] {
      height: 100%;
      width: var(--media-slider-track-size);
    }

    .media-slider-value {
      font-variant-numeric: tabular-nums;
    }

    .media-spinner-icon {
      width: var(--media-icon-size, calc(1.125 * var(--media-size)));
      height: var(--media-icon-size, calc(1.125 * var(--media-size)));
      opacity: 0;
      filter: drop-shadow(0 1px 0 var(--media-shadow-color));
      position: absolute;
      top: 50%;
      left: 50%;
      translate: -50% -50%;
    }

    @scope (.media-thumbnail) {
      &:has([role='img'][data-loading]) .media-spinner-icon {
        opacity: 1;
      }
    }

    .media-thumbnail {
      pointer-events: none;
      max-width: var(--media-max-width);
      transform-origin: bottom;
      opacity: 0;
      filter: blur(16px);
      --media-thumbnail-max-width: var(--media-max-width);
      background-color: oklab(0% none none / 0.9);
      border-radius: 0.75rem;
      transition-property: filter, opacity, scale;
      transition-duration: 0.15s;
      transition-timing-function: ease-out;
      position: absolute;
      bottom: calc(100% + 2.25rem);
      left: 50%;
      overflow: hidden;
      translate: -50% 0.5rem;
      scale: 0.8;
    }

    @scope (.media-slider-preview) {
      &[data-interactive]:not([data-pointing]):not([data-dragging]) .media-thumbnail,
      &[data-pointing] .media-thumbnail {
        opacity: 1;
        filter: none;
        scale: 1;
      }
    }

    .media-thumbnail:has([data-loading]) {
      aspect-ratio: 16 / 9;
      width: var(--media-thumbnail-max-width);
    }

    .media-thumbnail-image {
      max-height: var(--media-max-height);
      max-width: var(--media-thumbnail-max-width);
      border-radius: inherit;
      transition-property: opacity;
      transition-duration: 0.15s;
      transition-timing-function: ease-out;
      display: block;
      position: relative;
      overflow: clip;
    }

    .media-thumbnail-image[data-loading] {
      opacity: 0;
    }
  }
}

