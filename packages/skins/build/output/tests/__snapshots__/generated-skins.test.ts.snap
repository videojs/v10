===== packages/react/src/__generated__/skins/default-video/styles/theme.css =====
@layer videojs.theme {
  .media-theme-default {
    --media-default-accent-color: oklch(1 0 0);
    --media-accent-contrast-color: contrast-color(var(--media-accent-color, var(--media-default-accent-color)));
    --media-accent-background-color: var(
      --media-accent-color,
      oklch(from var(--media-default-accent-color) l c h / calc(alpha * 0.1))
    );
    --media-border-color: light-dark(oklch(0 0 0 / 0.1), oklch(1 0 0 / 0.15));
    --media-focus-ring-color: light-dark(oklch(0 0 0), oklch(1 0 0));
    --media-container-border-radius: var(--media-border-radius, 1.75rem);
    --media-controls-color: oklch(1 0 0);
    --media-controls-background: transparent;
    --media-controls-gap: 0.25rem;
    --media-controls-padding: 0.25rem;
    --media-controls-transition-duration: 100ms;
    --media-error-dialog-transition-delay: 100ms;
    --media-error-dialog-transition-duration: 350ms;
    --media-popup-transition-duration: 100ms;
    --media-scale: 1;
    --media-size: calc(var(--media-scale-unit, 16px) * var(--media-scale));
    --media-button-size: calc(2.25 * var(--media-size));
    --media-font-family: Inter Variable, Inter, ui-sans-serif, system-ui, sans-serif;
    --media-font-size: calc(0.8125 * var(--media-size));
    --media-radius-pill: 9999px;
    --media-radius-surface: 0.5rem;
    --media-shadow-color: oklch(0 0 0 / 0.15);
    --media-slider-buffer-background: oklch(from currentColor l c h / 0.2);
    --media-slider-thumb-size: 0.75rem;
    --media-slider-track-background: oklch(from currentColor l c h / 0.2);
    --media-slider-track-size: 0.25rem;
    --media-surface-backdrop-blur: 16px;
    --media-surface-backdrop-saturate: 1.5;
    --media-surface-background: oklch(1 0 0 / 0.1);
    --media-surface-inner-border: oklch(1 0 0 / 0.1);
    --media-surface-outer-border: oklch(0 0 0 / 0.1);
    --media-surface-border: var(--media-surface-inner-border);
    --media-video-border-radius: var(--media-container-border-radius);
  }

  @media (pointer: fine) {
    .media-theme-default:has([data-controls]:not([data-visible])) {
      --media-controls-transition-duration: 300ms;
    }
  }

  @media (pointer: coarse) {
    .media-theme-default:has([data-controls]:not([data-visible])) {
      --media-controls-transition-duration: 150ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .media-theme-default {
      --media-controls-transition-duration: 50ms;
      --media-error-dialog-transition-delay: 0ms;
      --media-error-dialog-transition-duration: 50ms;
      --media-popup-transition-duration: 0ms;
    }
  }

  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .media-theme-default {
      --media-surface-background: oklch(0 0 0);
      --media-surface-inner-border: oklch(1 0 0 / 0.25);
      --media-surface-outer-border: transparent;
      --media-surface-backdrop-blur: 0px;
      --media-surface-backdrop-saturate: 1;
    }
  }

  @media (forced-colors: active) {
    .media-theme-default {
      --media-accent-color: Highlight;
      --media-accent-contrast-color: HighlightText;
      --media-accent-background-color: Highlight;
      --media-accent-text-color: HighlightText;
      --media-border-color: CanvasText;
      --media-controls-color: CanvasText;
      --media-focus-ring-color: CanvasText;
      --media-surface-background: Canvas;
      --media-surface-inner-border: CanvasText;
      --media-surface-outer-border: CanvasText;
    }
  }
}

