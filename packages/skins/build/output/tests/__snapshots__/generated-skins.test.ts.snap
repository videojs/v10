    .media-buffering-spinner-icon {
      width: var(--media-icon-size, calc(1.125 * var(--media-size)));
      height: var(--media-icon-size, calc(1.125 * var(--media-size)));
      filter: drop-shadow(0 1px 0 var(--media-shadow-color));
    }

    .media-playback-status-icon {
      width: calc(var(--media-icon-size) * 1.5);
      height: calc(var(--media-icon-size) * 1.5);
      display: none;
    }

    .media-playback-status-indicator {
      border-radius: var(--media-radius-pill);
      text-align: center;
      backdrop-filter: blur(8px);
      background-color: oklab(0% none none / 0.35);
      grid-row-start: 1;
      grid-column-start: 2;
      place-content: center;
      padding: 1rem;
      transition-property: opacity, scale;
      transition-duration: 0.2s;
      transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
      display: grid;
