      font-weight: 600;
    }

    .media-chevron {
      width: 0.875rem;
      height: 0.875rem;
    }

    .media-chevron-flipped {
      rotate: 180deg;
    }

    .media-hint {
      opacity: 0.7;
      align-items: center;
      gap: 0.25rem;
      min-width: 0;
      margin-left: auto;
      padding-left: 0.5rem;
      display: inline-flex;
    }

    .media-hint-label {
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 6rem;
      overflow: hidden;
    }

    .media-icon {
      width: var(--media-icon-size, calc(1.125 * var(--media-size)));
      height: var(--media-icon-size, calc(1.125 * var(--media-size)));
      opacity: 0.7;
      filter: drop-shadow(0 1px 0 var(--media-shadow-color));
      flex-shrink: 0;
    }

    @media (hover: hover) {
      @scope (.media-menu-item) {
        &:hover .media-icon {
          opacity: 1;
        }
      }
    }

    .media-indicator {
      opacity: 0;
      flex-shrink: 0;
      margin-left: auto;
      margin-right: -0.25rem;
    }

    @scope (.media-menu-item) {
      &[aria-checked='true'] .media-indicator {
        opacity: 1;
      }
    }

    .media-item {
      color: inherit;
      font-variant-numeric: tabular-nums;
      justify-content: space-between;
    }

    .media-item[aria-disabled='true'] {
      pointer-events: none;
      cursor: not-allowed;
      opacity: 0.5;
    }

    .media-item[data-availability='unavailable'],
    .media-item[data-availability='unsupported'] {
      display: none;
    }

    .media-menu-group {
      anchor-scope: --media-menu-item-highlight-anchor;
      flex-direction: column;
      gap: 0.125rem;
      display: flex;
      position: relative;
    }

    .media-menu-item {
      cursor: pointer;
      border-radius: var(--media-radius-surface);
      text-align: left;
      outline-offset: -2px;
      -webkit-user-select: none;
      user-select: none;
      outline: 2px solid #0000;
      align-items: center;
      gap: 0.375rem;
      padding-block: 0.375rem;
      padding-inline: 0.5rem;
      transition-property: color, background-color;
      transition-duration: 0.1s;
      transition-timing-function: ease-in-out;
      display: flex;
      position: relative;
    }

    @media (hover: hover) {
      .media-menu-item:hover {
        background-color: var(--media-accent-background-color);
        color: var(--media-accent-text-color, contrast-color(var(--media-accent-color, oklch(0% 0 0))));
      }
    }

    .media-menu-item:focus-visible {
      outline-offset: 2px;
      outline-color: var(--media-focus-ring-color);
    }

    .media-menu-item[data-highlighted] {
      background-color: var(--media-accent-background-color);
      color: var(--media-accent-text-color, contrast-color(var(--media-accent-color, oklch(0% 0 0))));
    }

    .media-radio-group {
      anchor-scope: --media-menu-item-highlight-anchor;
      flex-direction: column;
      gap: 0.125rem;
      display: flex;
      position: relative;
    }

    .media-separator {
      border-bottom-style: solid;
      border-bottom-width: 1px;
      border-color: var(--media-surface-background);
      margin-block: 0.25rem;
    }

    .media-settings {
      height: var(--media-menu-height);
      max-height: min(var(--media-popover-available-height, 14rem), 14rem);
      width: var(--media-menu-width);
      max-width: var(--media-popover-available-width);
      overscroll-behavior: none;
      min-width: 12rem;
      transition-property: opacity, filter, transform, scale, width, height;
      transition-duration:
        var(--media-popup-transition-duration), var(--media-popup-transition-duration),
        var(--media-popup-transition-duration), var(--media-popup-transition-duration),
        var(--media-menu-transition-duration), var(--media-menu-transition-duration);
      --media-menu-transition-duration: 0.25s;
      border-style: solid;
      border-width: 0;
      border-radius: 0.75rem;
      margin: 0;
      padding: 0.25rem;
      overflow: hidden;
    }

    .media-settings[data-submenu-expanded='true'] > :not([data-submenu]) {
      filter: blur(8px);
      translate: -100%;
    }

    .media-settings-icon {
      transition-property: transform;
      transition-duration: 0.15s;
      transition-timing-function: ease-in-out;
    }

    @scope (.media-settings-trigger) {
      &[aria-expanded='true'] .media-settings-icon {
        rotate: 90deg;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .media-settings-icon {
        transition-duration: 0s;
      }
    }

    .media-sr-only {
      clip-path: inset(50%);
      white-space: nowrap;
      border-width: 0;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      position: absolute;
      overflow: hidden;
    }

    .media-submenu-panel {
      z-index: 10;
      max-height: inherit;
      overscroll-behavior: none;
      transition-property: translate, filter;
      transition-duration: var(--media-menu-transition-duration);
      inset-inline: 0;
      outline-style: none;
      padding: 0.25rem;
      transition-timing-function: ease-out;
      position: absolute;
      top: 0;
      overflow: auto;
    }

    .media-submenu-panel[data-ending-style],
    .media-submenu-panel[data-starting-style] {
      pointer-events: none;
      filter: blur(8px);
      translate: 100%;
    }

    .media-tier {
      opacity: 0.7;
      padding-left: 0.125rem;
      font-size: 0.7em;
      font-weight: 600;
      line-height: 1;
    }
  }
}

