@layer videojs.components {
  @scope (.media-skin) {
    :scope {
      --media-caption-track-y: -0.5rem;
      --media-caption-track-delay: 25ms;
      --media-caption-track-duration: var(--media-controls-transition-duration);
    }

    :scope:has([data-controls][data-visible]) {
      --media-caption-track-y: -3.5rem;
    }

    video::-webkit-media-text-track-container {
      translate: 0 var(--media-caption-track-y);
      transition-delay: var(--media-caption-track-delay);
      transition-duration: var(--media-caption-track-duration);
      transition-property: translate;
    }
  }
}

===== packages/html/src/__generated__/skins/minimal-video/styles/container.css =====
@layer videojs.components {
  @scope (.media-skin-video-minimal) {
    .media-container,
    :scope.media-container {
      isolation: isolate;
      border-radius: var(--media-container-border-radius);
      width: 100%;
      height: 100%;
      font-family: var(--media-font-family);
      font-size: var(--media-font-size);
      -webkit-font-smoothing: auto;
      -moz-osx-font-smoothing: auto;
      outline-offset: -4px;
      background-color: #000;
      outline: 2px solid #0000;
      line-height: 1.5;
      transition-property: outline-offset, outline-color;
      transition-duration: 0.1s;
      transition-timing-function: ease-out;
      display: block;
      position: relative;
      overflow: hidden;
      container: media-root / inline-size;
    }

    .media-container:before,
    :scope.media-container:before {
      pointer-events: none;
      background-image: var(--media-poster-placeholder, none);
      background-size: var(--media-object-fit, contain);
      background-position: var(--media-object-position, center);
      opacity: 0;
      filter: blur(var(--media-poster-placeholder-blur, 20px));
      content: '';
      background-repeat: no-repeat;
      transition-property: opacity;
      transition-duration: 0.25s;
      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
      position: absolute;
      inset: 0;
    }

    .media-container:after,
    :scope.media-container:after {
      pointer-events: none;
      z-index: 10;
      border-radius: inherit;
      content: '';
      box-shadow:
        0 0 #0000,
        0 0 #0000,
        0 0 #0000,
        0 0 #0000,
        inset 0 0 0 1px var(--media-border-color);
      position: absolute;
      inset: 0;
    }

    .media-container:focus-visible,
    :scope.media-container:focus-visible {
      outline-offset: 2px;
      outline-color: var(--media-focus-ring-color);
    }

    .media-container:has(:is(img[data-visible]:not([data-loaded]))):before,
    :scope.media-container:has(:is(img[data-visible]:not([data-loaded]))):before {
      content: '';
      opacity: 1;
    }

    @media (pointer: fine) {
      .media-container:has([data-controls]:not([data-visible])),
      :scope.media-container:has([data-controls]:not([data-visible])) {
        cursor: none;
      }
    }

    .media-container video,
    :scope.media-container video {
      border-radius: inherit;
      object-fit: var(--media-object-fit, contain);
      object-position: var(--media-object-position, center);
      width: 100%;
      height: 100%;
      display: block;
    }

    .media-container:fullscreen,
    :scope.media-container:fullscreen {
      --media-container-border-radius: 0;
    }

    .media-container:fullscreen:after,
    :scope.media-container:fullscreen:after {
      content: '';
      display: none;
    }

    @media (width >= 1280px) {
      .media-container:fullscreen,
      :scope.media-container:fullscreen {
        --media-scale: 1.25;
      }
    }

    @media (width >= 1536px) {
      .media-container:fullscreen,
      :scope.media-container:fullscreen {
        --media-scale: 1.5;
      }
    }

    @media (width >= 1920px) {
      .media-container:fullscreen,
      :scope.media-container:fullscreen {
        --media-scale: 1.75;
      }
    }

    .media-container:fullscreen video,
    :scope.media-container:fullscreen video {
      object-fit: contain;
    }
  }
}

===== packages/html/src/__generated__/skins/minimal-video/styles/controls.css =====
@layer videojs.components {
  @scope (.media-skin-video-minimal) {
    .media-controls-end {
      flex: 1;
      justify-content: flex-end;
      align-items: center;
      gap: 1px;
      display: flex;
    }

    @container media-root (width >= 42rem) {
      .media-controls-end {
        flex: none;
      }
    }

    .media-controls-remote {
      align-items: center;
      gap: 1px;
      display: none;
    }

    @container media-root (width >= 32rem) {
      .media-controls-remote {
        display: flex;
      }
    }

    .media-controls-root {
      z-index: 20;
      background-color: var(--media-controls-background);
      padding: var(--media-controls-padding);
      color: #fff;
      transition-property: filter, opacity, translate;
      transition-duration: calc(var(--media-controls-transition-duration) / 2);
      --media-popover-boundary-offset: 0.25rem;
      --media-popover-side-offset: 1.25rem;
      --media-tooltip-boundary-offset: var(--media-popover-boundary-offset);
      --media-tooltip-side-offset: var(--media-popover-side-offset);
      inset-inline: 0.25rem;
      border-radius: 0.75rem;
      flex-wrap: wrap;
      align-items: center;
      column-gap: 0.5rem;
      transition-timing-function: ease-out;
      display: flex;
      position: absolute;
      bottom: 0.25rem;
    }

    .media-controls-root:not([data-visible]) {
      pointer-events: none;
      opacity: 0;
      transition-duration: var(--media-controls-transition-duration);
    }

    .media-controls-root:is(:where(.media-error-dialog)[data-open] ~ *) {
      display: none !important;
    }

    @media (prefers-reduced-motion: no-preference) {
      .media-controls-root:not([data-visible]) {
        translate: 0 100%;
      }
    }

    @container media-root (width >= 42rem) {
      .media-controls-root {
        --media-popover-side-offset: 0.75rem;
        inset-inline: 0.5rem;
        flex-wrap: nowrap;
        bottom: 0.5rem;
      }
    }

    @media (pointer: fine) {
      @media (prefers-reduced-motion: no-preference) {
        .media-controls-root:not([data-visible]) {
          filter: blur(8px);
        }
      }
    }

    .media-controls-start {
      flex: 1;
      align-items: center;
      gap: 1px;
      display: flex;
    }

    @container media-root (width >= 42rem) {
      .media-controls-start {
        flex: none;
      }
    }

    .media-time-controls {
      flex-direction: row-reverse;
      flex-basis: 100%;
      order: -9999;
      align-items: center;
      gap: 0.75rem;
      padding-inline: 0.375rem;
      display: flex;
      container: media-time-controls / inline-size;
    }

    @container media-root (width >= 42rem) {
      .media-time-controls {
        flex-direction: row;
        flex: 1 1 0;
        order: 0;
        min-width: 0;
        transition: mask-position 50ms ease-out;
        mask-position: 100% 0;
        mask-size: 200% 100%;
      }

      @scope (.media-controls-root) {
        &:has([data-volume-level][aria-expanded='true']) .media-time-controls {
          mask-image: linear-gradient(to right, #0000 10%, #000 25% 100%);
          mask-position: 0 0;
        }
      }
    }

    .media-time-current {
      cursor: pointer;
      font-variant-numeric: tabular-nums;
      outline-offset: -2px;
      border-radius: 0.25rem;
      outline: 2px solid #0000;
      display: none;
    }

    .media-time-current:focus-visible {
      outline-offset: 2px;
      outline-color: currentColor;
    }

    @container media-root (width >= 42rem) {
      .media-time-current {
        display: inline;
      }
    }

    .media-time-duration {
      color: currentColor;
    }

    @supports (color: color-mix(in lab, red, red)) {
      .media-time-duration {
        color: color-mix(in oklab, currentcolor 60%, transparent);
      }
    }

    .media-time-duration {
      font-variant-numeric: tabular-nums;
    }

    .media-time-group {
      align-items: center;
      gap: 0.25rem;
      display: flex;
    }

    .media-time-separator {
      color: currentColor;
      display: none;
    }

    @supports (color: color-mix(in lab, red, red)) {
      .media-time-separator {
        color: color-mix(in oklab, currentcolor 60%, transparent);
      }
    }

    @container media-root (width >= 42rem) {
      .media-time-separator {
        display: inline;
      }
    }
  }
}

===== packages/html/src/__generated__/skins/minimal-video/styles/dialog.css =====
@layer videojs.components {
  @scope (.media-skin-video-minimal) {
    .media-error-dialog {
      pointer-events: none;
      z-index: 20;
      color: #fff;
      width: 100%;
      height: 100%;
      transition-property: opacity, scale, transform;
      transition-delay: 0.1s;
      transition-duration: var(--media-error-dialog-transition-duration);
      outline-style: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
      padding: 1rem;
      transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
      display: flex;
      position: absolute;
      inset: 0;
    }

    .media-error-dialog:not([data-open]) {
      display: none;
    }

    .media-error-dialog[data-ending-style] {
      opacity: 0;
      transition-delay: 0s;
      scale: 0.5;
    }

    .media-error-dialog[data-starting-style] {
      opacity: 0;
      scale: 0.5;
    }

    @media (prefers-reduced-motion: reduce) {
      .media-error-dialog {
        transition-duration: 50ms;
        transition-delay: 0s;
      }
    }

    .media-error-dialog > * {
      pointer-events: auto;
    }

    .media-error-dialog-close {
      background-color: var(--media-accent-color, var(--media-default-accent-color));
      width: 100%;
      max-width: 16rem;
      height: 2.25rem;
      color: var(--media-accent-text-color, contrast-color(var(--media-accent-color, oklch(0% 0 0))));
      padding-inline: 1rem;
      font-weight: 500;
    }

    .media-error-dialog-description {
      overflow-wrap: anywhere;
      opacity: 0.7;
      width: 100%;
      max-width: 16rem;
      padding-bottom: 0.375rem;
    }

    .media-error-dialog-title {
      width: 100%;
      max-width: 16rem;
      font-size: calc(var(--media-font-size) * 1.15);
      padding-top: 0.375rem;
      font-weight: 600;
    }
  }
}

===== packages/html/src/__generated__/skins/minimal-video/styles/indicator.css =====
@layer videojs.components {
  @scope (.media-skin-video-minimal) {
    .media-buffering-indicator {
      pointer-events: none;
      z-index: 10;
      color: #fff;
      place-content: center;
      display: none;
      position: absolute;
      inset: 0;
    }

    .media-buffering-indicator:not([data-visible]) {
      --media-spinner-animation: none;
    }

    .media-buffering-indicator[data-visible] {
      display: grid;
    }

    .media-buffering-spinner-icon {
      width: var(--media-icon-size, calc(1.125 * var(--media-size)));
      height: var(--media-icon-size, calc(1.125 * var(--media-size)));
      filter: drop-shadow(0 1px 0 var(--media-shadow-color));
    }

    .media-playback-status-icon {
      width: calc(var(--media-icon-size) * 1.5);
      height: calc(var(--media-icon-size) * 1.5);
      display: none;
    }

    .media-playback-status-indicator {
      text-align: center;
      grid-row-start: 1;
      grid-column-start: 2;
      place-content: center;
      padding: 1rem;
      transition-property: opacity, scale;
      transition-duration: 0.2s;
      transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
      display: grid;
    }

    .media-playback-status-indicator[data-ending-style] {
      opacity: 0;
      transition-duration: 0.1s;
      scale: 0.85;
    }

    .media-playback-status-indicator[data-starting-style] {
      opacity: 0;
      scale: 0.85;
    }

    @media (prefers-reduced-motion: reduce) {
      .media-playback-status-indicator {
        transition-duration: 50ms;
      }
    }

    .media-seek-indicator {
      text-align: center;
      grid-row-start: 1;
      grid-column-start: 2;
      place-content: center;
      gap: 0.25rem;
      padding: 1rem;
      display: grid;
    }

    .media-seek-indicator[data-direction='backward'] {
      grid-column-start: 1;
      justify-self: flex-start;
    }

    .media-seek-indicator[data-direction='forward'] {
      grid-column-start: 3;
      justify-self: flex-end;
    }

    .media-seek-indicator-icon {
      width: calc(var(--media-icon-size) * 1.5);
      height: calc(var(--media-icon-size) * 1.5);
      transition-property: translate, opacity;
      transition-duration: 0.2s;
      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
      display: none;
    }

    @scope (.media-seek-indicator) {
      &[data-direction] .media-seek-indicator-icon {
        display: block;
      }
    }

    @scope (.media-seek-indicator) {
      &[data-ending-style] .media-seek-indicator-icon,
      &[data-starting-style] .media-seek-indicator-icon {
        opacity: 0;
      }
    }

    @scope (.media-seek-indicator) {
      &[data-direction='backward'] .media-seek-indicator-icon {
        scale: -1 1;
      }
    }

    .media-seek-indicator-value {
      font-variant-numeric: tabular-nums;
    }

    .media-status-announcer {
      clip-path: inset(50%);
      white-space: nowrap;
      border-width: 0;
