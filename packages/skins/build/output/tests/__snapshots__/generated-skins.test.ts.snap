@layer videojs.components {
  @scope (.media-skin-video) {
    .media-container,
    :scope.media-container {
      isolation: isolate;
      border-radius: var(--media-container-border-radius);
      width: 100%;
      height: 100%;
      font-family: var(--media-font-family);
      font-size: var(--media-font-size);
      -webkit-font-smoothing: auto;
      -moz-osx-font-smoothing: auto;
      outline-offset: -4px;
      background-color: #000;
      outline: 2px solid #0000;
      line-height: 1.5;
      transition-property: outline-offset, outline-color;
      transition-duration: 0.1s;
      transition-timing-function: ease-out;
      display: block;
      position: relative;
      overflow: hidden;
      container: media-root / inline-size;
    }

    .media-container:before,
    :scope.media-container:before {
      pointer-events: none;
      background-image: var(--media-poster-placeholder, none);
      background-size: var(--media-object-fit, contain);
      background-position: var(--media-object-position, center);
      opacity: 0;
      filter: blur(var(--media-poster-placeholder-blur, 20px));
      content: '';
      background-repeat: no-repeat;
      transition-property: opacity;
      transition-duration: 0.25s;
      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
      position: absolute;
      inset: 0;
    }

    .media-container:after,
    :scope.media-container:after {
      pointer-events: none;
      z-index: 10;
      border-radius: inherit;
      content: '';
      box-shadow:
        0 0 #0000,
        0 0 #0000,
        0 0 #0000,
        0 0 #0000,
        inset 0 0 0 1px var(--media-border-color);
      position: absolute;
      inset: 0;
    }

    .media-container:focus-visible,
    :scope.media-container:focus-visible {
      outline-offset: 2px;
      outline-color: var(--media-focus-ring-color);
    }

    .media-container:has(:is(img[data-visible]:not([data-loaded]))):before,
    :scope.media-container:has(:is(img[data-visible]:not([data-loaded]))):before {
      content: '';
      opacity: 1;
    }

    @media (pointer: fine) {
      .media-container:has([data-controls]:not([data-visible])),
      :scope.media-container:has([data-controls]:not([data-visible])) {
        cursor: none;
      }
    }

    .media-container video,
    :scope.media-container video {
      border-radius: inherit;
      object-fit: var(--media-object-fit, contain);
      object-position: var(--media-object-position, center);
      width: 100%;
      height: 100%;
      display: block;
    }

    .media-container:fullscreen,
    :scope.media-container:fullscreen {
      --media-container-border-radius: 0;
    }

    .media-container:fullscreen:after,
    :scope.media-container:fullscreen:after {
      content: '';
      display: none;
    }

    @media (width >= 1280px) {
      .media-container:fullscreen,
      :scope.media-container:fullscreen {
        --media-scale: 1.25;
      }
    }

    @media (width >= 1536px) {
      .media-container:fullscreen,
      :scope.media-container:fullscreen {
        --media-scale: 1.5;
      }
    }

    @media (width >= 1920px) {
      .media-container:fullscreen,
      :scope.media-container:fullscreen {
        --media-scale: 1.75;
      }
    }

    .media-container:fullscreen video,
    :scope.media-container:fullscreen video {
      object-fit: contain;
    }
  }
