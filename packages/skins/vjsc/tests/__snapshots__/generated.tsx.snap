/** @jsxImportSource vjsc/html-runtime */
import type { MenuProps } from '@videojs/core';
import { settingsText } from '@videojs/core/i18n/text/menu';


import { type PropsWithChildren } from "vjsc/components";




import "virtual:vjsc/css/bedd34a0f91c/base.css";
import "virtual:vjsc/css/447c10d89d45/buttons.css";
import "virtual:vjsc/css/c1eba693c971/menus.css";
import "virtual:vjsc/css/8aa944d6bb10/popups.css";
import "@videojs/html/i18n";
import "@videojs/html/icons/element/minimal";
import "@videojs/html/ui/menu";
import "@videojs/html/ui/tooltip";
import { Scope } from "vjsc/html-runtime/jsx-runtime";




export function SettingsMenu({ children, className, ...props }: PropsWithChildren<MenuProps>) {
  return (
    <Scope prefix="<module>-i5"><><button commandfor="__vjsc-id-<module>-i5-popup" class={["media-button", "media-settings-trigger"]}>
            <media-icon family="minimal" name="gear" class={["media-button-icon", "media-settings-icon"]} />
            <media-text class={"media-sr-only"} token={settingsText.key}>
              {settingsText.text}
            </media-text>
          </button><media-menu id="__vjsc-id-<module>-i5-popup" side="top" align="center" {...props} class={["media-surface", "media-popover", "media-settings", className]}>
        <media-menu-content className={"media-menu-content"}>{children}</media-menu-content>
      </media-menu></></Scope>
  );
}

// ===== html/minimal-video/css/components/menus/submenu.tsx =====
/** @jsxImportSource vjsc/html-runtime */
import type { MenuProps } from '@videojs/core';

import { type PropsWithChildren, type VjscNode } from "vjsc/components";


import { MenuChevron } from './menu-chevron';
import "virtual:vjsc/css/bedd34a0f91c/base.css";
import "virtual:vjsc/css/a1a61f523219/menus.css";
import "@videojs/html/ui/menu";
import { Scope } from "vjsc/html-runtime/jsx-runtime";



export function Submenu({
  children,
  icon,
  label,
  selectedLabel,
  className,
  ...props
}: PropsWithChildren<
  MenuProps & {
    icon: VjscNode;
    label: VjscNode;
    selectedLabel: VjscNode;
  }
>) {
  return (
    <Scope prefix="<module>-gb"><><media-menu-item commandfor="__vjsc-id-<module>-gb-content" class={["media-menu-item", "media-item"]}>
        {icon}
        {label}
        <span class={"media-hint"}>
          {selectedLabel}
          <MenuChevron />
        </span>
      </media-menu-item><media-menu-content id="__vjsc-id-<module>-gb-content" class={["media-submenu-panel", className]}>
        <media-menu-item className={["media-menu-item", "media-back"]}>
          <MenuChevron flipped />
          {label}
        </media-menu-item>
        <media-menu-separator className={"media-separator"} />
        {children}
      </media-menu-content></></Scope>
  );
}

