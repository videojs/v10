    <TimeSliderPrimitive.Root className={state => cn("media-slider", "media-time-slider", resolveClassName(className, state))} {...props}>
      <TimeSliderPrimitive.Chapters className={"media-time-slider-chapters"} renderChapter={(props) => (<div className={"media-time-slider-chapter"}>
          <TimeSliderPrimitive.Track className={cn("media-slider-track", "media-time-slider-chapter-track")}>
            <TimeSliderPrimitive.Buffer className={"media-slider-buffer"} />
            <TimeSliderPrimitive.Fill className={"media-slider-fill"} />
          </TimeSliderPrimitive.Track>
        </div>)}>

      </TimeSliderPrimitive.Chapters>
