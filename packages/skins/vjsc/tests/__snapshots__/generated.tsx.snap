          <><span class="contents theme-minimal:hidden"><media-icon name="gear" class={["media-button-icon", "media-settings-menu-trigger-icon"]} /></span><span class="hidden theme-minimal:contents"><media-icon family="minimal" name="gear" class={["media-button-icon", "media-settings-menu-trigger-icon"]} /></span></>
