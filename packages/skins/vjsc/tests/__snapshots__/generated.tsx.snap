const available = audioTrack?.state.availability === 'available';

  return (
    available && <Submenu
      icon={<SpeechIconPrimitive className={"media-menu-trigger-item-icon"} />}
      label={<TextPrimitive token={audioText.key}>{audioText.text}</TextPrimitive>}
      selectedLabel={<span className={"media-menu-hint-label"} data-part="hint">{audioTrack?.selectedLabel}</span>}
      {...props}
    >
      <AudioTrackRadioGroup renderItem={(props, item) => (<RadioItem {...props}>
            <span>{item.label}</span>
          </RadioItem>)}>

      </AudioTrackRadioGroup>
    </Submenu>
  );
}

