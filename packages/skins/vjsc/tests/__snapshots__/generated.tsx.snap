// ===== react/default-video/css/components/buttons/airplay-button.tsx =====
/** @jsxImportSource react */








import { Button } from './button';
import { ButtonTooltip } from './button-tooltip';
import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/buttons.css";
import { AirPlayButton as AirPlayButtonPrimitive } from "@videojs/react";
import { AirPlayEnterIcon as AirPlayEnterIconPrimitive, AirPlayExitIcon as AirPlayExitIconPrimitive } from "@videojs/react/icons";
import { AirPlayEnterIcon as AirPlayEnterIconPrimitive2, AirPlayExitIcon as AirPlayExitIconPrimitive2 } from "@videojs/react/icons/minimal";
import { cn, resolveClassName } from "@videojs/utils/style";





export type AirPlayButtonProps = Omit<AirPlayButtonPrimitive.Props, "children">;
export function AirPlayButton({ className, ...props }: AirPlayButtonProps = {}) {
  return (
    <ButtonTooltip side="top">
      <AirPlayButtonPrimitive render={<Button />} className={state => cn("media-airplay-button", resolveClassName(className, state))} {...props}>
        <><span className="contents theme-minimal:hidden"><AirPlayEnterIconPrimitive className={cn("media-button-icon", "media-airplay-button-enter-icon")} /></span><span className="hidden theme-minimal:contents"><AirPlayEnterIconPrimitive2 className={cn("media-button-icon", "media-airplay-button-enter-icon")} /></span></>
        <><span className="contents theme-minimal:hidden"><AirPlayExitIconPrimitive className={cn("media-button-icon", "media-airplay-button-exit-icon")} /></span><span className="hidden theme-minimal:contents"><AirPlayExitIconPrimitive2 className={cn("media-button-icon", "media-airplay-button-exit-icon")} /></span></>
      </AirPlayButtonPrimitive>
    </ButtonTooltip>
  );
}

// ===== react/default-video/css/components/buttons/button-tooltip.tsx =====
/** @jsxImportSource react */






import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/popups.css";
import { Tooltip } from "@videojs/react";

import type { ReactElement, ReactNode } from "react";



export interface ButtonTooltipProps extends Tooltip.RootProps {
children: ReactElement; label?: ReactNode
}
export function ButtonTooltip({
  children,
  label,
  ...props
}: ButtonTooltipProps) {
  return (
    <Tooltip.Root {...props}>
      <Tooltip.Trigger render={children} />
      <Tooltip.Popup className={"media-tooltip"}>
        {label ?? <Tooltip.Label />}
        {!label && <Tooltip.Shortcut className={"media-tooltip-shortcut"} />}
      </Tooltip.Popup>
    </Tooltip.Root>
  );
}

// ===== react/default-video/css/components/buttons/button.tsx =====
import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/buttons.css";
import type { ComponentProps } from "react";
import { cn } from "@videojs/utils/style";




/** Shared button carrying the base interactive styles used by media controls. */
export type ButtonProps = ComponentProps<"button">;

export function Button({ className, ...props }: ButtonProps) {
  return <button className={cn("media-button", className)} {...props} />;
}

