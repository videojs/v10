import "virtual:vjsc/css/75c8a3310f3d/indicator.css";
import "@videojs/html/icons/element/minimal";
import "@videojs/html/ui/status-indicator-value";
import "@videojs/html/ui/status-indicator";



const TOP_STATUS_ACTIONS = ['toggleSubtitles', 'toggleFullscreen', 'togglePictureInPicture'] as const;

const PLAYBACK_STATUS_ACTIONS = ['togglePaused'] as const;

export function StatusIndicator({ className, ...props }: Props<Omit<CoreProps, 'actions'>> = {}) {
  return (
    <media-status-indicator actions={TOP_STATUS_ACTIONS} className={["media-status-indicator", className]} {...props}>
      <media-icon family="minimal" name="captions-on" class={["media-status-indicator-icon", "media-status-captions-on-icon"]} />
      <media-icon family="minimal" name="captions-off" class={["media-status-indicator-icon", "media-status-captions-off-icon"]} />
      <media-icon family="minimal" name="fullscreen-enter" class={["media-status-indicator-icon", "media-status-fullscreen-enter-icon"]} />
      <media-icon family="minimal" name="fullscreen-exit" class={["media-status-indicator-icon", "media-status-fullscreen-exit-icon"]} />
      <media-icon family="minimal" name="pip-enter" class={["media-status-indicator-icon", "media-status-pip-enter-icon"]} />
      <media-icon family="minimal" name="pip-exit" class={["media-status-indicator-icon", "media-status-pip-exit-icon"]} />
      <media-status-indicator-value className={"media-status-indicator-value"} />
    </media-status-indicator>
  );
}

export function PlaybackStatusIndicator({ className, ...props }: Props<Omit<CoreProps, 'actions'>> = {}) {
  return (
    <media-status-indicator actions={PLAYBACK_STATUS_ACTIONS} className={["media-playback-status-indicator", className]} {...props}>
      <media-icon family="minimal" name="play" class={["media-playback-status-icon", "media-status-play-icon"]} />
      <media-icon family="minimal" name="pause" class={["media-playback-status-icon", "media-status-pause-icon"]} />
    </media-status-indicator>
  );
}

