export interface AudioSettingsMenuProps extends MenuProps {
  className?: Props<MenuProps>['className'];
}

export function AudioSettingsMenu({ className, ...props }: AudioSettingsMenuProps = {}) {
  return (
    <Scope prefix="<module>-kw"><><ButtonTooltip label={<media-text token={speedText.key}>{speedText.text}</media-text>} side="top">
          <media-playback-rate-button commandfor="__vjsc-id-<module>-kw-popup" />
        </ButtonTooltip><media-menu id="__vjsc-id-<module>-kw-popup" side="top" align="center" boundary="viewport" {...props} class={["media-menu-popup", className]}>
          <media-menu-content className={"media-menu-content"}>
            <media-playback-rate-radio-group className={"media-menu-radio-group"}>
