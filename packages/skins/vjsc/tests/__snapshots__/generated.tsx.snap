// ===== react/default-video/tailwind/components/buttons/airplay-button.tsx =====
/** @jsxImportSource react */








import { Button } from './button';
import { ButtonTooltip } from './button-tooltip';
import { AirPlayButton as AirPlayButtonPrimitive } from "@videojs/react";
import { AirPlayEnterIcon as AirPlayEnterIconPrimitive, AirPlayExitIcon as AirPlayExitIconPrimitive } from "@videojs/react/icons";
import { AirPlayEnterIcon as AirPlayEnterIconPrimitive2, AirPlayExitIcon as AirPlayExitIconPrimitive2 } from "@videojs/react/icons/minimal";
import { cn, resolveClassName } from "@videojs/utils/style";




export type AirPlayButtonProps = Omit<AirPlayButtonPrimitive.Props, "children">;
export function AirPlayButton({ className, ...props }: AirPlayButtonProps = {}) {
  return (
    <ButtonTooltip side="top">
      <AirPlayButtonPrimitive render={<Button />} className={state => cn("group/airplay", "not-data-[airplay-state=connected]:[--media-icon-airplay-fill-animation:none]", "not-data-[airplay-state=connected]:[--media-icon-airplay-triangle-animation:none]", "motion-reduce:[--media-icon-airplay-fill-animation:none]", "motion-reduce:[--media-icon-airplay-triangle-animation:none]", resolveClassName(className, state))} {...props}>
        <><span className="contents theme-minimal:hidden"><AirPlayEnterIconPrimitive className={cn("col-start-1 row-start-1 size-media-icon drop-shadow-[0_1px_0_var(--media-shadow-current-color)]", "transition-[opacity,scale] duration-150 ease-out", "motion-reduce:transition-opacity motion-reduce:duration-50", "opacity-0 group-not-data-[airplay-state=connected]/airplay:scale-100", "group-not-data-[airplay-state=connected]/airplay:opacity-100")} /></span><span className="hidden theme-minimal:contents"><AirPlayEnterIconPrimitive2 className={cn("col-start-1 row-start-1 size-media-icon drop-shadow-[0_1px_0_var(--media-shadow-current-color)]", "transition-[opacity,scale] duration-150 ease-out", "motion-reduce:transition-opacity motion-reduce:duration-50", "opacity-0 group-not-data-[airplay-state=connected]/airplay:scale-100", "group-not-data-[airplay-state=connected]/airplay:opacity-100")} /></span></>
        <><span className="contents theme-minimal:hidden"><AirPlayExitIconPrimitive className={cn("col-start-1 row-start-1 size-media-icon drop-shadow-[0_1px_0_var(--media-shadow-current-color)]", "transition-[opacity,scale] duration-150 ease-out", "motion-reduce:transition-opacity motion-reduce:duration-50", "opacity-0 group-data-[airplay-state=connected]/airplay:scale-100", "group-data-[airplay-state=connected]/airplay:opacity-100")} /></span><span className="hidden theme-minimal:contents"><AirPlayExitIconPrimitive2 className={cn("col-start-1 row-start-1 size-media-icon drop-shadow-[0_1px_0_var(--media-shadow-current-color)]", "transition-[opacity,scale] duration-150 ease-out", "motion-reduce:transition-opacity motion-reduce:duration-50", "opacity-0 group-data-[airplay-state=connected]/airplay:scale-100", "group-data-[airplay-state=connected]/airplay:opacity-100")} /></span></>
      </AirPlayButtonPrimitive>
    </ButtonTooltip>
  );
}

// ===== react/default-video/tailwind/components/buttons/button-tooltip.tsx =====
/** @jsxImportSource react */





import { Tooltip } from "@videojs/react";

import type { ReactElement, ReactNode } from "react";



export interface ButtonTooltipProps extends Tooltip.RootProps {
children: ReactElement; label?: ReactNode
}
export function ButtonTooltip({
  children,
  label,
  ...props
}: ButtonTooltipProps) {
  return (
    <Tooltip.Root {...props}>
      <Tooltip.Trigger render={children} />
