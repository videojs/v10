// ===== html/default-video/css/components/buttons/button-tooltip.tsx =====
/** @jsxImportSource vjsc/html-runtime */
import type { TooltipProps } from '@videojs/core';

import type { PropsWithChildren, VjscElement, VjscNode } from 'vjsc/components';



import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/popups.css";
import "@videojs/html/ui/tooltip";
import { Host, Scope } from "vjsc/html-runtime/jsx-runtime";



export function ButtonTooltip({
  children,
  label,
  ...props
}: PropsWithChildren<TooltipProps> & { children: VjscElement; label?: VjscNode }) {
  return (
    <Scope prefix="<module>-ev"><><Host id="__vjsc-id-<module>-ev-trigger">{children}</Host><media-tooltip trigger="__vjsc-id-<module>-ev-trigger" {...props} class={"media-tooltip"}>
        {label ?? <media-tooltip-label />}
        {!label && <media-tooltip-shortcut className={"media-tooltip-shortcut"} />}
      </media-tooltip></></Scope>
  );
}

