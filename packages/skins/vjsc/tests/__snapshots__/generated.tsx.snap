// ===== react/default-video/css/components/buttons/airplay-button.tsx =====
/** @jsxImportSource react */








import { ButtonTooltip } from './button-tooltip';
import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/buttons.css";
import { AirPlayButton as AirPlayButtonPrimitive } from "@videojs/react";
import { AirPlayEnterIcon as AirPlayEnterIconPrimitive, AirPlayExitIcon as AirPlayExitIconPrimitive } from "@videojs/react/icons";
import { cn, resolveClassName } from "@videojs/utils/style";





export interface AirPlayButtonProps extends Omit<AirPlayButtonPrimitive.Props, "children"> {}
export function AirPlayButton({ className, ...props }: AirPlayButtonProps = {}) {
  return (
    <ButtonTooltip side="top">
      <AirPlayButtonPrimitive className={state => cn("media-button", "media-airplay-button", resolveClassName(className, state))} {...props}>
        <AirPlayEnterIconPrimitive className={cn("media-button-icon", "media-airplay-button-enter-icon")} />
        <AirPlayExitIconPrimitive className={cn("media-button-icon", "media-airplay-button-exit-icon")} />
      </AirPlayButtonPrimitive>
    </ButtonTooltip>
  );
}

// ===== react/default-video/css/components/buttons/button-tooltip.tsx =====
/** @jsxImportSource react */








import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/common.css";
import "virtual:vjsc/css/<hash>/popups.css";
import { Tooltip } from "@videojs/react";

import type { ReactElement } from "react";
import { cn } from "@videojs/utils/style";




export interface ButtonTooltipProps extends Tooltip.Root.RootProps {
children: ReactElement
}
export function ButtonTooltip({ children, ...props }: ButtonTooltipProps) {
  return (
    <Tooltip.Root {...props}>
      <Tooltip.Trigger render={children} />
      <Tooltip.Popup className={cn("media-popup", "media-popup-transition", "media-surface", "media-tooltip")}>
        <Tooltip.Label />
        <Tooltip.Shortcut className={"media-tooltip-shortcut"} />
      </Tooltip.Popup>
    </Tooltip.Root>
  );
}

