registerIcons("default", { "speed": speedIcon });



export interface PlaybackRateSubmenuProps extends MenuProps {
  className?: Props<MenuProps>['className'];
}

export function PlaybackRateSubmenu({ className, ...props }: PlaybackRateSubmenuProps = {}) {
  return (
    <Scope prefix="<module>-la"><><media-menu-item commandfor="__vjsc-id-<module>-la-content" class={"media-menu-trigger-item"}>
          <media-icon name="speed" class={"media-menu-trigger-item-icon"} />
          <media-text token={speedText.key}>{speedText.text}</media-text>
          <span class={"media-menu-hint"}>
            <span data-part="value" class={"media-menu-hint-label"} />
            <MenuChevron />
          </span>
        </media-menu-item><media-menu-content id="__vjsc-id-<module>-la-content" class={["media-menu-content", className]}>
          <media-menu-item className={"media-menu-back-item"}>
            <MenuChevron back />
            <media-text token={speedText.key}>{speedText.text}</media-text>
          </media-menu-item>
          <media-menu-separator className={"media-menu-separator"} />
          <media-playback-rate-radio-group className={"media-menu-radio-group"}>
            <template>
              <RadioItem>
                <span data-part="label" />
              </RadioItem>
            </template>
          </media-playback-rate-radio-group>
        </media-menu-content></></Scope>
  );
}
