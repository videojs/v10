            <GearIconPrimitive className={cn("media-button-icon", "media-settings-icon")} />
            <TextPrimitive className={"media-sr-only"} token={settingsText.key}>
              {settingsText.text}
            </TextPrimitive>
          </Menu.Trigger>} />
        <Tooltip.Popup className={cn("media-surface", "media-tooltip")}>
          <TextPrimitive token={settingsText.key}>{settingsText.text}</TextPrimitive>
