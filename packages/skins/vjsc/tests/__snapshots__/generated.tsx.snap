import "@videojs/html/icons/element/minimal";
import "@videojs/html/ui/status-indicator-value";
import "@videojs/html/ui/status-indicator";



const TOP_STATUS_ACTIONS = ['toggleSubtitles', 'toggleFullscreen', 'togglePictureInPicture'] as const;

const PLAYBACK_STATUS_ACTIONS = ['togglePaused'] as const;

export function StatusIndicator({ className, ...props }: Props<Omit<CoreProps, 'actions'>> = {}) {
  return (
    <media-status-indicator
      actions={TOP_STATUS_ACTIONS}
      className={["media-feedback-surface", "media-status-indicator", className]}
      {...props}
    >
      <div className={"media-status-indicator-content"}>
        <media-icon family="minimal" name="captions-on" class={"media-status-indicator-captions-on-icon"} />
        <media-icon family="minimal" name="captions-off" class={"media-status-indicator-captions-off-icon"} />
        <media-icon family="minimal" name="fullscreen-enter" class={"media-status-indicator-fullscreen-enter-icon"} />
        <media-icon family="minimal" name="fullscreen-exit" class={"media-status-indicator-fullscreen-exit-icon"} />
        <media-icon family="minimal" name="pip-enter" class={"media-status-indicator-pip-enter-icon"} />
        <media-icon family="minimal" name="pip-exit" class={"media-status-indicator-pip-exit-icon"} />
        <media-status-indicator-value className={"media-status-indicator-value"} />
      </div>
    </media-status-indicator>
  );
}

export function PlaybackStatusIndicator({ className, ...props }: Props<Omit<CoreProps, 'actions'>> = {}) {
  return (
