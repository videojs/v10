          <media-controls-group className={"media-controls-end"}>
            <CaptionsButton />
            <VideoSettingsMenu />
            <media-controls-group className={"media-controls-trailing"}>
              <CastButton />
              <AirPlayButton />
              <PiPButton />
              <FullscreenButton />
            </media-controls-group>
          </media-controls-group>
        </media-tooltip-group>
      </media-controls-content>
