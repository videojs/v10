export function MinimalVideoControls() {
  return (
    <media-controls>
      <media-controls-backdrop className={"media-controls__backdrop"} />
      <media-controls-content className={['media-controls', "media-controls"]}>
        <media-tooltip-group>
          <media-controls-group className={"media-controls-start"}>
            <PlayButton />
            <VolumePopover showTooltip side="right" orientation="horizontal" />
          </media-controls-group>

          <media-controls-group className={"media-time-slider-group"}>
