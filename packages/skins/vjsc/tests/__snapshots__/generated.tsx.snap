// ===== html/minimal-audio/css/skins/minimal-audio/controls.tsx =====
/** @jsxImportSource vjsc/html-runtime */


import { SeekButton } from '../../components/buttons/seek-button';
import { VolumePopover } from '../../components/controls/volume-popover';
import { AudioPlayButton } from '../audio/play-button';
import { AudioSettingsMenu } from '../audio/settings-menu';
import { AudioTimeSlider } from '../audio/time-slider';


import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/controls.css";
import "virtual:vjsc/css/<hash>/popups.css";
import "@videojs/html/ui/controls-group";
import "@videojs/html/ui/time";
import "@videojs/html/ui/time-separator";
import "@videojs/html/ui/time-group";
import "@videojs/html/ui/tooltip-group";
import "@videojs/html/ui/controls-content";
import "@videojs/html/ui/controls";



export function MinimalAudioControls() {
  return (
    <media-controls visibility="always">
      <media-controls-content className={['media-controls', "media-controls-content"]}>
        <media-tooltip-group>
          <media-controls-group className={"media-controls-start"}>
            <AudioPlayButton />
            <SeekButton seconds={-10} />
            <SeekButton seconds={10} />
          </media-controls-group>

          <media-controls-group className={"media-time-slider-group"}>
            <media-time-group className={"media-time-group"}>
              <media-time className={"media-time-current-value"} type="current" toggle />
              <media-time-separator className={"media-time-separator"} />
              <media-time className={"media-time-duration-value"} type="duration" />
            </media-time-group>
            <AudioTimeSlider />
          </media-controls-group>

          <media-controls-group className={"media-controls-end"}>
            <VolumePopover
              popupClassName={"media-audio-volume-popover"}
              showTooltip
              side="left"
              orientation="horizontal"
            />
            <AudioSettingsMenu />
          </media-controls-group>
        </media-tooltip-group>
      </media-controls-content>
    </media-controls>
  );
}

