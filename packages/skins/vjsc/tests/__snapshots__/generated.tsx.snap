import { SeekIcon as SeekIconPrimitive } from "@videojs/react/icons";
import { cn, resolveClassName } from "@videojs/utils/style";




export interface SeekButtonProps extends Omit<SeekButtonPrimitive.Props, "children"> {}
export function SeekButton({ className, seconds = 10, ...props }: SeekButtonProps = {}) {
  return (
    <ButtonTooltip side="top">
      <SeekButtonPrimitive render={<Button />} className={state => cn("", resolveClassName(className, state))} seconds={seconds} {...props}>
        <SeekIconPrimitive className={cn("col-start-1 row-start-1 size-media-icon drop-shadow-[0_1px_0_var(--media-shadow-current-color)]", "transition-[opacity,scale] duration-150 ease-out", "motion-reduce:transition-opacity motion-reduce:duration-50", seconds < 0 && "-scale-x-100")} />
        <span className={cn("absolute bottom-[-3px] text-[0.715em] font-medium tracking-[-0.05em] tabular-nums", seconds < 0 ? "left-[-1px]" : "right-[-1px]")}>
          {Math.abs(seconds)}
