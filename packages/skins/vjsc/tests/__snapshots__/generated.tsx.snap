import type { SliderPreviewOverflow, TimeSliderProps as CoreProps } from '@videojs/core';






import { SliderBuffer, SliderFill, SliderThumb, SliderTrack } from './slider';
import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/sliders.css";
import { TimeSlider } from "@videojs/react";
import { cn, resolveClassName } from "@videojs/utils/style";




interface AudioTimeSliderProps extends CoreProps {
  previewOverflow?: SliderPreviewOverflow | undefined;
}

export interface AudioTimeSliderProps extends Omit<TimeSlider.Root.RootProps, "children"> {}
export function AudioTimeSlider({
  className,
  previewOverflow = 'visible',
  ...props
}: AudioTimeSliderProps = {}) {
  return (
    <TimeSlider.Root className={state => cn("media-slider", "media-audio-time-slider", resolveClassName(className, state))} {...props}>
      <TimeSlider.Track render={<SliderTrack />}>
        <TimeSlider.Buffer render={<SliderBuffer />} />
        <TimeSlider.Fill render={<SliderFill />} />
      </TimeSlider.Track>
      <TimeSlider.Thumb render={<SliderThumb />} />
      <TimeSlider.Preview className={"media-slider-preview"} overflow={previewOverflow}>
        <div className={"media-audio-time-slider-preview-content"}>
          <TimeSlider.Value className={"media-audio-time-slider-value"} type="pointer" />
        </div>
