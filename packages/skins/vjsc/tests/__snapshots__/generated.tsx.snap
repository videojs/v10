import { captionsOffIcon as captionsOffIconPrimitive, captionsOnIcon as captionsOnIconPrimitive, fullscreenEnterIcon as fullscreenEnterIconPrimitive, fullscreenExitIcon as fullscreenExitIconPrimitive, pauseIcon as pauseIconPrimitive, pipEnterIcon as pipEnterIconPrimitive, pipExitIcon as pipExitIconPrimitive, playIcon as playIconPrimitive } from "@videojs/html/icons/minimal";
import "@videojs/html/ui/status-indicator-value";
import "@videojs/html/ui/status-indicator";

registerIcons("default", { "captions-off": captionsOffIcon, "captions-on": captionsOnIcon, "fullscreen-enter": fullscreenEnterIcon, "fullscreen-exit": fullscreenExitIcon, "pause": pauseIcon, "pip-enter": pipEnterIcon, "pip-exit": pipExitIcon, "play": playIcon });
registerIcons("minimal", { "captions-off": captionsOffIconPrimitive, "captions-on": captionsOnIconPrimitive, "fullscreen-enter": fullscreenEnterIconPrimitive, "fullscreen-exit": fullscreenExitIconPrimitive, "pause": pauseIconPrimitive, "pip-enter": pipEnterIconPrimitive, "pip-exit": pipExitIconPrimitive, "play": playIconPrimitive });



const TOP_STATUS_ACTIONS = ['toggleSubtitles', 'toggleFullscreen', 'togglePictureInPicture'] as const;

const PLAYBACK_STATUS_ACTIONS = ['togglePaused'] as const;

export function StatusIndicator({ className, ...props }: Props<Omit<CoreProps, 'actions'>> = {}) {
  return (
    <media-status-indicator actions={TOP_STATUS_ACTIONS} className={["media-status-indicator", className]} {...props}>
      <div className={"media-status-indicator-content"}>
        <><span class="contents theme-minimal:hidden"><media-icon name="captions-on" class={"media-status-indicator-captions-on-icon"} /></span><span class="hidden theme-minimal:contents"><media-icon family="minimal" name="captions-on" class={"media-status-indicator-captions-on-icon"} /></span></>
        <><span class="contents theme-minimal:hidden"><media-icon name="captions-off" class={"media-status-indicator-captions-off-icon"} /></span><span class="hidden theme-minimal:contents"><media-icon family="minimal" name="captions-off" class={"media-status-indicator-captions-off-icon"} /></span></>
        <><span class="contents theme-minimal:hidden"><media-icon name="fullscreen-enter" class={"media-status-indicator-fullscreen-enter-icon"} /></span><span class="hidden theme-minimal:contents"><media-icon family="minimal" name="fullscreen-enter" class={"media-status-indicator-fullscreen-enter-icon"} /></span></>
        <><span class="contents theme-minimal:hidden"><media-icon name="fullscreen-exit" class={"media-status-indicator-fullscreen-exit-icon"} /></span><span class="hidden theme-minimal:contents"><media-icon family="minimal" name="fullscreen-exit" class={"media-status-indicator-fullscreen-exit-icon"} /></span></>
        <><span class="contents theme-minimal:hidden"><media-icon name="pip-enter" class={"media-status-indicator-pip-enter-icon"} /></span><span class="hidden theme-minimal:contents"><media-icon family="minimal" name="pip-enter" class={"media-status-indicator-pip-enter-icon"} /></span></>
        <><span class="contents theme-minimal:hidden"><media-icon name="pip-exit" class={"media-status-indicator-pip-exit-icon"} /></span><span class="hidden theme-minimal:contents"><media-icon family="minimal" name="pip-exit" class={"media-status-indicator-pip-exit-icon"} /></span></>
        <media-status-indicator-value className={"media-status-indicator-value"} />
      </div>
    </media-status-indicator>
  );
}

export function PlaybackStatusIndicator({ className, ...props }: Props<Omit<CoreProps, 'actions'>> = {}) {
  return (
    <media-status-indicator actions={PLAYBACK_STATUS_ACTIONS} className={["media-playback-status-indicator", className]} {...props}>
      <><span class="contents theme-minimal:hidden"><media-icon name="play" class={"media-playback-status-indicator-play-icon"} /></span><span class="hidden theme-minimal:contents"><media-icon family="minimal" name="play" class={"media-playback-status-indicator-play-icon"} /></span></>
      <><span class="contents theme-minimal:hidden"><media-icon name="pause" class={"media-playback-status-indicator-pause-icon"} /></span><span class="hidden theme-minimal:contents"><media-icon family="minimal" name="pause" class={"media-playback-status-indicator-pause-icon"} /></span></>
    </media-status-indicator>
  );
}

