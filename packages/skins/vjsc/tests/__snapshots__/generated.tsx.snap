// ===== html/minimal-video/css/components/video-gestures.tsx =====
/** @jsxImportSource vjsc/html-runtime */



import "@videojs/html/ui/gesture";


export interface VideoGesturesProps {
  disabled?: boolean | undefined;
}

export function VideoGestures({ disabled = false }: VideoGesturesProps = {}) {
  return (
    <>
      <media-gesture disabled={disabled} type="tap" action="togglePaused" pointer="mouse" region="center" />
      <media-gesture disabled={disabled} type="tap" action="toggleControls" pointer="touch" />
      <media-gesture disabled={disabled} type="doubletap" action="seekStep" value={-10} region="left" />
      <media-gesture disabled={disabled} type="doubletap" action="toggleFullscreen" region="center" />
      <media-gesture disabled={disabled} type="doubletap" action="seekStep" value={10} region="right" />
    </>
  );
}

// ===== html/minimal-video/css/components/video-hotkeys.tsx =====
/** @jsxImportSource vjsc/html-runtime */



import "@videojs/html/ui/hotkey";


export interface VideoHotkeysProps {
  disabled?: boolean | undefined;
}

export function VideoHotkeys({ disabled = false }: VideoHotkeysProps = {}) {
  return (
    <>
      <media-hotkey disabled={disabled} keys="Space" action="togglePaused" />
      <media-hotkey disabled={disabled} keys="k" action="togglePaused" />
      <media-hotkey disabled={disabled} keys="m" action="toggleMuted" />
      <media-hotkey disabled={disabled} keys="f" action="toggleFullscreen" />
      <media-hotkey disabled={disabled} keys="c" action="toggleSubtitles" />
      <media-hotkey disabled={disabled} keys="i" action="togglePictureInPicture" />
      <media-hotkey disabled={disabled} keys="ArrowRight" action="seekStep" value={5} />
      <media-hotkey disabled={disabled} keys="ArrowLeft" action="seekStep" value={-5} />
      <media-hotkey disabled={disabled} keys="l" action="seekStep" value={10} />
      <media-hotkey disabled={disabled} keys="j" action="seekStep" value={-10} />
      <media-hotkey disabled={disabled} keys="ArrowUp" action="volumeStep" value={0.05} />
      <media-hotkey disabled={disabled} keys="ArrowDown" action="volumeStep" value={-0.05} />
      <media-hotkey disabled={disabled} keys="0-9" action="seekToPercent" />
      <media-hotkey disabled={disabled} keys="Home" action="seekToPercent" value={0} />
      <media-hotkey disabled={disabled} keys="End" action="seekToPercent" value={100} />
      <media-hotkey disabled={disabled} keys=">" action="speedUp" />
      <media-hotkey disabled={disabled} keys="<" action="speedDown" />
    </>
  );
}

