    <>
      <StatusAnnouncer />
      <div className={cn("pointer-events-none absolute inset-0 grid grid-cols-3 items-center justify-items-center text-white", className)} {...props}>
        <VolumeIndicator />
        <StatusIndicator />
        <SeekIndicator />
        <PlaybackStatusIndicator />
      </div>
    </>
  );
}

