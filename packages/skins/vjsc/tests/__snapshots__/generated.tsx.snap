import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/popups.css";
import "@videojs/html/ui/volume-popover";
import { Scope } from "vjsc/html-runtime/jsx-runtime";



export function VolumePopover({
  className,
  showTooltip = false,
  side = 'top',
  orientation = 'vertical',
  ...props
}: Props<
  CoreProps & {
    orientation?: CoreVolumeSliderProps['orientation'];
    showTooltip?: boolean;
  }
> = {}) {
  return (
    <Scope prefix="<module>-n2"><><ButtonTooltip delay={0} disabled={!showTooltip} sticky side="top">

          <MuteButton className={className}  commandfor="__vjsc-id-<module>-n2-popup"/>

      </ButtonTooltip><media-volume-popover id="__vjsc-id-<module>-n2-popup" open-on-hover delay={200} close-delay={100} side={side} {...props} class={"media-volume-popover"}>
        <VolumeSlider orientation={orientation} />
      </media-volume-popover></></Scope>
  );
}

