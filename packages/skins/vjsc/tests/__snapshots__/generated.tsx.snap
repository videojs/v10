export interface DefaultLiveVideoSkinProps extends Omit<NonNullable<ComponentProps<typeof Container>>, 'children'> {
  children?: ReactNode;
  poster?: string | NonNullable<ComponentProps<typeof Poster>>['children'];
}

export function DefaultLiveVideoSkin({ children, className, poster, ...props }: DefaultLiveVideoSkinProps = {}) {
