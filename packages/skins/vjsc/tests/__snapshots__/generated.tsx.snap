}

export function AudioTrackMenu({ className, ...props }: AudioTrackMenuProps = {}) {
  return (
    <Scope prefix="<module>-q8"><><media-menu-item commandfor="__vjsc-id-<module>-q8-content" class={"media-menu-trigger-item"}>
          <><span class="contents theme-minimal:hidden"><media-icon name="speech" class={"media-menu-trigger-item-icon"} /></span><span class="hidden theme-minimal:contents"><media-icon family="minimal" name="speech" class={"media-menu-trigger-item-icon"} /></span></>
          <media-text token={audioText.key}>{audioText.text}</media-text>
          <span class={"media-menu-hint"}>
            <span data-part="value" class={"media-menu-hint-label"} />
            <MenuChevron />
          </span>
        </media-menu-item><media-menu-content id="__vjsc-id-<module>-q8-content" class={["media-menu-content", className]}>
          <media-menu-item className={"media-menu-back-item"}>
            <MenuChevron back />
            <media-text token={audioText.key}>{audioText.text}</media-text>
          </media-menu-item>
          <media-menu-separator className={"media-menu-separator"} />
          <media-audio-track-radio-group className={"media-menu-radio-group"}>
            <template>
              <RadioItem>
                <span data-part="label" />
              </RadioItem>
            </template>
          </media-audio-track-radio-group>
        </media-menu-content></></Scope>
  );
}
