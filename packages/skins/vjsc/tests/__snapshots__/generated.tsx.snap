// ===== react/minimal-video/css/components/menus/audio-settings-menu.tsx =====
/** @jsxImportSource react */
import type { MenuProps } from '@videojs/core';
import { speedText } from '@videojs/core/i18n/text/menu';

import { type Props } from "vjsc/components";



import { ButtonTooltip } from '../buttons/button-tooltip';
import { PlaybackRateButton } from '../buttons/playback-rate-button';
import { RadioItem } from './radio-item';
import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/menus.css";
import { Text as TextPrimitive } from "@videojs/react";
import { Menu } from "@videojs/react";
import { PlaybackRateRadioGroup } from "@videojs/react/ui/playback-rate-radio-group";
import { cn, resolveClassName } from "@videojs/utils/style";





export interface AudioSettingsMenuProps extends MenuProps {
  className?: Props<MenuProps>['className'];
}

export function AudioSettingsMenu({ className, ...props }: AudioSettingsMenuProps = {}) {
  return (
    <Menu.Root side="top" align="center" boundary="viewport" {...props}>
      <PlaybackRateRadioGroup.Root>
        <ButtonTooltip label={<TextPrimitive token={speedText.key}>{speedText.text}</TextPrimitive>} side="top">
          <Menu.Trigger render={<PlaybackRateButton />} />
        </ButtonTooltip>
        <Menu.Popup className={state => cn("media-menu-popup", resolveClassName(className, state))}>
