/** @jsxImportSource vjsc/html-runtime */
import type { MenuProps } from '@videojs/core';
import { speedText } from '@videojs/core/i18n/text/menu';

import { type ClassNameValue } from "vjsc/components";

import { ButtonTooltip } from '../../components/buttons/button-tooltip';

import { RadioItem } from '../../components/menus/radio-item';


import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/menus.css";
import "@videojs/html/i18n";
import "@videojs/html/ui/menu";
import "@videojs/html/ui/playback-rate-radio-group";
import "@videojs/html/ui/playback-rate-button";
import { Scope } from "vjsc/html-runtime/jsx-runtime";




export interface AudioSettingsMenuProps extends MenuProps {
  className?: ClassNameValue;
}

export function AudioSettingsMenu({ className, ...props }: AudioSettingsMenuProps = {}) {
  return (
    <Scope prefix="<module>-k9"><><ButtonTooltip label={<media-text token={speedText.key}>{speedText.text}</media-text>} side="top">
          <media-playback-rate-button commandfor="__vjsc-id-<module>-k9-popup" />
        </ButtonTooltip><media-menu id="__vjsc-id-<module>-k9-popup" side="top" align="center" boundary="viewport" {...props} class={["media-menu-popup", "media-audio-settings-menu-popup", className]}>
          <media-menu-content className={"media-menu-content"}>
            <media-playback-rate-radio-group className={"media-menu-radio-group"}>
              <template>
                <RadioItem>
                  <span data-part="label" />
                </RadioItem>
              </template>
            </media-playback-rate-radio-group>
          </media-menu-content>
        </media-menu></></Scope>
  );
}

