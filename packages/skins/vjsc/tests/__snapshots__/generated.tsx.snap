// ===== react/default-video/css/components/menus/audio-track-menu.tsx =====
/** @jsxImportSource react */
import { audioText } from '@videojs/core/i18n/text/menu';




import { AudioTrackRadioGroup } from './radio-group';
import { RadioItem } from './radio-item';
import { Submenu } from './submenu';
import "virtual:vjsc/css/bedd34a0f91c/base.css";
import "virtual:vjsc/css/de95b39aacc0/menus.css";
import { useAudioTrackOptions } from "@videojs/react";
import type { ComponentProps } from "react";
import { Text as TextPrimitive } from "@videojs/react";
import { SpeechIcon as SpeechIconPrimitive } from "@videojs/react/icons";






export interface AudioTrackMenuProps extends Omit<
  ComponentProps<typeof Submenu>,
  'children' | 'icon' | 'label' | 'selectedLabel'
> {}

export function AudioTrackMenu(props: AudioTrackMenuProps = {}) {
const audioTrack = useAudioTrackOptions();
const available = audioTrack?.state.availability === 'available';

  return (
    available && <Submenu
      icon={<SpeechIconPrimitive className={"media-icon"} />}
      label={<TextPrimitive token={audioText.key}>{audioText.text}</TextPrimitive>}
      selectedLabel={<span className={"media-hint-label"} data-part="hint">{audioTrack?.selectedLabel}</span>}
      {...props}
    >
      <AudioTrackRadioGroup renderItem={(props, item) => (<RadioItem {...props}>
            <span>{item.label}</span>
          </RadioItem>)}>

      </AudioTrackRadioGroup>
    </Submenu>
  );
}

// ===== react/default-video/css/components/menus/captions-menu.tsx =====
/** @jsxImportSource react */
import { captionsText } from '@videojs/core/i18n/text/menu';




import { CaptionsRadioGroup } from './radio-group';
import { RadioItem } from './radio-item';
import { Submenu } from './submenu';
import "virtual:vjsc/css/bedd34a0f91c/base.css";
import "virtual:vjsc/css/de95b39aacc0/menus.css";
import { useCaptionsOptions } from "@videojs/react";
import type { ComponentProps } from "react";
import { Text as TextPrimitive } from "@videojs/react";
import { CaptionsOffIcon as CaptionsOffIconPrimitive } from "@videojs/react/icons";






export interface CaptionsMenuProps extends Omit<
  ComponentProps<typeof Submenu>,
  'children' | 'icon' | 'label' | 'selectedLabel'
> {}

export function CaptionsMenu(props: CaptionsMenuProps = {}) {
const captions = useCaptionsOptions();
const available = captions?.state.availability === 'available';

  return (
    available && <Submenu
      icon={<CaptionsOffIconPrimitive className={"media-icon"} />}
      label={<TextPrimitive token={captionsText.key}>{captionsText.text}</TextPrimitive>}
      selectedLabel={<span className={"media-hint-label"} data-part="hint">{captions?.selectedLabel}</span>}
      {...props}
    >
      <CaptionsRadioGroup renderItem={(props, item) => (<RadioItem {...props}>
            <span>{item.label}</span>
          </RadioItem>)}>

      </CaptionsRadioGroup>
    </Submenu>
  );
}

// ===== react/default-video/css/components/menus/menu-chevron.tsx =====
/** @jsxImportSource react */




import "virtual:vjsc/css/bedd34a0f91c/base.css";
import "virtual:vjsc/css/d1f1f5b2c83b/menus.css";
import type { IconProps } from "@videojs/react/icons";
import { ChevronIcon as ChevronIconPrimitive } from "@videojs/react/icons";
import { cn } from "@videojs/utils/style";





export interface MenuChevronProps extends Omit<IconProps, "children"> {
flipped?: boolean
}
export function MenuChevron({ flipped = false, className, ...props }: MenuChevronProps = {}) {
  return (
    <ChevronIconPrimitive
      className={cn("media-icon", "media-chevron", flipped ? "media-chevron-flipped" : undefined, className)}
