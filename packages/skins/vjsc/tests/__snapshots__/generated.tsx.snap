import { type PropsWithChildren } from "vjsc/components";






import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/buttons.css";
import "virtual:vjsc/css/<hash>/common.css";
import "virtual:vjsc/css/<hash>/menus.css";
import "virtual:vjsc/css/<hash>/popups.css";
import "@videojs/html/i18n";
import "@videojs/html/icons/element/minimal";
import "@videojs/html/ui/menu";
import "@videojs/html/ui/tooltip";
import { Scope } from "vjsc/html-runtime/jsx-runtime";




export function SettingsMenu({ children, className, ...props }: PropsWithChildren<MenuProps>) {
  return (
    <Scope prefix="<module>-jm"><><button commandfor="__vjsc-id-<module>-jm-popup" class={["media-button", "media-settings-menu-trigger"]}>
            <media-icon family="minimal" name="gear" class={["media-button-icon", "media-settings-menu-trigger-icon"]} />
            <media-text class={"media-settings-menu-trigger-label"} token={settingsText.key}>
              {settingsText.text}
            </media-text>
          </button><media-menu id="__vjsc-id-<module>-jm-popup" side="top" align="center" {...props} class={["media-popup", "media-popup-safe-area", "media-surface", "media-menu-popup", className]}>
        <media-menu-content className={"media-menu-content"}>{children}</media-menu-content>
      </media-menu></></Scope>
  );
}

// ===== html/minimal-video/css/components/menus/submenu.tsx =====
/** @jsxImportSource vjsc/html-runtime */
import type { MenuProps } from '@videojs/core';

import { type PropsWithChildren, type VjscNode } from "vjsc/components";


import { MenuChevron } from './menu-chevron';
import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/menus.css";
import "@videojs/html/ui/menu";
import { Scope } from "vjsc/html-runtime/jsx-runtime";



export function Submenu({
  children,
  icon,
  label,
  selectedLabel,
  className,
  ...props
}: PropsWithChildren<MenuProps> & {
  icon: VjscNode;
  label: VjscNode;
  selectedLabel: VjscNode;
}) {
  return (
    <Scope prefix="<module>-fz"><><media-menu-item commandfor="__vjsc-id-<module>-fz-content" class={"media-menu-trigger-item"}>
        {icon}
        {label}
        <span class={"media-menu-hint"}>
          {selectedLabel}
          <MenuChevron />
        </span>
      </media-menu-item><media-menu-content id="__vjsc-id-<module>-fz-content" class={["media-menu-content", className]}>
        <media-menu-item className={"media-menu-back-item"}>
          <MenuChevron back />
          {label}
        </media-menu-item>
        <media-menu-separator className={"media-menu-separator"} />
        {children}
      </media-menu-content></></Scope>
  );
}

