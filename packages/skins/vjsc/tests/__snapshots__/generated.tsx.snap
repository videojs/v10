// ===== html/default-video/css/components/feedback/status-indicator.tsx =====
/** @jsxImportSource vjsc/html-runtime */
import type { StatusIndicatorProps as CoreProps } from '@videojs/core';


import type { Props } from 'vjsc/components';



import "virtual:vjsc/css/bedd34a0f91c/base.css";
import "virtual:vjsc/css/083d58e00aa3/indicator.css";
import "@videojs/html/icons/element";
import "@videojs/html/ui/status-indicator-value";
import "@videojs/html/ui/status-indicator";



const TOP_STATUS_ACTIONS = ['toggleSubtitles', 'toggleFullscreen', 'togglePictureInPicture'] as const;

const PLAYBACK_STATUS_ACTIONS = ['togglePaused'] as const;

export function StatusIndicator({ className, ...props }: Props<Omit<CoreProps, 'actions'>> = {}) {
  return (
    <media-status-indicator actions={TOP_STATUS_ACTIONS} className={["media-status-indicator", className]} {...props}>
      <media-icon name="captions-on" class={["media-status-indicator-icon", "media-status-captions-on-icon"]} />
      <media-icon name="captions-off" class={["media-status-indicator-icon", "media-status-captions-off-icon"]} />
      <media-icon name="fullscreen-enter" class={["media-status-indicator-icon", "media-status-fullscreen-enter-icon"]} />
      <media-icon name="fullscreen-exit" class={["media-status-indicator-icon", "media-status-fullscreen-exit-icon"]} />
      <media-icon name="pip-enter" class={["media-status-indicator-icon", "media-status-pip-enter-icon"]} />
      <media-icon name="pip-exit" class={["media-status-indicator-icon", "media-status-pip-exit-icon"]} />
      <media-status-indicator-value className={"media-status-indicator-value"} />
    </media-status-indicator>
  );
}

export function PlaybackStatusIndicator({ className, ...props }: Props<Omit<CoreProps, 'actions'>> = {}) {
  return (
    <media-status-indicator actions={PLAYBACK_STATUS_ACTIONS} className={["media-playback-status-indicator", className]} {...props}>
