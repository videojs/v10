export interface SettingsMenuProps extends Menu.Root.RootProps {}
export function SettingsMenu({ children, className, ...props }: SettingsMenuProps) {
  return (
    <Menu.Root side="top" align="center" {...props}>
      <Tooltip.Root side="top">
        <Tooltip.Trigger render={<Menu.Trigger className={cn("media-button", "media-settings-menu-trigger")}>
            <GearIconPrimitive className={cn("media-button-icon", "media-settings-menu-trigger-icon")} />
            <TextPrimitive className={"media-settings-menu-trigger-label"} token={settingsText.key}>
              {settingsText.text}
            </TextPrimitive>
          </Menu.Trigger>} />
        <Tooltip.Popup
          className={cn("media-popup", "media-popup-transition", "media-surface", "media-tooltip")}
        >
          <TextPrimitive token={settingsText.key}>{settingsText.text}</TextPrimitive>
        </Tooltip.Popup>
      </Tooltip.Root>
      <Menu.Popup className={state => cn("media-popup", "media-popup-safe-area", "media-surface", "media-menu-popup", resolveClassName(className, state))}>
        <Menu.Content className={"media-menu-content"}>{children}</Menu.Content>
      </Menu.Popup>
    </Menu.Root>
  );
}

// ===== react/minimal-video/css/components/menus/submenu.tsx =====
/** @jsxImportSource react */





import { MenuChevron } from './menu-chevron';
import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/menus.css";
import { Menu } from "@videojs/react";

import type { ReactNode } from "react";
import { cn, resolveClassName } from "@videojs/utils/style";




export interface SubmenuProps extends Menu.Root.RootProps {
icon: ReactNode;
  label: ReactNode;
  selectedLabel: ReactNode;
}
export function Submenu({
  children,
  icon,
  label,
  selectedLabel,
  className,
  ...props
}: SubmenuProps) {
  return (
    <Menu.Root {...props}>
      <Menu.Trigger className={"media-menu-trigger-item"}>
        {icon}
        {label}
        <span className={"media-menu-hint"}>
          {selectedLabel}
          <MenuChevron />
        </span>
      </Menu.Trigger>
      <Menu.Content className={state => cn("media-menu-content", resolveClassName(className, state))}>
        <Menu.Item className={"media-menu-back-item"}>
          <MenuChevron back />
          {label}
        </Menu.Item>
        <Menu.Separator className={"media-menu-separator"} />
        {children}
      </Menu.Content>
    </Menu.Root>
  );
}

// ===== react/minimal-video/css/components/menus/video-settings-menu.tsx =====
/** @jsxImportSource react */



import { AudioTrackMenu } from './audio-track-menu';
import { CaptionsMenu } from './captions-menu';
import { PlaybackRateMenu } from './playback-rate-menu';
import { QualityMenu } from './quality-menu';
import { SettingsMenu } from './settings-menu';
import { useQualityOptions, useAudioTrackOptions, usePlaybackRateOptions, useCaptionsOptions } from "@videojs/react";
import type { ComponentProps } from "react";



export interface VideoSettingsMenuProps extends Omit<ComponentProps<typeof SettingsMenu>, 'children'> {}

export function VideoSettingsMenu(props: VideoSettingsMenuProps = {}) {
const quality = useQualityOptions();
const audioTrack = useAudioTrackOptions();
const playbackRate = usePlaybackRateOptions();
const captions = useCaptionsOptions();
const hasSettings = quality?.state.availability === 'available' || audioTrack?.state.availability === 'available' || playbackRate?.state.availability === 'available' || captions?.state.availability === 'available';

  return (
    hasSettings && <SettingsMenu {...props}>
      <QualityMenu />
      <AudioTrackMenu />
      <PlaybackRateMenu />
      <CaptionsMenu />
    </SettingsMenu>
  );
}

