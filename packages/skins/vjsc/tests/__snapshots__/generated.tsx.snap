import { qualityText } from '@videojs/core/i18n/text/menu';




import { QualityRadioGroup } from './radio-group';
import { RadioItem } from './radio-item';
import { Submenu } from './submenu';
import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/menus.css";
import { useQualityOptions } from "@videojs/react";
import type { ComponentProps } from "react";
import { Text as TextPrimitive } from "@videojs/react";
import { SwitchesIcon as SwitchesIconPrimitive } from "@videojs/react/icons";






export interface QualityMenuProps extends Omit<
  ComponentProps<typeof Submenu>,
  'children' | 'icon' | 'label' | 'selectedLabel'
> {}

export function QualityMenu(props: QualityMenuProps = {}) {
const quality = useQualityOptions();
const available = quality?.state.availability === 'available';

  return (
    available && <Submenu
      icon={<SwitchesIconPrimitive className={"media-menu-trigger-item-icon"} />}
      label={<TextPrimitive token={qualityText.key}>{qualityText.text}</TextPrimitive>}
      selectedLabel={<span className={"media-menu-hint-label"} data-part="hint">{quality?.selectedLabel}</span>}
      {...props}
    >
      <QualityRadioGroup renderItem={(props, item) => (<RadioItem {...props}>
            <span>
              <span>{item.label}</span>
              {item.tier ? <sup className={"media-menu-tier"}>{item.tier}</sup> : null}
            </span>
            {item.badge ? <span className={"media-menu-badge"}>{item.badge}</span> : null}
          </RadioItem>)}>

      </QualityRadioGroup>
    </Submenu>
  );
}

