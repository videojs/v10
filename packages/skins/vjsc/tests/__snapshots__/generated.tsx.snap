// ===== html/default-video/css/components/sliders/time-slider.tsx =====
/** @jsxImportSource vjsc/html-runtime */
import type { SliderPreviewOverflow, TimeSliderProps as CoreProps } from '@videojs/core';


import { type Props } from "vjsc/components";





import { SliderBuffer, SliderFill, SliderThumb, SliderTrack } from './slider';
import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/sliders.css";
import { registerIcons, spinnerIcon } from "@videojs/html/icons";
import { spinnerIcon as spinnerIconPrimitive } from "@videojs/html/icons/minimal";
import "@videojs/html/ui/slider-buffer";
import "@videojs/html/ui/slider-fill";
import "@videojs/html/ui/slider-track";
import "@videojs/html/ui/time-slider-chapters";
import "@videojs/html/ui/slider-thumb";
import "@videojs/html/ui/slider-thumbnail";
import "@videojs/html/ui/time-slider-chapter-title";
import "@videojs/html/ui/slider-value";
import "@videojs/html/ui/slider";
import "@videojs/html/ui/time-slider";

registerIcons("default", { "spinner": spinnerIcon });
registerIcons("minimal", { "spinner": spinnerIconPrimitive });



export function TimeSlider({
  className,
  previewOverflow = 'visible',
  ...props
}: Props<CoreProps & { previewOverflow?: SliderPreviewOverflow | undefined }> = {}) {
  return (
    <media-time-slider className={["media-slider", "media-time-slider", className]} {...props}>
      <media-time-slider-chapters className={"media-time-slider-chapters"}>
        <template><div class={"media-time-slider-chapter"}>
          <media-slider-track className={[SliderTrack, "media-time-slider-chapter-track"]}>
            <media-slider-buffer className={SliderBuffer} />
            <media-slider-fill className={SliderFill} />
          </media-slider-track>
        </div></template>
      </media-time-slider-chapters>
      <media-slider-thumb className={[SliderThumb, "media-time-slider-thumb"]} />
      <media-slider-preview className={"media-slider-preview"} overflow={previewOverflow}>
        <div className={"media-slider-thumbnail"}>
          <media-slider-thumbnail className={"media-slider-thumbnail-image"} />
          <><span class="contents theme-minimal:hidden"><media-icon name="spinner" class={"media-slider-thumbnail-spinner-icon"} /></span><span class="hidden theme-minimal:contents"><media-icon family="minimal" name="spinner" class={"media-slider-thumbnail-spinner-icon"} /></span></>
        </div>
        <div className={"media-time-slider-preview-content"}>
          <media-time-slider-chapter-title className={"media-time-slider-chapter-title"} />
          <media-slider-value className={"media-time-slider-value"} type="pointer" />
        </div>
      </media-slider-preview>
    </media-time-slider>
  );
}

