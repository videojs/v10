import { QualityRadioGroup } from './radio-group';
import { RadioItem } from './radio-item';
import { Submenu } from './submenu';
import { useQualityOptions } from "@videojs/react";
import type { ComponentProps } from "react";
import { Text as TextPrimitive } from "@videojs/react";
import { SwitchesIcon as SwitchesIconPrimitive } from "@videojs/react/icons/minimal";





export interface QualityMenuProps extends Omit<
  ComponentProps<typeof Submenu>,
  'children' | 'icon' | 'label' | 'selectedLabel'
> {}

export function QualityMenu(props: QualityMenuProps = {}) {
const quality = useQualityOptions();
const available = quality?.state.availability === 'available';

  return (
    available && <Submenu
      icon={<SwitchesIconPrimitive className={"size-media-icon shrink-0 group-hover/menu-trigger-item:text-inherit group-data-highlighted/menu-trigger-item:text-inherit text-current/50 drop-shadow-[0_1px_0_rgb(0_0_0/0.2)]"} />}
      label={<TextPrimitive token={qualityText.key}>{qualityText.text}</TextPrimitive>}
      selectedLabel={<span className={"max-w-24 overflow-hidden text-ellipsis whitespace-nowrap"} data-part="hint">{quality?.selectedLabel}</span>}
      {...props}
    >
      <QualityRadioGroup renderItem={(props, item) => (<RadioItem {...props}>
            <span>
              <span>{item.label}</span>
              {item.tier ? <sup className={"ps-0.5 pt-px text-media-xs font-semibold leading-none text-current/70"}>{item.tier}</sup> : null}
            </span>
            {item.badge ? <span className={"rounded-media-control bg-media-control-hover px-1.5 text-media-xs font-semibold"}>{item.badge}</span> : null}
          </RadioItem>)}>

      </QualityRadioGroup>
    </Submenu>
  );
}

