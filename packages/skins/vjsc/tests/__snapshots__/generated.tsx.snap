  return (
    <>
        <MuteButton />
      <media-volume-popover open-on-hover delay={200} close-delay={100} side={side} {...props} class={[
          "media-popup",
          "media-popup-transition",
          "media-popup-safe-area",
          "media-surface",
          "media-volume-popover",
          className,
        ]}>
        <VolumeSlider orientation={orientation} />
      </media-volume-popover></>
  );
}

