import "virtual:vjsc/css/<hash>/buttons.css";
import "virtual:vjsc/css/<hash>/menus.css";
import { registerIcons, captionsOffIcon, captionsOnIcon } from "@videojs/html/icons";
import { captionsOffIcon as captionsOffIconPrimitive, captionsOnIcon as captionsOnIconPrimitive } from "@videojs/html/icons/minimal";
import "@videojs/html/ui/menu";
import "@videojs/html/ui/captions-radio-group";
import { Scope } from "vjsc/html-runtime/jsx-runtime";

registerIcons("default", { "captions-off": captionsOffIcon, "captions-on": captionsOnIcon });
registerIcons("minimal", { "captions-off": captionsOffIconPrimitive, "captions-on": captionsOnIconPrimitive });



export interface CaptionsMenuProps extends MenuProps {
  className?: ClassNameValue;
  triggerClassName?: ClassNameValue;
}

export function CaptionsMenu({ className, triggerClassName, ...props }: CaptionsMenuProps = {}) {
  return (
    <Scope prefix="<module>-zr"><><ButtonTooltip side="top">
          <button commandfor="__vjsc-id-<module>-zr-popup" aria-label="Enable captions" class={[Button, ["media-captions-button", triggerClassName]]}>
            <><span class="contents theme-minimal:hidden"><media-icon name="captions-off" class={["media-button-icon", "media-captions-button-off-icon"]} /></span><span class="hidden theme-minimal:contents"><media-icon family="minimal" name="captions-off" class={["media-button-icon", "media-captions-button-off-icon"]} /></span></>
            <><span class="contents theme-minimal:hidden"><media-icon name="captions-on" class={["media-button-icon", "media-captions-button-on-icon"]} /></span><span class="hidden theme-minimal:contents"><media-icon family="minimal" name="captions-on" class={["media-button-icon", "media-captions-button-on-icon"]} /></span></>
          </button>
        </ButtonTooltip><media-menu id="__vjsc-id-<module>-zr-popup" side="top" align="center" boundary="viewport" {...props} class={["media-menu-popup", className]}>
          <media-menu-content className={"media-menu-content"}>
            <media-captions-radio-group className={"media-menu-radio-group"}>
              <template>
                <RadioItem>
                  <span data-part="label" />
                </RadioItem>
              </template>
            </media-captions-radio-group>
          </media-menu-content>
        </media-menu></></Scope>
  );
}

