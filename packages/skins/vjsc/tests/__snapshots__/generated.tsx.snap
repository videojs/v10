// ===== react/default-video/css/components/feedback/status-indicator.tsx =====
/** @jsxImportSource react */







import "virtual:vjsc/css/bedd34a0f91c/base.css";
import "virtual:vjsc/css/083d58e00aa3/indicator.css";
import { StatusIndicator as StatusIndicatorPrimitive } from "@videojs/react";
import { CaptionsOnIcon as CaptionsOnIconPrimitive, CaptionsOffIcon as CaptionsOffIconPrimitive, FullscreenEnterIcon as FullscreenEnterIconPrimitive, FullscreenExitIcon as FullscreenExitIconPrimitive, PipEnterIcon as PipEnterIconPrimitive, PipExitIcon as PipExitIconPrimitive, PlayIcon as PlayIconPrimitive, PauseIcon as PauseIconPrimitive } from "@videojs/react/icons";
import { cn, resolveClassName } from "@videojs/utils/style";





const TOP_STATUS_ACTIONS = ['toggleSubtitles', 'toggleFullscreen', 'togglePictureInPicture'] as const;

const PLAYBACK_STATUS_ACTIONS = ['togglePaused'] as const;

export interface StatusIndicatorProps extends Omit<StatusIndicatorPrimitive.Root.RootProps, "children"> {}
export function StatusIndicator({ className, ...props }: StatusIndicatorProps = {}) {
  return (
    <StatusIndicatorPrimitive.Root actions={TOP_STATUS_ACTIONS} className={state => cn("media-status-indicator", resolveClassName(className, state))} {...props}>
      <CaptionsOnIconPrimitive className={cn("media-status-indicator-icon", "media-status-captions-on-icon")} />
      <CaptionsOffIconPrimitive className={cn("media-status-indicator-icon", "media-status-captions-off-icon")} />
      <FullscreenEnterIconPrimitive className={cn("media-status-indicator-icon", "media-status-fullscreen-enter-icon")} />
      <FullscreenExitIconPrimitive className={cn("media-status-indicator-icon", "media-status-fullscreen-exit-icon")} />
      <PipEnterIconPrimitive className={cn("media-status-indicator-icon", "media-status-pip-enter-icon")} />
      <PipExitIconPrimitive className={cn("media-status-indicator-icon", "media-status-pip-exit-icon")} />
      <StatusIndicatorPrimitive.Value className={"media-status-indicator-value"} />
    </StatusIndicatorPrimitive.Root>
  );
}

export interface PlaybackStatusIndicatorProps extends Omit<StatusIndicatorPrimitive.Root.RootProps, "children"> {}
export function PlaybackStatusIndicator({ className, ...props }: PlaybackStatusIndicatorProps = {}) {
  return (
    <StatusIndicatorPrimitive.Root actions={PLAYBACK_STATUS_ACTIONS} className={state => cn("media-playback-status-indicator", resolveClassName(className, state))} {...props}>
      <PlayIconPrimitive className={cn("media-playback-status-icon", "media-status-play-icon")} />
      <PauseIconPrimitive className={cn("media-playback-status-icon", "media-status-pause-icon")} />
    </StatusIndicatorPrimitive.Root>
  );
}

