import { registerIcons } from "@videojs/html/icons";
import { gearIcon } from "@videojs/html/icons/minimal";
import "@videojs/html/i18n";
import "@videojs/html/ui/menu";
import { Scope } from "vjsc/html-runtime/jsx-runtime";


registerIcons("minimal", { "gear": gearIcon });



export function SettingsMenu({ children, className, ...props }: PropsWithChildren<MenuProps>) {
  return (
    <Scope prefix="<module>-ny"><><ButtonTooltip label={<media-text token={settingsText.key}>{settingsText.text}</media-text>} side="top">
        <button commandfor="__vjsc-id-<module>-ny-popup" class={[Button, "media-settings-menu-trigger"]}>
          <media-icon family="minimal" name="gear" class={["media-button-icon", "media-settings-menu-trigger-icon"]} />
          <media-text class={"media-settings-menu-trigger-label"} token={settingsText.key}>
            {settingsText.text}
          </media-text>
        </button>
      </ButtonTooltip><media-menu id="__vjsc-id-<module>-ny-popup" side="top" align="center" {...props} class={["media-menu-popup", className]}>
        <media-menu-content className={"media-menu-content"}>{children}</media-menu-content>
      </media-menu></></Scope>
  );
}

