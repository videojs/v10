/** @jsxImportSource vjsc/html-runtime */
import type { SeekButtonProps as CoreProps } from '@videojs/core';


import { type Props } from "vjsc/components";




import { Button } from './button';
import { ButtonTooltip } from './button-tooltip';
import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/buttons.css";
import { registerIcons, seekIcon } from "@videojs/html/icons";
import { seekIcon as seekIconPrimitive } from "@videojs/html/icons/minimal";
import "@videojs/html/ui/seek-button";

registerIcons("default", { "seek": seekIcon });
registerIcons("minimal", { "seek": seekIconPrimitive });



export function SeekButton({ className, seconds = 10, ...props }: Props<CoreProps> = {}) {
  return (
    <ButtonTooltip side="top">
      <media-seek-button className={[Button, ["media-seek-button", className]]} seconds={seconds} {...props}>
        <><span class="contents theme-minimal:hidden"><media-icon name="seek" class={["media-button-icon", seconds < 0 && "media-seek-button-backward-icon"]} /></span><span class="hidden theme-minimal:contents"><media-icon family="minimal" name="seek" class={["media-button-icon", seconds < 0 && "media-seek-button-backward-icon"]} /></span></>
        <span class={["media-seek-button-label", seconds < 0 ? "media-seek-button-backward-label" : "media-seek-button-forward-label"]}>
          {Math.abs(seconds)}
        </span>
      </media-seek-button>
    </ButtonTooltip>
  );
}

// ===== html/default-video/css/components/controls/volume-popover.tsx =====
/** @jsxImportSource vjsc/html-runtime */
import type { VolumePopoverProps as CoreProps, VolumeSliderProps as CoreVolumeSliderProps } from '@videojs/core';

import type { ClassNameValue, Props } from 'vjsc/components';



import { ButtonTooltip } from '../buttons/button-tooltip';
import { MuteButton } from '../buttons/mute-button';
import { VolumeSlider } from '../sliders/volume-slider';
import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/popups.css";
import "@videojs/html/ui/volume-popover";
import { Scope } from "vjsc/html-runtime/jsx-runtime";



export function VolumePopover({
  className,
  popupClassName,
  showTooltip = false,
  side = 'top',
  orientation = 'vertical',
  ...props
}: Props<
  CoreProps & {
    className?: string | undefined;
    orientation?: CoreVolumeSliderProps['orientation'];
    showTooltip?: boolean;
    popupClassName?: ClassNameValue;
  }
> = {}) {
  return (
    <Scope prefix="<module>-q1"><><ButtonTooltip delay={0} disabled={!showTooltip} sticky side="top">

          <MuteButton className={className}  commandfor="__vjsc-id-<module>-q1-popup"/>

      </ButtonTooltip><media-volume-popover id="__vjsc-id-<module>-q1-popup" open-on-hover delay={200} close-delay={100} side={side} {...props} class={["media-volume-popover", popupClassName]}>
        <VolumeSlider orientation={orientation} />
      </media-volume-popover></></Scope>
  );
}

