// ===== html/default-live-audio/css/components/feedback/status-indicator.tsx =====
/** @jsxImportSource vjsc/html-runtime */
import type { StatusIndicatorProps as CoreProps } from '@videojs/core';


import { type Props } from "vjsc/components";




import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/indicators.css";
import { registerIcons, captionsOffIcon, captionsOnIcon, fullscreenEnterIcon, fullscreenExitIcon, pauseIcon, pipEnterIcon, pipExitIcon, playIcon } from "@videojs/html/icons";
import "@videojs/html/ui/status-indicator-value";
import "@videojs/html/ui/status-indicator";

registerIcons("default", { "captions-off": captionsOffIcon, "captions-on": captionsOnIcon, "fullscreen-enter": fullscreenEnterIcon, "fullscreen-exit": fullscreenExitIcon, "pause": pauseIcon, "pip-enter": pipEnterIcon, "pip-exit": pipExitIcon, "play": playIcon });



const TOP_STATUS_ACTIONS = ['toggleSubtitles', 'toggleFullscreen', 'togglePictureInPicture'] as const;

const PLAYBACK_STATUS_ACTIONS = ['togglePaused'] as const;

export function StatusIndicator({ className, ...props }: Props<Omit<CoreProps, 'actions'>> = {}) {
  return (
    <media-status-indicator actions={TOP_STATUS_ACTIONS} className={["media-status-indicator", className]} {...props}>
      <div className={"media-status-indicator-content"}>
        <media-icon name="captions-on" class={"media-status-indicator-captions-on-icon"} />
        <media-icon name="captions-off" class={"media-status-indicator-captions-off-icon"} />
        <media-icon name="fullscreen-enter" class={"media-status-indicator-fullscreen-enter-icon"} />
        <media-icon name="fullscreen-exit" class={"media-status-indicator-fullscreen-exit-icon"} />
        <media-icon name="pip-enter" class={"media-status-indicator-pip-enter-icon"} />
        <media-icon name="pip-exit" class={"media-status-indicator-pip-exit-icon"} />
        <media-status-indicator-value className={"media-status-indicator-value"} />
      </div>
    </media-status-indicator>
  );
}

export function PlaybackStatusIndicator({ className, ...props }: Props<Omit<CoreProps, 'actions'>> = {}) {
  return (
    <media-status-indicator actions={PLAYBACK_STATUS_ACTIONS} className={["media-playback-status-indicator", className]} {...props}>
      <media-icon name="play" class={"media-playback-status-indicator-play-icon"} />
      <media-icon name="pause" class={"media-playback-status-indicator-pause-icon"} />
    </media-status-indicator>
  );
}

