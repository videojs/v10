/** @jsxImportSource react */
import { audioText } from '@videojs/core/i18n/text/menu';




import { AudioTrackRadioGroup } from './radio-group';
import { RadioItem } from './radio-item';
import { Submenu } from './submenu';
import { useAudioTrackOptions } from "@videojs/react";
import type { ComponentProps } from "react";
import { Text as TextPrimitive } from "@videojs/react";
import { SpeechIcon as SpeechIconPrimitive } from "@videojs/react/icons";





export interface AudioTrackMenuProps extends Omit<
  ComponentProps<typeof Submenu>,
  'children' | 'icon' | 'label' | 'selectedLabel'
> {}

export function AudioTrackMenu(props: AudioTrackMenuProps = {}) {
const audioTrack = useAudioTrackOptions();
const available = audioTrack?.state.availability === 'available';

  return (
    available && <Submenu
      icon={<SpeechIconPrimitive className={"size-media-icon shrink-0 opacity-70 group-hover/menu-item:opacity-100 drop-shadow-[0_1px_0_rgb(0_0_0/0.15)]"} />}
      label={<TextPrimitive token={audioText.key}>{audioText.text}</TextPrimitive>}
      selectedLabel={<span className={"max-w-24 overflow-hidden text-ellipsis whitespace-nowrap"} data-part="hint">{audioTrack?.selectedLabel}</span>}
      {...props}
    >
      <AudioTrackRadioGroup renderItem={(props, item) => (<RadioItem {...props}>
            <span>{item.label}</span>
          </RadioItem>)}>

      </AudioTrackRadioGroup>
    </Submenu>
  );
}

