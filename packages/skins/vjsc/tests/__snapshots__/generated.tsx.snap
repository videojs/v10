/** @jsxImportSource vjsc/html-runtime */
import type { MenuProps } from '@videojs/core';
import { settingsText } from '@videojs/core/i18n/text/menu';


import { type PropsWithChildren } from "vjsc/components";



import { Button } from '../buttons/button';
import { ButtonTooltip } from '../buttons/button-tooltip';
import "virtual:vjsc/css/<hash>/base.css";
import "virtual:vjsc/css/<hash>/buttons.css";
import "virtual:vjsc/css/<hash>/menus.css";
import { registerIcons, gearIcon } from "@videojs/html/icons";
import "@videojs/html/i18n";
import "@videojs/html/ui/menu";
import { Scope } from "vjsc/html-runtime/jsx-runtime";


registerIcons("default", { "gear": gearIcon });



export function SettingsMenu({ children, className, ...props }: PropsWithChildren<MenuProps>) {
  return (
    <Scope prefix="<module>-mo"><><ButtonTooltip label={<media-text token={settingsText.key}>{settingsText.text}</media-text>} side="top">
        <button commandfor="__vjsc-id-<module>-mo-popup" class={[Button, "media-settings-menu-trigger"]}>
          <media-icon name="gear" class={["media-button-icon", "media-settings-menu-trigger-icon"]} />
          <media-text class={"media-settings-menu-trigger-label"} token={settingsText.key}>
            {settingsText.text}
          </media-text>
        </button>
      </ButtonTooltip><media-menu id="__vjsc-id-<module>-mo-popup" side="top" align="center" {...props} class={["media-menu-popup", className]}>
        <media-menu-content className={"media-menu-content"}>{children}</media-menu-content>
      </media-menu></></Scope>
  );
}

