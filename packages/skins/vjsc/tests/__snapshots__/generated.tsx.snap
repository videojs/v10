  return (
    <ButtonTooltip side="top">
      <SeekButtonPrimitive render={<Button />} className={state => cn("media-seek-button", resolveClassName(className, state))} seconds={seconds} {...props}>
        <SeekIconPrimitive className={cn("media-button-icon", seconds < 0 && "media-seek-button-backward-icon")} />
        <span className={cn("media-seek-button-label", seconds < 0 ? "media-seek-button-backward-label" : "media-seek-button-forward-label")}>
          {Math.abs(seconds)}
        </span>
      </SeekButtonPrimitive>
    </ButtonTooltip>
  );
}

