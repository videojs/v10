import { DefaultLiveAudioControls } from './controls';
import type { ComponentProps, ReactNode } from "react";
import { cn } from "@videojs/utils/style";



export interface DefaultLiveAudioSkinProps extends Omit<ComponentProps<typeof Container>, 'children'> {
  children?: ReactNode;
}

export function DefaultLiveAudioSkin({ children, className, ...props }: DefaultLiveAudioSkinProps = {}) {
  return (
    <Container
      className={cn('media-skin media-skin--default media-skin--live-audio media-theme-default', className)}
      {...props}
