/** @jsxImportSource react */







import { ButtonTooltip } from './button-tooltip';
import "virtual:vjsc/css/bedd34a0f91c/base.css";
import "virtual:vjsc/css/1cedab86c96b/buttons.css";
import { SeekButton as SeekButtonPrimitive } from "@videojs/react";
import { SeekIcon as SeekIconPrimitive } from "@videojs/react/icons";
import { cn, resolveClassName } from "@videojs/utils/style";





export interface SeekButtonProps extends Omit<SeekButtonPrimitive.Props, "children"> {}
export function SeekButton({ className, seconds = 10, ...props }: SeekButtonProps = {}) {
  return (
    <ButtonTooltip side="top">
      <SeekButtonPrimitive className={state => cn("media-button", "media-seek-button", resolveClassName(className, state))} seconds={seconds} {...props}>
        <SeekIconPrimitive className={cn("media-button-icon", seconds < 0 ? "media-seek-backward-icon" : undefined)} />
        <span className={"media-seek-button-label"}>{Math.abs(seconds)}</span>
      </SeekButtonPrimitive>
    </ButtonTooltip>
  );
}

// ===== react/default-video/css/components/controls/volume-popover.tsx =====
/** @jsxImportSource react */






import { MuteButton } from '../buttons/mute-button';
import { VolumeSlider } from '../sliders/volume-slider';
import "virtual:vjsc/css/bedd34a0f91c/base.css";
import "virtual:vjsc/css/c9beccccaaf5/popups.css";
import { usePlayer } from "@videojs/react";
import { Popover } from "@videojs/react";
import { cn, resolveClassName } from "@videojs/utils/style";





export interface VolumePopoverProps extends Omit<Popover.Root.RootProps, "children"> {}
export function VolumePopover({
  className,
  side = 'top',
  orientation = 'vertical',
  ...props
}: VolumePopoverProps = {}) {
const volumeAvailability = usePlayer(state => state.volumeAvailability);

  return (
    volumeAvailability === 'available' ? <Popover.Root openOnHover delay={200} closeDelay={100} side={side} {...props}>
      <Popover.Trigger render={<MuteButton />} />
      <Popover.Popup className={state => cn("media-surface", "media-volume-popover", resolveClassName(className, state))}>
        <VolumeSlider orientation={orientation} />
      </Popover.Popup>
    </Popover.Root> : <MuteButton />
  );
}

