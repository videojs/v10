import "@videojs/html/ui/slider-thumbnail";
import "@videojs/html/icons/element/minimal";
import "@videojs/html/ui/time-slider-chapter-title";
import "@videojs/html/ui/slider-value";
import "@videojs/html/ui/slider";
import "@videojs/html/ui/time-slider";



export function TimeSlider({ className, ...props }: Props<CoreProps> = {}) {
  return (
    <media-time-slider className={["media-slider", "media-time-slider", className]} {...props}>
      <media-time-slider-chapters className={"media-time-slider-chapters"}>
        <template><div class={"media-time-slider-chapter"}>
          <media-slider-track className={["media-slider-track", "media-time-slider-chapter-track"]}>
            <media-slider-buffer className={"media-slider-buffer"} />
            <media-slider-fill className={"media-slider-fill"} />
          </media-slider-track>
        </div></template>
      </media-time-slider-chapters>
      <media-slider-thumb className={["media-slider-thumb", "media-time-slider-thumb"]} />
      <media-slider-preview className={"media-slider-preview"} overflow="visible">
        <div className={["media-slider-preview-content", "media-surface", "media-slider-thumbnail"]}>
          <media-slider-thumbnail className={"media-slider-thumbnail-image"} />
          <media-icon family="minimal" name="spinner" class={"media-slider-thumbnail-spinner-icon"} />
        </div>
        <div className={["media-slider-preview-content", "media-time-slider-preview-content"]}>
          <media-time-slider-chapter-title className={"media-time-slider-chapter-title"} />
          <media-slider-value className={"media-time-slider-value"} type="pointer" />
        </div>
      </media-slider-preview>
    </media-time-slider>
  );
}

