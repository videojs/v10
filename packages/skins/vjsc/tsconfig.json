{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "allowImportingTsExtensions": true,
    "isolatedDeclarations": false,
    "jsx": "react-jsx",
    "jsxImportSource": "vjsc/components",
    "lib": ["ES2022"],
    "paths": {
      "vjsc/*": ["../../vjsc/src/*"]
    },
    "types": ["node"],
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../vite.config.ts"]
}
