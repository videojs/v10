{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@videojs/react/video": ["../react/src/presets/video/index.ts"]
    },
    "types": ["node"],
    "declarationDir": "types"
  },
  "include": ["src", "dev", "vjsc/*.ts", "vjsc/registry/*.ts", "vjsc/styles/tokens.ts", "vite.config.ts"],
  "exclude": ["vjsc/registry/default"],
  "references": [{ "path": "../core" }, { "path": "../html" }, { "path": "../icons" }, { "path": "../react" }]
}
