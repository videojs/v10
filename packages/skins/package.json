{
  "name": "@videojs/skins",
  "type": "module",
  "version": "10.0.0-beta.28",
  "private": true,
  "description": "Shared skin CSS and Tailwind classname tokens for Video.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/v10",
    "directory": "packages/skins"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./*.css": {
      "style": "./dist/default/*.css",
      "default": "./dist/default/*.css"
    },
    "./*": {
      "types": "./dist/dev/*.d.ts",
      "development": "./dist/dev/*.js",
      "default": "./dist/default/*.js"
    }
  },
  "scripts": {
    "build": "tsdown && pnpm run build:registry",
    "build:registry": "pnpm run generate:skins && shadcn build canonical/registry/registry.json --output dist/registry",
    "build:watch": "tsdown --watch ./src --no-clean",
    "generate:skins": "node --import tsx ./scripts/generate-skins.ts",
    "check:skins": "vitest run scripts/generation/tests/generated-skins.test.ts",
    "dev": "vite --host",
    "test": "pnpm run test:types && vitest run",
    "test:types": "tsgo --project ./canonical/tsconfig.json",
    "clean": "rimraf --glob dist types '*.tsbuildinfo'"
  },
  "dependencies": {
    "@videojs/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "vjsc": "workspace:*",
    "@videojs/core": "workspace:*",
    "@videojs/icons": "workspace:*",
    "clsx": "^2.1.1",
    "oxfmt": "^0.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.2",
    "tailwindcss": "4.2.1",
    "tailwind-merge": "^3.5.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "media",
    "skins",
    "css",
    "tailwind",
    "videojs"
  ]
}
