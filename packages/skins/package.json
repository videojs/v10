{
  "name": "@videojs/skins",
  "version": "10.0.0-beta.32",
  "private": true,
  "description": "Shared skin CSS and Tailwind classname tokens for Video.js",
  "keywords": [
    "css",
    "media",
    "skins",
    "tailwind",
    "videojs"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/v10",
    "directory": "packages/skins"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*.css": {
      "style": "./dist/default/*.css",
      "default": "./dist/default/*.css"
    },
    "./*": {
      "types": "./dist/dev/*.d.ts",
      "development": "./dist/dev/*.js",
      "default": "./dist/default/*.js"
    }
  },
  "scripts": {
    "build:watch": "vp pack --filter skins --watch ./src --no-clean",
    "dev": "vp -C dev dev --host",
    "test": "pnpm run test:types && vp test run",
    "test:types": "tsgo --project ./vjsc/tsconfig.json",
    "clean": "rimraf --glob dist types '*.tsbuildinfo'"
  },
  "dependencies": {
    "@videojs/utils": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@videojs/core": "workspace:*",
    "@videojs/icons": "workspace:*",
    "@vitejs/plugin-react": "^6.0.4",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vjsc": "workspace:*"
  }
}
