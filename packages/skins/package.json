{
  "name": "@videojs/skins",
  "type": "module",
  "version": "10.0.0-beta.31",
  "private": true,
  "description": "Shared skin CSS and Tailwind classname tokens for Video.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/v10",
    "directory": "packages/skins"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./*.css": {
      "style": "./dist/default/*.css",
      "default": "./dist/default/*.css"
    },
    "./*": {
      "types": "./dist/dev/*.d.ts",
      "development": "./dist/dev/*.js",
      "default": "./dist/default/*.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:shadcn": "tsdown --config tsdown.shadcn.config.ts --config-loader unrun",
    "build:watch": "tsdown --watch ./src --no-clean",
    "dev": "vite --host",
    "test": "pnpm run test:types && vitest run",
    "test:types": "tsgo --project ./vjsc/tsconfig.json",
    "clean": "rimraf --glob dist types '*.tsbuildinfo'"
  },
  "dependencies": {
    "@videojs/utils": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "vjsc": "workspace:*",
    "@videojs/core": "workspace:*",
    "@videojs/icons": "workspace:*",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tailwind-merge": "^3.5.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "media",
    "skins",
    "css",
    "tailwind",
    "videojs"
  ]
}
