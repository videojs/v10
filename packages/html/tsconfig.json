{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@videojs/compiler/components/registry",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "declarationDir": "types",
    "useDefineForClassFields": false
  },
  "include": ["src", "compiler"],
  "exclude": ["src/cdn/locales"]
}
