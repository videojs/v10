{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "vjsc/registry",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "declarationDir": "types",
    "useDefineForClassFields": false
  },
  "include": ["src", "vjsc"],
  "exclude": ["src/cdn/locales"],
  "references": [{ "path": "../icons" }]
}
