{
  "name": "@videojs/compiler",
  "type": "module",
  "description": "Private compiler infrastructure for Video.js source transforms and builds",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/v10",
    "directory": "packages/compiler"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ast": {
      "types": "./dist/ast.d.ts",
      "default": "./dist/ast.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    },
    "./shadcn": {
      "types": "./dist/shadcn/index.d.ts",
      "default": "./dist/shadcn/index.js"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "default": "./dist/styles/index.js"
    },
    "./vite": {
      "types": "./dist/bundlers/vite.d.ts",
      "default": "./dist/bundlers/vite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/check-exports.mjs",
    "build:watch": "tsdown --watch ./src --no-clean",
    "dev": "pnpm run build:watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf --glob dist types '*.tsbuildinfo'"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@tailwindcss/node": "4.2.1",
    "@videojs/utils": "workspace:*",
    "kleur": "^4.1.5",
    "lightningcss": "^1.32.0",
    "rolldown": "~1.1.5",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "4.2.1",
    "typescript": "6.0.2"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
