{
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "tag-separator": "@",
  "include-component-in-tag": true,
  "include-v-in-tag": false,
  "plugins": [
    {
      "type": "node-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "videojs",
      "components": [
        "@videojs/cli",
        "@videojs/cloudflare-video",
        "@videojs/core",
        "@videojs/dash-video",
